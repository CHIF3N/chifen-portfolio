---
import { site } from '../lib/site';
import { withBase } from '../lib/url';

const path = Astro.url.pathname;
const isActive = (href: string) => {
  const target = withBase(href);
  return path === target || path.startsWith(target + '/');
};
---

<header class="sticky top-0 z-50 border-b border-ink/8 bg-paper/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-5 py-4 sm:gap-3 sm:px-8">
    <a
      href={withBase('/')}
      class="font-display text-lg font-semibold whitespace-nowrap transition-colors hover:text-amber"
    >
      <span class="sm:hidden">CHIF<span class="text-amber">3</span>N</span>
      <span class="hidden sm:inline">Chifen Sama <span class="text-amber">N.</span></span>
    </a>

    <nav aria-label="Main" class="hidden min-w-0 sm:block">
      <ul class="flex items-center gap-2">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'relative block rounded-full px-4 py-2 text-sm font-medium whitespace-nowrap transition-colors',
                  isActive(item.href) ? 'text-ink' : 'text-slate hover:text-ink',
                ]}
              >
                {item.label}
                {isActive(item.href) && (
                  <span class="absolute inset-x-4 -bottom-px h-0.5 rounded-full bg-amber" />
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="relative h-9 w-9 shrink-0 sm:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="menu-icon-bar top-[13px]"></span>
      <span class="menu-icon-bar top-[18px]"></span>
      <span class="menu-icon-bar top-[23px]"></span>
    </button>
  </div>
</header>

<div id="menu-backdrop" class="fixed inset-0 z-40 hidden bg-ink/40 sm:hidden"></div>

<nav
  id="mobile-menu"
  aria-label="Mobile"
  class="menu-panel hidden fixed inset-y-0 right-0 z-[60] w-72 max-w-[80vw] bg-paper shadow-2xl sm:hidden"
>
  <ul class="mt-20 flex flex-col px-3">
    {
      site.nav.map((item) => (
        <li>
          <a
            href={withBase(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'block rounded-xl px-4 py-3.5 text-lg font-medium transition-colors',
              isActive(item.href) ? 'bg-amber/10 text-ink' : 'text-slate hover:bg-ink/5 hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .menu-icon-bar {
    position: absolute;
    left: 6px;
    width: 24px;
    height: 2px;
    background-color: var(--color-ink);
    border-radius: 1px;
    transition:
      transform 0.25s ease,
      opacity 0.2s ease,
      top 0.25s ease;
  }
  html.menu-open .menu-icon-bar:nth-child(1) {
    top: 18px;
    transform: rotate(45deg);
  }
  html.menu-open .menu-icon-bar:nth-child(2) {
    opacity: 0;
  }
  html.menu-open .menu-icon-bar:nth-child(3) {
    top: 18px;
    transform: rotate(-45deg);
  }
  .menu-panel {
    opacity: 0;
  }
  .menu-panel.is-open {
    opacity: 1;
    transition: opacity 0.2s ease-out;
  }
  html.menu-open #menu-backdrop {
    display: block;
  }
  html.menu-open {
    overflow: hidden;
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const backdrop = document.getElementById('menu-backdrop');
  const menu = document.getElementById('mobile-menu');
  const root = document.documentElement;

  function closeMenu() {
    root.classList.remove('menu-open');
    menu?.classList.remove('is-open');
    menu?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Open menu');
  }

  function openMenu() {
    root.classList.add('menu-open');
    menu?.classList.remove('hidden');
    // Force a reflow so the opacity transition actually plays instead of
    // jumping straight to is-open before the browser paints the hidden state.
    void menu?.offsetHeight;
    menu?.classList.add('is-open');
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.setAttribute('aria-label', 'Close menu');
  }

  toggle?.addEventListener('click', () => {
    root.classList.contains('menu-open') ? closeMenu() : openMenu();
  });

  backdrop?.addEventListener('click', closeMenu);

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>
