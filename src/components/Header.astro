---
import FlipLink from './FlipLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import SocialIcon from './SocialIcon.astro';
import { site } from '../lib/site';
import { withBase } from '../lib/url';

const path = Astro.url.pathname;
const isActive = (href: string) => {
  const target = withBase(href);
  return path === target || path.startsWith(target + '/');
};

/* Only the compact set rides in the header; the rest live in the footer. */
const socials = site.socials.filter((social) => social.compact);
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/90 backdrop-blur-md">
  <div class="shell grid grid-cols-2 items-center gap-3 py-4 md:grid-cols-[1fr_auto_1fr]">
    <!-- Left: call to action and socials, as on the reference. -->
    <div class="hidden items-center gap-2 md:flex">
      <a href={withBase('/contact')} class="btn btn-accent btn-sm">Let's talk</a>
      {
        socials.map((social) => (
          <a
            href={social.href}
            class="grid h-8 w-8 place-items-center rounded-full border border-line text-slate transition-colors hover:border-ink hover:text-ink"
            aria-label={social.label}
          >
            <SocialIcon label={social.label} />
          </a>
        ))
      }
    </div>

    <!-- Centre: wordmark. -->
    <a
      href={withBase('/')}
      class="font-display text-2xl leading-none font-bold whitespace-nowrap uppercase transition-colors hover:text-accent md:justify-self-center"
    >
      Chif<span class="text-accent">3</span>n
    </a>

    <!-- Right: page links and the theme switch. -->
    <div class="flex items-center justify-end gap-2">
      <nav aria-label="Main" class="hidden min-w-0 lg:block">
        <ul class="flex items-center gap-0.5">
          {
            site.nav.map((item) => (
              <li>
                <a
                  href={withBase(item.href)}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'relative block px-3 py-2 text-sm font-semibold tracking-tight whitespace-nowrap transition-colors',
                    isActive(item.href) ? 'text-ink' : 'text-slate hover:text-ink',
                  ]}
                >
                  <FlipLink text={item.label} />
                  {isActive(item.href) && (
                    <span class="absolute inset-x-3 bottom-0.5 h-0.5 rounded-full bg-accent" />
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ThemeToggle />

      <button
        id="menu-toggle"
        type="button"
        class="relative h-9 w-9 shrink-0 lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-icon-bar top-[13px]"></span>
        <span class="menu-icon-bar top-[18px]"></span>
        <span class="menu-icon-bar top-[23px]"></span>
      </button>
    </div>
  </div>
</header>

<div id="menu-backdrop" class="fixed inset-0 z-40 hidden bg-ink/50 lg:hidden"></div>

<nav
  id="mobile-menu"
  aria-label="Mobile"
  class="menu-panel hidden fixed inset-y-0 right-0 z-[60] w-72 max-w-[80vw] bg-paper shadow-2xl lg:hidden"
>
  <ul class="mt-20 flex flex-col px-3">
    {
      site.nav.map((item) => (
        <li>
          <a
            href={withBase(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'block px-4 py-3.5 font-display text-3xl font-semibold uppercase transition-colors',
              isActive(item.href) ? 'text-accent' : 'text-ink hover:text-accent',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
  <div class="mt-6 px-4">
    <a href={withBase('/contact')} class="btn btn-accent w-full">Let's talk</a>
  </div>
</nav>

<style>
  .menu-icon-bar {
    position: absolute;
    left: 6px;
    width: 24px;
    height: 2px;
    background-color: var(--color-ink);
    border-radius: 1px;
    transition:
      transform 0.25s ease,
      opacity 0.2s ease,
      top 0.25s ease;
  }
  html.menu-open .menu-icon-bar:nth-child(1) {
    top: 18px;
    transform: rotate(45deg);
  }
  html.menu-open .menu-icon-bar:nth-child(2) {
    opacity: 0;
  }
  html.menu-open .menu-icon-bar:nth-child(3) {
    top: 18px;
    transform: rotate(-45deg);
  }
  .menu-panel {
    opacity: 0;
  }
  .menu-panel.is-open {
    opacity: 1;
    transition: opacity 0.2s ease-out;
  }
  html.menu-open #menu-backdrop {
    display: block;
  }
  html.menu-open {
    overflow: hidden;
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const backdrop = document.getElementById('menu-backdrop');
  const menu = document.getElementById('mobile-menu');
  const root = document.documentElement;

  function closeMenu() {
    root.classList.remove('menu-open');
    menu?.classList.remove('is-open');
    menu?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Open menu');
  }

  function openMenu() {
    root.classList.add('menu-open');
    menu?.classList.remove('hidden');
    // Force a reflow so the opacity transition actually plays instead of
    // jumping straight to is-open before the browser paints the hidden state.
    void menu?.offsetHeight;
    menu?.classList.add('is-open');
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.setAttribute('aria-label', 'Close menu');
  }

  toggle?.addEventListener('click', () => {
    root.classList.contains('menu-open') ? closeMenu() : openMenu();
  });

  backdrop?.addEventListener('click', closeMenu);

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>
