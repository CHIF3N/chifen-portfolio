---
import ThemeToggle from './ThemeToggle.astro';
import Wordmark from './Wordmark.astro';
import { site } from '../lib/site';
import { withBase } from '../lib/url';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const target = withBase(href).replace(/\/$/, '') || '/';
  return path === target || path.startsWith(target + '/');
};
---

<header class="site-header sticky top-0 z-50">
  <div class="shell flex items-center justify-between gap-3 py-3">
    <a href={withBase('/')} class="group flex items-end gap-2 rounded-md" aria-label="CHIF3N, home">
      <Wordmark size="sm" />
      <span class="hand hidden pb-0.5 text-[1.05rem] text-slate xl:inline">the nurse who codes</span>
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="index-tabs">
        {
          site.nav.map((item) => (
            <li>
              <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <button type="button" class="find-btn" data-open-palette aria-label="Quick jump to a page or project">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"></circle><path d="m20 20-4.2-4.2"></path></svg>
        <span class="hidden md:inline">Find</span>
        <span class="kbd hidden md:inline-flex" aria-hidden="true">Ctrl K</span>
      </button>
      <a href={withBase(site.resume)} class="btn btn-accent btn-sm hidden sm:inline-flex">Résumé</a>
      <ThemeToggle />
      <button
        id="menu-toggle"
        type="button"
        class="menu-btn lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-icon-bar top-[12px]"></span>
        <span class="menu-icon-bar top-[18px]"></span>
        <span class="menu-icon-bar top-[24px]"></span>
      </button>
    </div>
  </div>
</header>

<div id="menu-backdrop" class="fixed inset-0 z-40 hidden bg-ink/40 lg:hidden"></div>

<nav id="mobile-menu" aria-label="Mobile" class="menu-panel hidden lg:hidden" inert>
  <p class="hand px-5 pt-20 text-2xl text-slate">open a folder…</p>
  <ul class="mt-3 flex flex-col gap-2 px-4">
    {
      site.nav.map((item, i) => (
        <li>
          <a
            href={withBase(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class="menu-folder"
            style={`--r:${i % 2 ? 0.6 : -0.6}deg`}
          >
            <span class="font-display text-2xl font-semibold">{item.label}</span>
            <span class="hand text-lg text-slate">{item.note}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <div class="mt-6 grid grid-cols-2 gap-x-4 gap-y-2 px-6 text-sm font-semibold">
    {site.secondaryNav.map((item) => <a href={withBase(item.href)} class="ink-link justify-self-start">{item.label}</a>)}
  </div>
  <div class="mt-8 flex flex-wrap gap-3 px-5 pb-10">
    <a href={withBase(site.resume)} class="btn btn-accent">Résumé</a>
    <a href={`mailto:${site.emails[0]}`} class="btn btn-ghost">Email me</a>
  </div>
</nav>

<style>
  .site-header {
    background: color-mix(in oklab, var(--color-paper) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1.5px dashed var(--color-line);
  }
  .site-header :global(.wordmark) {
    view-transition-name: wordmark;
  }

  /* Notebook index tabs. The current page gets a lime tab. */
  .index-tabs {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }
  .index-tabs a {
    position: relative;
    display: block;
    padding: 0.5rem 0.8rem;
    border-radius: 8px 8px 0 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-slate);
    transition: color 0.2s ease, background-color 0.2s ease, transform 0.25s var(--ease-paper);
  }
  .index-tabs a:hover {
    color: var(--color-ink);
    transform: translateY(-2px) rotate(-1deg);
  }
  .index-tabs a[aria-current='page'] {
    color: #191919;
    background: var(--lime);
    border: 1.5px solid #191919;
    border-bottom: 0;
  }

  .find-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.4rem;
    min-width: 2.4rem;
    justify-content: center;
    padding: 0 0.7rem;
    border: 1.5px solid var(--color-ink);
    border-radius: 999px;
    background: var(--sheet);
    font-size: 0.82rem;
    font-weight: 600;
  }
  .find-btn:hover {
    background: var(--lavender);
    color: #191919;
  }

  .menu-btn {
    position: relative;
    width: 2.6rem;
    height: 2.6rem;
    flex-shrink: 0;
    border: 1.5px solid var(--color-ink);
    border-radius: 999px;
    background: var(--sheet);
  }
  .menu-icon-bar {
    position: absolute;
    left: 10px;
    width: 18px;
    height: 2px;
    background-color: var(--color-ink);
    border-radius: 1px;
    transition: transform 0.25s ease, opacity 0.2s ease, top 0.25s ease;
  }
  :global(html.menu-open) .menu-icon-bar:nth-child(1) {
    top: 18px;
    transform: rotate(45deg);
  }
  :global(html.menu-open) .menu-icon-bar:nth-child(2) {
    opacity: 0;
  }
  :global(html.menu-open) .menu-icon-bar:nth-child(3) {
    top: 18px;
    transform: rotate(-45deg);
  }

  .menu-panel {
    position: fixed;
    inset: 0 0 0 auto;
    z-index: 45;
    width: min(22rem, 88vw);
    overflow-y: auto;
    background: var(--color-paper);
    border-left: 1.5px solid var(--color-ink);
    box-shadow: -10px 0 30px -12px rgba(0, 0, 0, 0.35);
    transform: translateX(100%);
    transition: transform 0.35s var(--ease-out-soft);
  }
  .menu-panel.is-open {
    transform: none;
  }
  .menu-folder {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    background: var(--sheet);
    border: 1.5px solid var(--color-ink);
    border-radius: 4px 12px 12px 12px;
    rotate: var(--r);
  }
  .menu-folder[aria-current='page'] {
    background: var(--lime);
    color: #191919;
  }
  :global(html.menu-open) #menu-backdrop {
    display: block;
  }
  :global(html.menu-open) {
    overflow: hidden;
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const backdrop = document.getElementById('menu-backdrop');
  const menu = document.getElementById('mobile-menu');
  const root = document.documentElement;

  function closeMenu(restoreFocus = true) {
    if (!root.classList.contains('menu-open')) return;
    root.classList.remove('menu-open');
    menu?.classList.remove('is-open');
    menu?.setAttribute('inert', '');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Open menu');
    setTimeout(() => menu?.classList.add('hidden'), 350);
    if (restoreFocus) toggle?.focus();
  }

  function openMenu() {
    root.classList.add('menu-open');
    menu?.classList.remove('hidden');
    menu?.removeAttribute('inert');
    void menu?.offsetHeight;
    menu?.classList.add('is-open');
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.setAttribute('aria-label', 'Close menu');
    menu?.querySelector<HTMLAnchorElement>('a')?.focus();
  }

  toggle?.addEventListener('click', () => (root.classList.contains('menu-open') ? closeMenu() : openMenu()));
  backdrop?.addEventListener('click', () => closeMenu());
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => closeMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>
