---
import ThemeToggle from './ThemeToggle.astro';
import SocialIcon from './SocialIcon.astro';
import { site } from '../lib/site';
import { withBase } from '../lib/url';

const path = Astro.url.pathname;
const isActive = (href: string) => {
  const target = withBase(href);
  return path === target || (href !== '/' && path.startsWith(target + '/'));
};

const socials = site.socials.filter((s) => ['GitHub', 'LinkedIn', 'WhatsApp', 'X'].includes(s.label));
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/95 backdrop-blur-md transition-colors">
  <div class="shell flex items-center justify-between gap-4 py-3.5 sm:py-4">
    {/* Zone 1: Single element brand mark */}
    <a
      href={withBase('/')}
      class="group flex items-baseline gap-1.5 focus:outline-none"
      aria-label="CHIF3N Portfolio Home"
    >
      <span class="font-display text-2xl sm:text-2xl font-bold tracking-tight text-ink transition-colors group-hover:text-accent">
        CHIF<span class="text-accent">3</span>N
      </span>
      <span class="hidden sm:inline-block text-[11px] font-mono uppercase tracking-widest text-slate-light">
        / The Nurse Who Codes
      </span>
    </a>

    {/* Zone 2: Primary nav links + More dropdown */}
    <nav aria-label="Main" class="hidden md:flex items-center gap-1 lg:gap-2">
      {
        site.nav.map((item) => {
          if (item.label === 'More') {
            return (
              <div class="relative group">
                <a
                  href={withBase(item.href)}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'relative inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium tracking-tight whitespace-nowrap transition-colors rounded-lg',
                    isActive(item.href) ? 'text-ink font-semibold' : 'text-slate hover:text-ink',
                  ]}
                >
                  <span>{item.label}</span>
                  <svg class="w-3 h-3 text-slate-light group-hover:text-ink transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                  {isActive(item.href) && (
                    <span class="absolute inset-x-2.5 bottom-0 h-0.5 rounded-full bg-accent" />
                  )}
                </a>

                {/* Dropdown Menu */}
                <div class="absolute right-0 top-full pt-1.5 opacity-0 translate-y-1 invisible group-hover:opacity-100 group-hover:translate-y-0 group-hover:visible transition-all duration-200 z-50 pointer-events-none group-hover:pointer-events-auto">
                  <div class="w-56 rounded-xl border border-line bg-paper/95 backdrop-blur-md p-1.5 shadow-xl space-y-0.5">
                    {site.secondaryNav.map((sub) => (
                      <a
                        href={withBase(sub.href)}
                        class="flex items-center justify-between px-3 py-2 rounded-lg text-xs font-medium text-slate hover:text-ink hover:bg-paper-dim transition-colors"
                      >
                        <span>{sub.label}</span>
                        <span class="text-line">&rarr;</span>
                      </a>
                    ))}
                    <div class="pt-1.5 mt-1 border-t border-line/60">
                      <a
                        href={withBase('/more')}
                        class="flex items-center justify-between px-3 py-2 rounded-lg text-xs font-semibold text-accent hover:bg-accent/10 transition-colors"
                      >
                        <span>All More Content</span>
                        <span aria-hidden="true">&rarr;</span>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            );
          }

          return (
            <a
              href={withBase(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'relative px-3 py-1.5 text-sm font-medium tracking-tight whitespace-nowrap transition-colors rounded-lg',
                isActive(item.href) ? 'text-ink font-semibold' : 'text-slate hover:text-ink',
              ]}
            >
              <span>{item.label}</span>
              {isActive(item.href) && (
                <span class="absolute inset-x-2.5 bottom-0 h-0.5 rounded-full bg-accent" />
              )}
            </a>
          );
        })
      }
    </nav>

    {/* Zone 3: Primary CTA + theme switch + mobile toggle */}
    <div class="flex items-center gap-2.5 sm:gap-3">
      <ThemeToggle />

      <a
        href={withBase('/contact')}
        class="hidden sm:inline-flex items-center gap-1.5 rounded-full bg-accent px-4 py-2 text-xs font-semibold text-ink shadow-sm transition-all hover:bg-accent/90 hover:scale-[1.02] active:scale-[0.98] whitespace-nowrap"
      >
        <span>Let's talk</span>
        <span aria-hidden="true">&rarr;</span>
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="relative flex h-9 w-9 items-center justify-center rounded-lg border border-line text-ink transition-colors hover:bg-paper-dim md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-icon-bar top-[13px]"></span>
        <span class="menu-icon-bar top-[18px]"></span>
        <span class="menu-icon-bar top-[23px]"></span>
      </button>
    </div>
  </div>
</header>

<div id="menu-backdrop" class="fixed inset-0 z-40 hidden bg-ink/60 backdrop-blur-xs md:hidden"></div>

<nav
  id="mobile-menu"
  aria-label="Mobile Navigation"
  class="menu-panel hidden fixed inset-y-0 right-0 z-50 w-80 max-w-[85vw] bg-paper border-l border-line p-6 shadow-2xl md:hidden overflow-y-auto flex flex-col justify-between"
>
  <div>
    <div class="flex items-center justify-between pb-6 border-b border-line">
      <span class="font-display text-2xl font-bold tracking-tight text-ink">
        CHIF<span class="text-accent">3</span>N
      </span>
      <button
        id="menu-close"
        type="button"
        class="p-2 text-slate hover:text-ink rounded-lg"
        aria-label="Close menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Primary Mobile Links -->
    <ul class="mt-6 space-y-1">
      {
        site.nav.map((item) => (
          <li>
            <a
              href={withBase(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'block py-2.5 px-3 rounded-lg font-display text-2xl font-semibold tracking-tight transition-colors',
                isActive(item.href) ? 'text-accent bg-accent/10' : 'text-ink hover:text-accent hover:bg-paper-dim',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Secondary Exploration Links -->
    <div class="mt-8 pt-6 border-t border-line">
      <p class="text-xs font-mono uppercase tracking-widest text-slate mb-3">Explore More</p>
      <ul class="grid grid-cols-2 gap-2 text-sm">
        {
          site.secondaryNav.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                class="block py-1.5 px-2 rounded text-slate hover:text-ink hover:bg-paper-dim transition-colors text-xs font-medium"
              >
                {item.label} &rarr;
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="mt-8 pt-6 border-t border-line space-y-4">
    <a href={withBase('/contact')} class="btn btn-accent w-full justify-center py-3 text-sm font-semibold">
      <span>Let's talk</span>
      <span aria-hidden="true">&rarr;</span>
    </a>

    <div class="flex items-center justify-center gap-3 pt-2">
      {
        socials.map((social) => (
          <a
            href={social.href}
            class="grid h-9 w-9 place-items-center rounded-full border border-line text-slate transition-colors hover:border-ink hover:text-ink"
            aria-label={social.label}
          >
            <SocialIcon label={social.label} size={15} />
          </a>
        ))
      }
    </div>
  </div>
</nav>

<style>
  .menu-icon-bar {
    position: absolute;
    left: 6px;
    width: 22px;
    height: 2px;
    background-color: var(--color-ink);
    border-radius: 1px;
    transition:
      transform 0.25s ease,
      opacity 0.2s ease,
      top 0.25s ease;
  }
  html.menu-open .menu-icon-bar:nth-child(1) {
    top: 17px;
    transform: rotate(45deg);
  }
  html.menu-open .menu-icon-bar:nth-child(2) {
    opacity: 0;
  }
  html.menu-open .menu-icon-bar:nth-child(3) {
    top: 17px;
    transform: rotate(-45deg);
  }
  .menu-panel {
    opacity: 0;
    transform: translateX(100%);
    transition: transform 0.25s ease-out, opacity 0.2s ease-out;
  }
  .menu-panel.is-open {
    opacity: 1;
    transform: translateX(0);
  }
  html.menu-open #menu-backdrop {
    display: block;
  }
  html.menu-open {
    overflow: hidden;
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const closeBtn = document.getElementById('menu-close');
  const backdrop = document.getElementById('menu-backdrop');
  const menu = document.getElementById('mobile-menu');
  const root = document.documentElement;

  function closeMenu() {
    root.classList.remove('menu-open');
    menu?.classList.remove('is-open');
    setTimeout(() => {
      menu?.classList.add('hidden');
    }, 200);
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Open menu');
  }

  function openMenu() {
    root.classList.add('menu-open');
    menu?.classList.remove('hidden');
    void menu?.offsetHeight;
    menu?.classList.add('is-open');
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.setAttribute('aria-label', 'Close menu');
  }

  toggle?.addEventListener('click', () => {
    root.classList.contains('menu-open') ? closeMenu() : openMenu();
  });

  closeBtn?.addEventListener('click', closeMenu);
  backdrop?.addEventListener('click', closeMenu);

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>
