---
// src/components/Scene3D.astro
interface Props {
  class?: string;
  src?: string;
  rounded?: boolean;
  label?: string;
  ratio?: string;
  bubble?: string;
  bubbleSide?: 'left' | 'right';
  variant?: string;
  [key: string]: any;
}

const {
  class: className = '',
  src = '/scenes/hero.mp4',
  rounded = true,
  label,
  ratio = '1 / 1',
  bubble,
  bubbleSide = 'right',
} = Astro.props;

const videoSrc = src || '/scenes/hero.mp4';
---

<div class:list={['relative', className]}>
  {
    bubble && (
      <p
        class:list={[
          'bubble absolute -top-3 z-10 rounded-[18px] bg-ink px-5 py-3 font-display text-lg leading-none font-semibold text-paper uppercase',
          bubbleSide === 'right' ? 'right-0 bubble-right' : 'left-0 bubble-left',
        ]}
      >
        {bubble}
      </p>
    )
  }

  <div
    class:list={[
      'scene relative w-full h-full overflow-hidden bg-[#0a0a0f]',
      rounded && 'rounded-[30px]',
    ]}
    style={`--scene-ratio:${ratio}; aspect-ratio: var(--scene-ratio, 1 / 1);`}
    role={label ? 'img' : undefined}
    aria-label={label}
  >
    <!-- Direct video stream: no data-saver gating -->
    <video
      src={videoSrc}
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      class="absolute inset-0 w-full h-full object-cover pointer-events-none opacity-80"
    ></video>

    <!-- Subtle dark overlay gradient for readability -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-transparent via-[#0d1117]/40 to-[#0d1117] pointer-events-none"
    ></div>
  </div>
</div>

<style>
  .scene {
    aspect-ratio: var(--scene-ratio, 1 / 1);
  }

  /* Speech bubble tail */
  .bubble::after {
    content: '';
    position: absolute;
    bottom: -6px;
    width: 12px;
    height: 12px;
    background: var(--color-ink, #000);
    transform: rotate(45deg);
  }
  .bubble-right::after {
    right: 24px;
  }
  .bubble-left::after {
    left: 24px;
  }
</style>
