---
/**
 * Edge-to-edge scrolling strip. The track is duplicated so the loop is seamless;
 * the copy is aria-hidden so screen readers hear the phrase once.
 */
interface Props {
  items: string[];
  /** Dark strip on black, or light strip on the page background. */
  tone?: 'ink' | 'paper';
}

const { items, tone = 'ink' } = Astro.props;
---

<div
  class:list={[
    'marquee border-y py-5',
    tone === 'ink' ? 'border-ink bg-ink text-paper' : 'border-line bg-paper-dim text-ink',
  ]}
>
  {
    [0, 1].map((copy) => (
      <div class="marquee-track" aria-hidden={copy === 1 ? 'true' : undefined}>
        {items.map((item) => (
          <>
            <span class="font-display text-3xl font-semibold whitespace-nowrap uppercase sm:text-4xl">
              {item}
            </span>
            <span class="text-accent" aria-hidden="true">
              &#9679;
            </span>
          </>
        ))}
      </div>
    ))
  }
</div>
