---
import VerifyText from './VerifyText.astro';

/**
 * Native <details> accordion. No JS, and it stays usable with styles off.
 * Answers may contain {{VERIFY: ...}} tokens.
 */
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="border-t border-line">
  {
    items.map((item) => (
      <details class="accordion-item" name="faq">
        <summary>
          <span>{item.q}</span>
          <span class="accordion-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path
                d="M7 1v12M1 7h12"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              />
            </svg>
          </span>
        </summary>
        <div class="accordion-body lede">
          <VerifyText text={item.a} />
        </div>
      </details>
    ))
  }
</div>
