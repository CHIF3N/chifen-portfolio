---
/** Project status as a rubber stamp. The word is always printed, so colour is never the only signal. */
interface Props {
  status: 'live' | 'shipped' | 'in-progress' | 'concept';
  class?: string;
}
const { status, class: className } = Astro.props;
const label: Record<Props['status'], string> = {
  live: 'Live',
  shipped: 'Shipped',
  'in-progress': 'Building',
  concept: 'Concept / prototype',
};
---

<span class:list={['stamp', `stamp--${status}`, className]}>{label[status]}</span>
