---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import StatusStamp from './StatusStamp.astro';
import { withBase } from '../lib/url';

interface Props {
  entry: CollectionEntry<'work'>;
  index?: number;
}

const { entry, index = 0 } = Astro.props;
const { title, summary, tags, status, year, metrics, role, cover, liveUrl } = entry.data;
const href = withBase(`/work/${entry.id}`);
/* Phone screenshots sit whole inside the coloured card instead of being cropped. */
const portrait = cover ? cover.height > cover.width : false;

/* A little controlled irregularity: tilt and tape alternate, never random. */
const tilt = [-0.8, 0.6, -0.4, 0.9, -0.6, 0.3][index % 6];
const tones = ['var(--lime)', 'var(--lavender)', '#ffb48c', '#c9d4ff'];
const tone = tones[index % tones.length];
---

<article class="paper creased lift work-card flex h-full flex-col" style={`--r:${tilt}deg`}>
  {index % 3 === 0 && <span class="tape" style="top:-0.7rem;left:1.25rem;--tr:-5deg" aria-hidden="true" />}
  <div class="work-card-visual" style={`--tone:${tone}`}>
    {
      cover ? (
        <Image
          src={cover}
          alt=""
          widths={[420, 640, 900]}
          sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 30vw"
          loading="lazy"
          class:list={['h-full w-full', portrait ? 'object-contain py-3 drop-shadow-lg' : 'object-cover object-top']}
        />
      ) : (
        <span class="work-card-type" aria-hidden="true">
          <span class="font-display text-[clamp(1.8rem,4vw,2.4rem)] leading-[0.95] font-semibold">{title}</span>
          <span class="hand mt-2 text-lg">{tags.slice(0, 2).join(' · ')}</span>
        </span>
      )
    }
  </div>

  <div class="flex grow flex-col p-5 sm:p-6">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <StatusStamp status={status} />
      <span class="text-xs font-semibold text-slate">{year}</span>
    </div>
    <h3 class="mt-3 font-display text-2xl font-semibold">
      <a href={href} class="work-card-link">{title}</a>
    </h3>
    <p class="mt-1 text-xs font-semibold tracking-wide text-slate uppercase">{role}</p>
    <p class="mt-3 text-[0.95rem] leading-relaxed text-slate">{summary}</p>
    {metrics[0] && <p class="mt-4 border-t border-dashed border-line pt-3 text-sm font-semibold"><span class="hand mr-1 text-lg text-accent">proof:</span>{metrics[0]}</p>}
    <div class="mt-auto flex items-center justify-between gap-3 pt-5 text-sm font-semibold">
      <span class="text-accent" aria-hidden="true">Case study →</span>
      {liveUrl && <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="relative z-[2] ink-link">Live ↗</a>}
    </div>
  </div>
</article>

<style>
  .work-card {
    overflow: visible;
  }
  .work-card-visual {
    position: relative;
    aspect-ratio: 16 / 10;
    margin: 0.6rem 0.6rem 0;
    overflow: hidden;
    border-radius: 3px;
    border: 1px solid var(--color-line);
    background: var(--tone);
  }
  .work-card-type {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    padding: 1.1rem;
    color: #191919;
  }
  /* The whole card is clickable through the title link's stretched hit area. */
  .work-card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .work-card:hover h3 {
    color: var(--color-accent);
  }
</style>
