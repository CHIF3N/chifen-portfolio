---
import SocialIcon from './SocialIcon.astro';
import Wordmark from './Wordmark.astro';
import { site } from '../lib/site';
import { withBase } from '../lib/url';

const year = new Date().getFullYear();
const email = site.emails[0];
---

<footer class="site-footer mt-24">
  <div class="shell pt-16 pb-10">
    <div class="grid gap-12 lg:grid-cols-[1.25fr_1fr]">
      <div>
        <p class="hand text-2xl text-slate">you reached the bottom of the desk.</p>
        <h2 class="mt-3 font-display text-[clamp(2.4rem,6vw,4.2rem)] leading-[0.95] font-semibold">
          Got a good problem? <span class="serif-i font-normal">Let's</span> talk.
        </h2>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href={`mailto:${email}`} class="btn btn-accent">{email}</a>
          <button type="button" class="btn btn-ghost btn-sm" data-copy={email} aria-label={`Copy email address ${email}`}>
            <span data-copy-label>Copy email</span>
          </button>
        </div>
        <p class="mt-4 text-sm text-slate">
          Or WhatsApp <a class="ink-link font-semibold" href={site.whatsapp[0].href}>{site.whatsapp[0].label}</a>. Based in {site.location}.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        <div>
          <h3 class="eyebrow">Explore</h3>
          <ul class="mt-3 space-y-2 text-sm font-semibold">
            <li><a class="ink-link" href={withBase('/')}>Home</a></li>
            {site.nav.map((item) => <li><a class="ink-link" href={withBase(item.href)}>{item.label}</a></li>)}
            <li><a class="ink-link" href={withBase(site.resume)}>Résumé / CV</a></li>
          </ul>
        </div>
        <div>
          <h3 class="eyebrow">More drawers</h3>
          <ul class="mt-3 space-y-2 text-sm font-semibold">
            {site.secondaryNav.map((item) => <li><a class="ink-link" href={withBase(item.href)}>{item.label}</a></li>)}
            <li><a class="ink-link" href={withBase('/search')}>Search</a></li>
            <li><a class="ink-link" href={withBase('/rss.xml')}>RSS</a></li>
          </ul>
        </div>
        <div class="col-span-2 sm:col-span-1">
          <h3 class="eyebrow">Elsewhere</h3>
          <ul class="mt-3 space-y-2 text-sm font-semibold">
            {
              site.socials.map((social) => (
                <li>
                  <a
                    class="inline-flex items-center gap-2 hover:text-accent"
                    href={social.href}
                    target="_blank"
                    rel={social.label === 'Signal' ? 'nofollow noopener noreferrer' : 'noopener noreferrer'}
                  >
                    <SocialIcon label={social.label} size={14} />
                    {social.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t-[1.5px] border-dashed border-line pt-6 sm:flex-row sm:items-end sm:justify-between">
      <a href={withBase('/')} class="inline-flex items-end gap-3" aria-label="CHIF3N, back to the desk">
        <Wordmark size="sm" />
        <span class="pb-0.5 text-xs font-semibold text-slate">The Nurse Who Codes</span>
      </a>
      <p class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate">
        <span>&copy; {year} Chifen Sama Nduma</span>
        <span>Built with Astro in Cameroon</span>
        <span class="hidden sm:inline">Press <span class="kbd">/</span> to jump anywhere</span>
        <a href={withBase('/admin')} rel="nofollow" class="opacity-60 hover:opacity-100">Studio</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1.5px solid var(--color-ink);
    background-color: var(--paper-dim);
    background-image: radial-gradient(color-mix(in oklab, var(--color-ink) 9%, transparent) 1px, transparent 1px);
    background-size: 18px 18px;
  }
</style>

<script>
  // Copy-to-clipboard buttons anywhere on the page.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const label = btn.querySelector('[data-copy-label]') ?? btn;
      const original = label.textContent;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        label.textContent = 'Copied ✓';
      } catch {
        label.textContent = 'Press Ctrl+C';
      }
      setTimeout(() => (label.textContent = original), 1800);
    });
  });
</script>
