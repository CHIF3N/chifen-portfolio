---
import { site } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-ink/10 bg-ink text-paper">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="grid gap-10 sm:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-semibold">Say hello</h2>
        <p class="mt-3 max-w-sm text-paper/70">
          Working on something in health, data, or WhatsApp automation? I read every message.
          WhatsApp is fastest.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <h3 class="font-display text-xs font-semibold tracking-widest text-amber uppercase">
            Email
          </h3>
          <ul class="mt-3 space-y-1.5">
            {
              site.emails.map((email) => (
                <li>
                  <a
                    href={`mailto:${email}`}
                    class="text-sm text-paper/80 underline-offset-4 transition-colors hover:text-amber hover:underline"
                  >
                    {email}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h3 class="font-display text-xs font-semibold tracking-widest text-amber uppercase">
            WhatsApp
          </h3>
          <ul class="mt-3 space-y-1.5">
            {
              site.whatsapp.map((n) => (
                <li>
                  <a
                    href={n.href}
                    class="text-sm text-paper/80 underline-offset-4 transition-colors hover:text-amber hover:underline"
                  >
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <a
            href={site.github}
            class="mt-4 inline-block text-sm text-paper/80 underline-offset-4 transition-colors hover:text-amber hover:underline"
          >
            GitHub
          </a>
        </div>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-2 border-t border-paper/15 pt-6 text-xs text-paper/50 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} Chifen Sama N. Built in {site.location}.</p>
      <p>Astro, hand-written CSS, no template.</p>
    </div>
  </div>
</footer>
