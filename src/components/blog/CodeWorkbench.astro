---
/**
 * CodeWorkbench.astro
 * ───────────────────────────────────────────────────────────────────────────
 * VS Code / Antigravity style interactive multi-file code viewer.
 *
 * Features:
 *   - Hierarchical folder & subfolder explorer tree that can be clicked to fold/unfold.
 *   - Clicking any file opens the code in the editor pane and activates its tab.
 *   - Top tab strip with active indicators and quick switching.
 *   - Rich multi-color syntax highlighting (keywords, types, strings, numbers, functions, comments).
 *   - Interactive "Copy Code" button with instant checkmark feedback.
 *   - Collapsible sidebar toggle to expand code to full-width.
 *   - Breadcrumb navigation path matching active file tree location.
 *   - Read-only code viewing with line numbering and hover guides.
 */

export interface WorkbenchFile {
  name: string;
  lang?: string;
  language?: string;
  code: string;
}

interface Props {
  project?: string;
  title?: string;
  files: WorkbenchFile[];
}

const { project: projectProp, title: titleProp, files: rawFiles = [] } = Astro.props;
const project = projectProp ?? titleProp ?? 'project';

const files = rawFiles.map(f => ({
  name: f.name,
  lang: (f.lang ?? f.language ?? 'text').toLowerCase(),
  code: f.code ?? '',
}));

const uid = `wb-${Math.random().toString(36).slice(2, 8)}`;

// Language colors and badges
const langColor: Record<string, string> = {
  javascript: '#f7df1e', js: '#f7df1e',
  typescript: '#3178c6', ts: '#3178c6', tsx: '#3178c6', jsx: '#f7df1e',
  json: '#9cdcfe',
  bash: '#89d185', sh: '#89d185', shell: '#89d185',
  yaml: '#e06c75', yml: '#e06c75',
  html: '#e34c26', css: '#563d7c',
  sql: '#38bdf8', postgresql: '#38bdf8',
  mdx: '#f97316', md: '#f97316',
  dockerfile: '#2496ed', docker: '#2496ed',
  nginx: '#009639', python: '#3776ab', py: '#3776ab'
};

function extColor(lang?: string): string {
  if (!lang) return '#abb2bf';
  return langColor[lang.toLowerCase()] ?? '#abb2bf';
}

const langLabel: Record<string, string> = {
  javascript: 'JS', js: 'JS',
  typescript: 'TS', ts: 'TS', tsx: 'TSX', jsx: 'JSX',
  json: 'JSON',
  bash: 'BASH', sh: 'SH', shell: 'BASH',
  yaml: 'YAML', yml: 'YAML',
  html: 'HTML', css: 'CSS',
  sql: 'SQL', postgresql: 'SQL',
  mdx: 'MDX', md: 'MD',
  dockerfile: 'DOCKER', docker: 'DOCKER',
  nginx: 'NGINX', python: 'PY', py: 'PY'
};

function extLabel(lang?: string): string {
  if (!lang) return 'FILE';
  return langLabel[lang.toLowerCase()] ?? lang.toUpperCase().slice(0, 6);
}

function esc(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

/**
 * Lightweight, zero-dependency multi-color syntax highlighter.
 * Generates VS Code Dark+ theme token spans server-side.
 */
function highlightLine(rawLine: string, lang: string): string {
  if (!rawLine.trim()) return '&nbsp;';

  // 1. Separate line comments
  let line = rawLine;
  let commentHtml = '';
  
  const isHashComment = ['python', 'py', 'yaml', 'yml', 'bash', 'sh', 'shell', 'dockerfile', 'docker', 'nginx'].includes(lang);
  const isDashComment = ['sql', 'postgresql'].includes(lang);

  if (isHashComment) {
    const hashIdx = line.indexOf('#');
    if (hashIdx !== -1) {
      commentHtml = `<span class="cwb-tok-com">${esc(line.slice(hashIdx))}</span>`;
      line = line.slice(0, hashIdx);
    }
  } else if (isDashComment) {
    const dashIdx = line.indexOf('--');
    if (dashIdx !== -1) {
      commentHtml = `<span class="cwb-tok-com">${esc(line.slice(dashIdx))}</span>`;
      line = line.slice(0, dashIdx);
    }
  } else {
    // JS / TS / CSS / JSON / C style
    const slashIdx = line.indexOf('//');
    if (slashIdx !== -1) {
      commentHtml = `<span class="cwb-tok-com">${esc(line.slice(slashIdx))}</span>`;
      line = line.slice(0, slashIdx);
    }
  }

  // 2. Extract string literals to protect from keyword matching
  const strings: string[] = [];
  const stringRegex = /(".*?"|'.*?'|`.*?`)/g;
  let codeWithoutStrings = line.replace(stringRegex, (match) => {
    const placeholder = `___STR_${strings.length}___`;
    strings.push(match);
    return placeholder;
  });

  // 3. Escape HTML entities in code portion
  let out = esc(codeWithoutStrings);

  // 4. Highlight keywords
  const kwRegex = /\b(const|let|var|function|return|if|else|for|while|do|switch|case|break|continue|try|catch|finally|throw|new|class|extends|super|this|import|export|from|default|as|async|await|yield|type|interface|enum|public|private|protected|readonly|static|implements|package|typeof|instanceof|void|delete|in|of|SELECT|FROM|WHERE|INSERT|INTO|VALUES|UPDATE|SET|DELETE|CREATE|TABLE|DROP|ALTER|JOIN|LEFT|RIGHT|INNER|GROUP|BY|ORDER|ASC|DESC|LIMIT|OFFSET|AND|OR|NOT|PRIMARY|KEY|FOREIGN|REFERENCES|DEFAULT|events|server|http|location|proxy_pass|listen|def|class|lambda|with|elif)\b/g;
  out = out.replace(kwRegex, '<span class="cwb-tok-kw">$1</span>');

  // 5. Highlight types & builtins
  const typeRegex = /\b(string|number|boolean|any|unknown|never|Promise|Record|Array|Set|Map|Date|Object|Function|UUID|TEXT|INTEGER|BOOLEAN|TIMESTAMP|VARCHAR|JSONB|SERIAL|INT|FLOAT|true|false|null|undefined|None|True|False)\b/g;
  out = out.replace(typeRegex, '<span class="cwb-tok-type">$1</span>');

  // 6. Highlight function calls
  const fnRegex = /\b([a-zA-Z_$][a-zA-Z0-9_$]*)(?=\s*\()/g;
  out = out.replace(fnRegex, '<span class="cwb-tok-fn">$1</span>');

  // 7. Highlight numeric literals
  const numRegex = /\b(\d+(\.\d+)?)\b/g;
  out = out.replace(numRegex, '<span class="cwb-tok-num">$1</span>');

  // 8. Re-insert strings wrapped with styling
  strings.forEach((str, idx) => {
    const token = `___STR_${idx}___`;
    out = out.replace(token, `<span class="cwb-tok-str">${esc(str)}</span>`);
  });

  return out + commentHtml;
}

function renderCodeLines(code: string, lang: string): string {
  return code.split('\n').map((line, ln) => {
    const highlighted = highlightLine(line, lang);
    return `<div class="cwb-line" data-line="${ln + 1}"><span class="cwb-ln" aria-hidden="true">${ln + 1}</span><span class="cwb-lc">${highlighted}</span></div>`;
  }).join('');
}

// Build folder/file tree
interface FolderNode {
  type: 'folder';
  name: string;
  fullPath: string;
  children: (FolderNode | FileNode)[];
}

interface FileNode {
  type: 'file';
  name: string;
  fullPath: string;
  fileIndex: number;
  lang: string;
}

function buildTree(fileList: typeof files): (FolderNode | FileNode)[] {
  const roots: (FolderNode | FileNode)[] = [];

  fileList.forEach((file, index) => {
    const parts = file.name.split('/').filter(Boolean);
    let currentLevel = roots;
    let accumulatedPath = '';

    parts.forEach((part, partIdx) => {
      accumulatedPath = accumulatedPath ? `${accumulatedPath}/${part}` : part;
      const isFile = partIdx === parts.length - 1;

      if (isFile) {
        currentLevel.push({
          type: 'file',
          name: part,
          fullPath: file.name,
          fileIndex: index,
          lang: file.lang,
        });
      } else {
        let existingFolder = currentLevel.find(
          item => item.type === 'folder' && item.name === part
        ) as FolderNode | undefined;

        if (!existingFolder) {
          existingFolder = {
            type: 'folder',
            name: part,
            fullPath: accumulatedPath,
            children: [],
          };
          currentLevel.push(existingFolder);
        }
        currentLevel = existingFolder.children;
      }
    });
  });

  return roots;
}

const fileTree = buildTree(files);

function renderTree(nodes: (FolderNode | FileNode)[], depth = 0): string {
  let html = '';
  for (const node of nodes) {
    if (node.type === 'folder') {
      html += `
        <li class="cwb-tree-node cwb-tree-folder cwb-folder--open" data-path="${esc(node.fullPath)}">
          <button type="button" class="cwb-folder-btn" style="padding-left: calc(0.6rem + ${depth} * 0.85rem)" aria-expanded="true">
            <svg class="cwb-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
            <span class="cwb-folder-icon" aria-hidden="true">
              <svg class="cwb-icon-fld-open" width="14" height="14" viewBox="0 0 24 24" fill="#e8b339">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
              </svg>
              <svg class="cwb-icon-fld-closed" width="14" height="14" viewBox="0 0 24 24" fill="#dcb67a" style="display:none">
                <path d="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"></path>
              </svg>
            </span>
            <span class="cwb-folder-title">${esc(node.name)}</span>
          </button>
          <ul class="cwb-folder-children" role="list">
            ${renderTree(node.children, depth + 1)}
          </ul>
        </li>
      `;
    } else {
      const isActive = node.fileIndex === 0;
      html += `
        <li class="cwb-tree-node cwb-tree-file">
          <button
            type="button"
            class="cwb-file-btn ${isActive ? 'cwb-file-btn--active' : ''}"
            data-index="${node.fileIndex}"
            data-path="${esc(node.fullPath)}"
            style="padding-left: calc(0.6rem + ${depth} * 0.85rem)"
            aria-selected="${isActive ? 'true' : 'false'}"
          >
            <span class="cwb-file-dot" style="background:${extColor(node.lang)}" aria-hidden="true"></span>
            <span class="cwb-file-name">${esc(node.name)}</span>
            <span class="cwb-file-badge">${extLabel(node.lang)}</span>
          </button>
        </li>
      `;
    }
  }
  return html;
}

const renderedTreeHtml = renderTree(fileTree);
---

<div class="cwb" id={uid} data-uid={uid}>
  <!-- Title bar -->
  <div class="cwb-titlebar">
    <div class="cwb-title-left">
      <span class="cwb-dots" aria-hidden="true">
        <span class="cwb-dot cwb-dot--red"></span>
        <span class="cwb-dot cwb-dot--yellow"></span>
        <span class="cwb-dot cwb-dot--green"></span>
      </span>

      <button type="button" class="cwb-sidebar-toggle" id={`${uid}-toggle-sidebar`} aria-label="Toggle explorer sidebar" title="Toggle explorer sidebar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="9" y1="3" x2="9" y2="21"></line>
        </svg>
      </button>

      <div class="cwb-breadcrumb">
        <span class="cwb-bc-project">{project}</span>
        <span class="cwb-bc-sep" aria-hidden="true">/</span>
        <span class="cwb-bc-file" id={`${uid}-bc`}>{files[0]?.name ?? ''}</span>
      </div>
    </div>

    <button type="button" class="cwb-copy" id={`${uid}-copy`} aria-label="Copy code" title="Copy code">
      <svg class="cwb-copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="9" y="9" width="13" height="13" rx="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <span class="cwb-copy-label">Copy Code</span>
    </button>
  </div>

  <!-- Tab strip -->
  <div class="cwb-tabs" role="tablist" id={`${uid}-tabs`}>
    {files.map((f, i) => (
      <button
        type="button"
        class:list={['cwb-tab', i === 0 && 'cwb-tab--active']}
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-controls={`${uid}-panel-${i}`}
        id={`${uid}-tab-${i}`}
        data-index={String(i)}
        data-path={f.name}
      >
        <span class="cwb-tab-dot" style={`background:${extColor(f.lang)}`} aria-hidden="true"></span>
        <span class="cwb-tab-title">{f.name.split('/').pop()}</span>
        <span class="cwb-tab-badge">{extLabel(f.lang)}</span>
      </button>
    ))}
  </div>

  <!-- Body: Sidebar + Editor Panels -->
  <div class="cwb-body">
    <!-- Explorer Sidebar -->
    <nav class="cwb-sidebar" id={`${uid}-sidebar`} aria-label="File explorer">
      <div class="cwb-sidebar-head">
        <div class="cwb-sidebar-title">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"/>
          </svg>
          <span>EXPLORER: {project.toUpperCase()}</span>
        </div>
      </div>

      <ul class="cwb-tree-root" role="list" set:html={renderedTreeHtml} />
    </nav>

    <!-- Editor Panels with Syntax Highlighted Lines -->
    <div class="cwb-panels">
      {files.map((f, i) => (
        <div
          class:list={['cwb-panel', i === 0 && 'cwb-panel--active']}
          role="tabpanel"
          id={`${uid}-panel-${i}`}
          aria-labelledby={`${uid}-tab-${i}`}
          hidden={i !== 0}
        >
          <div class="cwb-code-scroller">
            <div class="cwb-code-content" set:html={renderCodeLines(f.code, f.lang)} />
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script type="application/json" id={`${uid}-data`} set:text={JSON.stringify(
  files.map(f => ({ name: f.name, code: f.code }))
)} />

<script>
(function () {
  function init(wb: HTMLElement) {
    const uid = wb.dataset.uid!;
    const dataEl = document.getElementById(`${uid}-data`);
    if (!dataEl) return;
    const files: Array<{ name: string; code: string }> =
      JSON.parse(dataEl.textContent ?? '[]');

    const tabs         = wb.querySelectorAll<HTMLElement>('.cwb-tab');
    const panels       = wb.querySelectorAll<HTMLElement>('.cwb-panel');
    const fileButtons  = wb.querySelectorAll<HTMLElement>('.cwb-file-btn');
    const folderButtons = wb.querySelectorAll<HTMLElement>('.cwb-folder-btn');
    const bcFile       = document.getElementById(`${uid}-bc`);
    const copyBtn      = document.getElementById(`${uid}-copy`);
    const copyLabel    = copyBtn?.querySelector<HTMLElement>('.cwb-copy-label');
    const toggleSidebar = document.getElementById(`${uid}-toggle-sidebar`);
    const sidebar      = document.getElementById(`${uid}-sidebar`);

    function activateFile(index: number) {
      if (index < 0 || index >= files.length) return;

      // Update tabs
      tabs.forEach((t, i) => {
        const on = i === index;
        t.classList.toggle('cwb-tab--active', on);
        t.setAttribute('aria-selected', String(on));
        if (on) t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
      });

      // Update panels
      panels.forEach((p, i) => {
        const on = i === index;
        p.classList.toggle('cwb-panel--active', on);
        (p as HTMLElement).hidden = !on;
      });

      // Update tree buttons
      fileButtons.forEach((btn) => {
        const on = Number(btn.dataset.index) === index;
        btn.classList.toggle('cwb-file-btn--active', on);
        btn.setAttribute('aria-selected', String(on));
      });

      // Update breadcrumb
      if (bcFile) {
        bcFile.textContent = files[index]?.name ?? '';
      }
    }

    // Tab clicks
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        activateFile(Number(tab.dataset.index));
      });
    });

    // File tree clicks
    fileButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        activateFile(Number(btn.dataset.index));
      });
    });

    // Folder open/close toggle
    folderButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const folderNode = btn.closest<HTMLElement>('.cwb-tree-folder');
        if (!folderNode) return;

        const isOpen = folderNode.classList.contains('cwb-folder--open');
        folderNode.classList.toggle('cwb-folder--open', !isOpen);
        btn.setAttribute('aria-expanded', String(!isOpen));

        const iconOpen = btn.querySelector<HTMLElement>('.cwb-icon-fld-open');
        const iconClosed = btn.querySelector<HTMLElement>('.cwb-icon-fld-closed');
        if (iconOpen && iconClosed) {
          iconOpen.style.display = isOpen ? 'none' : 'inline-block';
          iconClosed.style.display = isOpen ? 'inline-block' : 'none';
        }
      });
    });

    // Copy button
    if (copyBtn && copyLabel) {
      copyBtn.addEventListener('click', () => {
        const activeIndex = [...tabs].findIndex(t =>
          t.classList.contains('cwb-tab--active')
        );
        const codeToCopy = files[activeIndex]?.code ?? '';
        navigator.clipboard?.writeText(codeToCopy).then(() => {
          copyLabel.textContent = 'Copied!';
          copyBtn.classList.add('cwb-copy--ok');
          setTimeout(() => {
            copyLabel.textContent = 'Copy Code';
            copyBtn.classList.remove('cwb-copy--ok');
          }, 2000);
        });
      });
    }

    // Toggle sidebar collapse
    toggleSidebar?.addEventListener('click', () => {
      if (sidebar) {
        sidebar.classList.toggle('cwb-sidebar--collapsed');
      }
    });
  }

  document.querySelectorAll<HTMLElement>('.cwb').forEach(init);
})();
</script>

<style>
  .cwb {
    --cwb-bg:         #0d1117;
    --cwb-bar-bg:     #161b22;
    --cwb-sidebar-bg: #0d1117;
    --cwb-border:     rgba(255, 255, 255, 0.08);
    --cwb-text:       #e6edf3;
    --cwb-muted:      #7d8590;
    --cwb-accent:     var(--color-accent, #38bdf8);
    --cwb-ln-color:   #484f58;
    --cwb-font:       'JetBrains Mono', 'Fira Code', 'SF Mono', Consolas, monospace;
    --cwb-font-size:  0.8125rem;

    display: flex;
    flex-direction: column;
    border-radius: 12px;
    border: 1px solid var(--cwb-border);
    background: var(--cwb-bg);
    overflow: hidden;
    margin-block: 2rem;
    font-family: var(--cwb-font);
    font-size: var(--cwb-font-size);
    line-height: 1.6;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.04), 0 12px 36px rgba(0, 0, 0, 0.55);
  }

  /* Title bar */
  .cwb-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.85rem;
    background: var(--cwb-bar-bg);
    border-bottom: 1px solid var(--cwb-border);
    user-select: none;
    gap: 0.75rem;
  }

  .cwb-title-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    overflow: hidden;
  }

  .cwb-dots {
    display: flex;
    gap: 5px;
    align-items: center;
    flex-shrink: 0;
  }

  .cwb-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .cwb-dot--red    { background: #ff5f56; }
  .cwb-dot--yellow { background: #ffbd2e; }
  .cwb-dot--green  { background: #27c93f; }

  .cwb-sidebar-toggle {
    background: transparent;
    border: none;
    color: var(--cwb-muted);
    cursor: pointer;
    display: grid;
    place-items: center;
    padding: 0.2rem;
    border-radius: 4px;
    transition: color 0.15s, background 0.15s;
  }
  .cwb-sidebar-toggle:hover {
    color: var(--cwb-text);
    background: rgba(255, 255, 255, 0.08);
  }

  .cwb-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--cwb-muted);
    font-size: 0.75rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cwb-bc-project {
    color: #c9d1d9;
    font-weight: 600;
  }

  .cwb-bc-file {
    color: var(--cwb-accent);
    font-weight: 500;
  }

  .cwb-copy {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.65rem;
    border-radius: 6px;
    border: 1px solid var(--cwb-border);
    background: rgba(255, 255, 255, 0.04);
    color: var(--cwb-muted);
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: all 0.18s;
  }
  .cwb-copy:hover {
    color: var(--cwb-text);
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.18);
  }
  .cwb-copy--ok {
    color: #3fb950 !important;
    border-color: rgba(63, 185, 80, 0.4) !important;
    background: rgba(63, 185, 80, 0.1) !important;
  }

  /* Tab strip */
  .cwb-tabs {
    display: flex;
    background: #0d1117;
    border-bottom: 1px solid var(--cwb-border);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .cwb-tabs::-webkit-scrollbar {
    display: none;
  }

  .cwb-tab {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.85rem;
    background: transparent;
    border: none;
    border-right: 1px solid var(--cwb-border);
    color: var(--cwb-muted);
    font-family: inherit;
    font-size: 0.75rem;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s;
    border-top: 2px solid transparent;
  }
  .cwb-tab:hover {
    color: var(--cwb-text);
    background: rgba(255, 255, 255, 0.03);
  }
  .cwb-tab--active {
    color: var(--cwb-text);
    background: var(--cwb-bar-bg);
    border-top-color: var(--cwb-accent);
    font-weight: 600;
  }

  .cwb-tab-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .cwb-tab-badge {
    font-size: 0.625rem;
    color: var(--cwb-muted);
    background: rgba(255, 255, 255, 0.06);
    border-radius: 3px;
    padding: 0.1rem 0.3rem;
  }

  /* Body: Sidebar + Panels */
  .cwb-body {
    display: flex;
    min-height: 380px;
    max-height: 600px;
    position: relative;
