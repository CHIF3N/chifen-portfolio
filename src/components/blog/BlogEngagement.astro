---
/**
 * BlogEngagement — zero-backend edition
 *
 * Likes:    localStorage only. Instant, no backend needed.
 * Comments: Giscus (GitHub Discussions). Zero cost, no backend.
 *
 * Props:
 *   postId  — the blog post slug (used as localStorage key and Giscus term)
 *
 * Giscus setup (one-time):
 *   1. Install the Giscus GitHub App on CHIF3N/chifen-portfolio:
 *      https://github.com/apps/giscus
 *   2. Enable Discussions on the repo (Settings → Features → Discussions)
 *   3. Run https://giscus.app to get your repo ID and category ID
 *   4. Paste the values into giscusConfig below
 */

interface Props {
  postId: string;
}

const { postId } = Astro.props;

// ── Giscus configuration ────────────────────────────────────────────────────
// Replace these placeholders after running https://giscus.app
const giscusConfig = {
  repo: 'CHIF3N/chifen-portfolio',
  repoId: 'PLACEHOLDER_REPO_ID',          // from giscus.app
  category: 'Blog Comments',
  categoryId: 'PLACEHOLDER_CATEGORY_ID',  // from giscus.app
  mapping: 'specific',
  term: postId,
  theme: 'preferred_color_scheme',
  lang: 'en',
};

const giscusReady = !giscusConfig.repoId.startsWith('PLACEHOLDER');
---

<div id="blog-engagement" data-post-id={postId} class="mt-16 border-t border-line pt-10">
  <!-- ── Likes ── -->
  <div class="flex items-center gap-4">
    <button
      id="like-btn"
      type="button"
      class="group flex items-center gap-2.5 rounded-full border border-line px-4 py-2.5 text-sm font-semibold transition-all hover:border-accent hover:text-accent"
      aria-label="Like this post"
      aria-pressed="false"
    >
      <svg
        id="like-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="transition-colors"
      >
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
      </svg>
      <span id="like-count">–</span>
    </button>
    <p id="like-msg" class="text-sm text-slate-light" aria-live="polite"></p>
  </div>

  <!-- ── Comments (Giscus) ── -->
  <div class="mt-12">
    <h2 class="font-display text-2xl font-semibold">Comments</h2>

    {giscusReady ? (
      <div class="mt-6" id="giscus-container">
        <script
          is:inline
          src="https://giscus.app/client.js"
          data-repo={giscusConfig.repo}
          data-repo-id={giscusConfig.repoId}
          data-category={giscusConfig.category}
          data-category-id={giscusConfig.categoryId}
          data-mapping={giscusConfig.mapping}
          data-term={giscusConfig.term}
          data-strict="1"
          data-reactions-enabled="0"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme={giscusConfig.theme}
          data-lang={giscusConfig.lang}
          crossorigin="anonymous"
          async
        ></script>
      </div>
    ) : (
      <p class="mt-4 text-sm text-slate-light">
        Comments coming soon. Set up{' '}
        <a
          href="https://giscus.app"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent underline underline-offset-2 hover:no-underline"
        >
          Giscus
        </a>{' '}
        on the repo to enable them.
      </p>
    )}
  </div>
</div>

<script>
  /**
   * localStorage-based likes.
   * Count and liked state are stored locally — no backend required.
   */
  const container = document.getElementById('blog-engagement');
  if (container) {
    const POST_ID = container.dataset.postId ?? '';
    const COUNT_KEY = `like_count:${POST_ID}`;
    const LIKED_KEY = `liked:${POST_ID}`;

    const likeBtn = document.getElementById('like-btn') as HTMLButtonElement;
    const likeCountEl = document.getElementById('like-count')!;
    const likeMsgEl = document.getElementById('like-msg')!;
    const likeIcon = document.getElementById('like-icon')!;

    let count = parseInt(localStorage.getItem(COUNT_KEY) ?? '0', 10);
    let liked = localStorage.getItem(LIKED_KEY) === '1';

    function render() {
      likeCountEl.textContent = String(count);
      likeBtn.setAttribute('aria-pressed', liked ? 'true' : 'false');
      likeBtn.classList.toggle('border-accent', liked);
      likeBtn.classList.toggle('text-accent', liked);
      likeIcon.setAttribute('fill', liked ? 'currentColor' : 'none');
    }

    render();

    likeBtn.addEventListener('click', () => {
      if (liked) {
        liked = false;
        count = Math.max(0, count - 1);
        localStorage.removeItem(LIKED_KEY);
        likeMsgEl.textContent = '';
      } else {
        liked = true;
        count += 1;
        localStorage.setItem(LIKED_KEY, '1');
        likeMsgEl.textContent = 'Thanks for the like.';
        setTimeout(() => (likeMsgEl.textContent = ''), 3000);
      }
      localStorage.setItem(COUNT_KEY, String(count));
      render();
    });
  }
</script>
