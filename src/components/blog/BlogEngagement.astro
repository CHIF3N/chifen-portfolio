---
/**
 * BlogEngagement
 *
 * Renders a likes counter and comments section for a blog post.
 * Uses Firebase Firestore for real-time updates.
 * Requires PUBLIC_FIREBASE_* environment variables to be set.
 *
 * Props:
 *   postId — the blog post slug/id (used as the Firestore document key)
 */

interface Props {
  postId: string;
}

const { postId } = Astro.props;

const hasFirebase = !!(
  import.meta.env.PUBLIC_FIREBASE_API_KEY &&
  import.meta.env.PUBLIC_FIREBASE_PROJECT_ID
);
---

{
  hasFirebase ? (
    <div id="blog-engagement" data-post-id={postId} class="mt-16 border-t border-line pt-10">
      <!-- Likes -->
      <div class="flex items-center gap-4" id="likes-section">
        <button
          id="like-btn"
          type="button"
          class="group flex items-center gap-2.5 rounded-full border border-line px-4 py-2.5 text-sm font-semibold transition-all hover:border-accent hover:text-accent"
          aria-label="Like this post"
          aria-pressed="false"
        >
          <svg
            id="like-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="transition-colors"
          >
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
          </svg>
          <span id="like-count">–</span>
        </button>
        <p id="like-msg" class="text-sm text-slate-light" aria-live="polite" />
      </div>

      <!-- Comments -->
      <div class="mt-12">
        <h2 class="font-display text-2xl font-semibold">Comments</h2>

        <!-- Comment form -->
        <form id="comment-form" class="mt-6 space-y-4" novalidate>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="comment-name" class="eyebrow mb-2 block">Name</label>
              <input
                id="comment-name"
                name="name"
                type="text"
                required
                maxlength="80"
                placeholder="Your name"
                class="w-full rounded-xl border border-line bg-paper px-4 py-3 text-sm outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/20"
              />
            </div>
            <div>
              <label for="comment-email" class="eyebrow mb-2 block">
                Email <span class="font-normal normal-case text-slate-light">(not published)</span>
              </label>
              <input
                id="comment-email"
                name="email"
                type="email"
                maxlength="200"
                placeholder="you@example.com"
                class="w-full rounded-xl border border-line bg-paper px-4 py-3 text-sm outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/20"
              />
            </div>
          </div>
          <div>
            <label for="comment-body" class="eyebrow mb-2 block">Comment</label>
            <textarea
              id="comment-body"
              name="body"
              required
              rows="4"
              maxlength="1000"
              placeholder="What are your thoughts?"
              class="w-full rounded-xl border border-line bg-paper px-4 py-3 text-sm outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/20"
            />
          </div>
          <p id="comment-error" class="text-sm text-red-500 hidden" role="alert" />
          <button type="submit" id="comment-submit" class="btn btn-accent btn-sm">
            Post comment
            <span aria-hidden="true">&rarr;</span>
          </button>
        </form>

        <!-- Comments list -->
        <div id="comments-list" class="mt-10 space-y-6">
          <p id="comments-loading" class="text-sm text-slate-light">Loading comments…</p>
        </div>
      </div>
    </div>
  ) : (
    /* Firebase not configured: render nothing. No broken UI. */
    <div />
  )
}

<script>
  /**
   * Blog engagement script.
   * Loaded only when the engagement widget is present in the DOM.
   * Uses dynamic imports so Firebase is never bundled into pages
   * that don't have the widget.
   */

  // Static imports — Vite resolves these at build time.
  // The container guard below prevents any execution on pages without the widget.
  import { db } from '@/lib/firebase';
  import {
    doc, getDoc, setDoc, updateDoc, increment,
    collection, addDoc, onSnapshot, query, orderBy, serverTimestamp
  } from 'firebase/firestore';

  const container = document.getElementById('blog-engagement');
  if (!container) {
    // Widget not rendered (Firebase not configured). Stop here.
    throw new Error(''); // non-fatal: just stops script execution
  }

  const POST_ID = container.dataset.postId!;
  const LIKED_KEY = `liked:${POST_ID}`;


  // ── Firestore references ──────────────────────────────────────────────────

  const postRef = doc(db, 'posts', POST_ID);
  const commentsRef = collection(db, 'posts', POST_ID, 'comments');

  // ── Likes ─────────────────────────────────────────────────────────────────

  const likeBtn = document.getElementById('like-btn') as HTMLButtonElement;
  const likeCountEl = document.getElementById('like-count')!;
  const likeMsgEl = document.getElementById('like-msg')!;

  let liked = localStorage.getItem(LIKED_KEY) === '1';

  function updateLikeUI(count: number) {
    likeCountEl.textContent = String(count);
    likeBtn.setAttribute('aria-pressed', liked ? 'true' : 'false');
    likeBtn.classList.toggle('border-accent', liked);
    likeBtn.classList.toggle('text-accent', liked);
    const icon = document.getElementById('like-icon')!;
    icon.setAttribute('fill', liked ? 'currentColor' : 'none');
  }

  // Seed the post document if it does not exist yet.
  async function ensurePostDoc() {
    const snap = await getDoc(postRef);
    if (!snap.exists()) {
      await setDoc(postRef, { likes: 0, createdAt: serverTimestamp() });
    }
    return snap.exists() ? (snap.data().likes as number) : 0;
  }

  const initialLikes = await ensurePostDoc();
  updateLikeUI(initialLikes);

  likeBtn.addEventListener('click', async () => {
    if (liked) {
      // Undo like
      liked = false;
      localStorage.removeItem(LIKED_KEY);
      await updateDoc(postRef, { likes: increment(-1) });
      const snap = await getDoc(postRef);
      updateLikeUI((snap.data()?.likes as number) ?? 0);
      likeMsgEl.textContent = '';
    } else {
      liked = true;
      localStorage.setItem(LIKED_KEY, '1');
      await updateDoc(postRef, { likes: increment(1) });
      const snap = await getDoc(postRef);
      updateLikeUI((snap.data()?.likes as number) ?? 0);
      likeMsgEl.textContent = 'Thanks for the like.';
      setTimeout(() => (likeMsgEl.textContent = ''), 3000);
    }
  });

  // ── Comments ──────────────────────────────────────────────────────────────

  const commentForm = document.getElementById('comment-form') as HTMLFormElement;
  const commentsList = document.getElementById('comments-list')!;
  const commentsLoading = document.getElementById('comments-loading')!;
  const commentError = document.getElementById('comment-error')!;
  const commentSubmit = document.getElementById('comment-submit') as HTMLButtonElement;

  const dateFormat = new Intl.DateTimeFormat('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });

  function renderComment(data: Record<string, any>) {
    const el = document.createElement('article');
    el.className =
      'rounded-2xl border border-line bg-paper-dim/50 px-6 py-5';
    const ts = data.createdAt?.toDate?.();
    el.innerHTML = `
      <div class="flex items-baseline justify-between gap-4">
        <span class="font-display font-semibold">${escapeHtml(data.name ?? 'Anonymous')}</span>
        ${ts ? `<time class="text-xs text-slate-light" datetime="${ts.toISOString()}">${dateFormat.format(ts)}</time>` : ''}
      </div>
      <p class="mt-3 text-sm leading-relaxed text-slate">${escapeHtml(data.body ?? '')}</p>
    `;
    return el;
  }

  function escapeHtml(str: string) {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // Real-time comment listener
  const q = query(commentsRef, orderBy('createdAt', 'asc'));
  onSnapshot(q, (snapshot) => {
    commentsLoading.remove();
    commentsList.innerHTML = '';
    if (snapshot.empty) {
      const empty = document.createElement('p');
      empty.className = 'text-sm text-slate-light';
      empty.textContent = 'No comments yet. Be the first.';
      commentsList.appendChild(empty);
    } else {
      snapshot.forEach((docSnap) => {
        commentsList.appendChild(renderComment(docSnap.data()));
      });
    }
  });

  commentForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    commentError.classList.add('hidden');
    commentError.textContent = '';

    const name = (commentForm.querySelector('#comment-name') as HTMLInputElement).value.trim();
    const body = (commentForm.querySelector('#comment-body') as HTMLTextAreaElement).value.trim();

    if (!name) {
      commentError.textContent = 'Please enter your name.';
      commentError.classList.remove('hidden');
      return;
    }
    if (!body) {
      commentError.textContent = 'Please enter a comment.';
      commentError.classList.remove('hidden');
      return;
    }

    commentSubmit.disabled = true;
    commentSubmit.textContent = 'Posting…';

    try {
      await addDoc(commentsRef, {
        name,
        body,
        createdAt: serverTimestamp(),
      });
      commentForm.reset();
    } catch (err) {
      console.error(err);
      commentError.textContent = 'Something went wrong. Please try again.';
      commentError.classList.remove('hidden');
    } finally {
      commentSubmit.disabled = false;
      commentSubmit.textContent = 'Post comment';
      commentSubmit.insertAdjacentHTML('beforeend', ' <span aria-hidden="true">&rarr;</span>');
    }
  });
</script>
