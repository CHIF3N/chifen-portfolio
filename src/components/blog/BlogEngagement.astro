---
/**
 * Comments and reactions for a blog post, powered by giscus
 * (GitHub Discussions on CHIF3N/chifen-portfolio, "Announcements" category).
 *
 * Every number shown here is real: reactions and comments live on GitHub.
 * The old per-browser localStorage like counter was removed because each
 * visitor only ever saw their own clicks.
 *
 * One-time setup that has to be done by the repo owner:
 *   - Discussions enabled on the repo (done)
 *   - The giscus GitHub App installed on the repo: https://github.com/apps/giscus
 *
 * The widget loads only when the comments section scrolls near the viewport,
 * and follows the site's light/dark toggle.
 */
interface Props {
  postId: string;
}

const { postId } = Astro.props;

const giscus = {
  repo: 'CHIF3N/chifen-portfolio',
  repoId: 'R_kgDOTnMjXQ',
  category: 'Announcements',
  categoryId: 'DIC_kwDOTnMjXc4DIlaQ',
};
---

<section id="blog-engagement" class="engagement" aria-labelledby="comments-title" data-term={`blog/${postId}`}>
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="hand text-2xl text-slate">leave a note in the margin</p>
      <h2 id="comments-title" class="font-display text-3xl font-semibold">Comments &amp; reactions</h2>
    </div>
    <p class="text-sm text-slate">Sign in with GitHub to react or comment.</p>
  </div>

  <div
    id="giscus-mount"
    class="paper mt-6 min-h-[12rem] p-3 sm:p-5"
    style="--r:-0.3deg"
    data-repo={giscus.repo}
    data-repo-id={giscus.repoId}
    data-category={giscus.category}
    data-category-id={giscus.categoryId}
  >
    <p class="giscus-placeholder text-sm text-slate">Loading comments…</p>
    <noscript><p class="text-sm text-slate">Comments need JavaScript. You can also reply on <a class="ink-link" href={`https://github.com/${giscus.repo}/discussions`}>GitHub Discussions</a>.</p></noscript>
  </div>
</section>

<style>
  .engagement {
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1.5px dashed var(--color-line);
  }
</style>

<script>
  const section = document.getElementById('blog-engagement');
  const mount = document.getElementById('giscus-mount');

  const currentTheme = () => {
    const dark =
      document.documentElement.dataset.theme === 'dark' ||
      (!document.documentElement.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    // Served from Vercel, which sends the CORS header giscus needs (GitHub Pages can't).
    return `https://chifen-portfolio.vercel.app/giscus/paper-${dark ? 'dark' : 'light'}.css`;
  };

  const load = () => {
    if (!section || !mount || mount.querySelector('script')) return;
    const s = document.createElement('script');
    s.src = 'https://giscus.app/client.js';
    s.async = true;
    s.crossOrigin = 'anonymous';
    const attrs: Record<string, string> = {
      'data-repo': mount.dataset.repo!,
      'data-repo-id': mount.dataset.repoId!,
      'data-category': mount.dataset.category!,
      'data-category-id': mount.dataset.categoryId!,
      'data-mapping': 'specific',
      'data-term': section.dataset.term!,
      'data-strict': '1',
      'data-reactions-enabled': '1',
      'data-emit-metadata': '0',
      'data-input-position': 'top',
      'data-theme': currentTheme(),
      'data-lang': 'en',
      'data-loading': 'lazy',
    };
    Object.entries(attrs).forEach(([k, v]) => s.setAttribute(k, v));
    mount.querySelector('.giscus-placeholder')?.remove();
    mount.appendChild(s);
  };

  if (section && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          load();
        }
      },
      { rootMargin: '600px 0px' }
    );
    io.observe(section);
  } else {
    load();
  }

  // Keep the comments in step with the site's theme toggle.
  new MutationObserver(() => {
    const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme: currentTheme() } } }, 'https://giscus.app');
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>
