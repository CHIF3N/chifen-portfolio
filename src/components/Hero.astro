---
import { Image } from 'astro:assets';
import portraitImg from '../assets/photos/chifen-portrait.jpg';
import { withBase } from '../lib/url';
---

<section class="relative w-full pt-8 pb-14 sm:pt-14 sm:pb-20 lg:pt-16 lg:pb-24 border-b border-line/60 overflow-hidden">
  <div class="shell">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Left Column: Editorial Headline & Value Proposition (7 cols) -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        <!-- Eyebrow & Live Status -->
        <div class="flex items-center gap-2.5 text-xs font-mono uppercase tracking-wider text-slate mb-4 sm:mb-6">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="font-semibold text-ink">CHIFEN SAMA</span>
          <span class="text-line">&bull;</span>
          <span>BUEA / YAOUNDÉ, CAMEROON</span>
        </div>

        <!-- Primary Massive Editorial Headline -->
        <h1 class="font-display font-bold tracking-tight text-ink uppercase leading-[0.88] select-none text-[clamp(3.5rem,9.5vw,7.8rem)]">
          The Nurse<br />
          <span class="text-accent">Who Codes.</span>
        </h1>

        <!-- Short Supporting Positioning Copy -->
        <p class="mt-6 text-lg sm:text-xl lg:text-2xl text-ink font-normal leading-relaxed max-w-xl text-balance">
          I build technology for healthcare, communities and real-world problems &mdash; especially where data, connectivity and resources are limited.
        </p>

        <!-- Compact Identity Line (Clean unboxed text) -->
        <div class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs sm:text-sm font-medium text-slate">
          <span>Nurse</span>
          <span class="text-line" aria-hidden="true">&middot;</span>
          <span>Developer</span>
          <span class="text-line" aria-hidden="true">&middot;</span>
          <span>Health-tech builder</span>
          <span class="text-line" aria-hidden="true">&middot;</span>
          <span>Data Science</span>
        </div>

        <!-- Action CTAs -->
        <div class="mt-8 sm:mt-10 flex flex-wrap items-center gap-3 sm:gap-4">
          <a
            href="#featured-work"
            class="inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3.5 text-sm font-semibold text-paper shadow-md transition-all hover:bg-ink-700 hover:scale-[1.02] active:scale-[0.98]"
          >
            <span>SEE MY WORK</span>
            <span aria-hidden="true">&rarr;</span>
          </a>

          <a
            href={withBase('/contact')}
            class="inline-flex items-center gap-2 rounded-full border border-line bg-paper px-6 py-3.5 text-sm font-semibold text-ink transition-all hover:border-ink hover:bg-paper-dim hover:scale-[1.02] active:scale-[0.98]"
          >
            <span>LET'S TALK</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Visual Persona & Asymmetric Media Card (5 cols) -->
      <div class="lg:col-span-5 relative mt-4 lg:mt-0">
        <div class="relative mx-auto max-w-md lg:max-w-none rounded-2xl overflow-hidden border border-line bg-paper-dim p-2.5 sm:p-3 shadow-xl">
          <!-- Portrait Container -->
          <div class="relative aspect-[4/5] rounded-xl overflow-hidden bg-ink">
            <Image
              src={portraitImg}
              alt="Chifen Sama Nduma — The Nurse Who Codes"
              widths={[400, 700, 900]}
              sizes="(max-width: 640px) 90vw, (max-width: 1024px) 50vw, 420px)"
              priority={true}
              class="w-full h-full object-cover object-top transition-transform duration-700 hover:scale-105"
            />
            <!-- Visual scrim for bottom caption overlay -->
            <div class="absolute inset-x-0 bottom-0 p-5 bg-gradient-to-t from-black/90 via-black/50 to-transparent text-white">
              <p class="text-xs font-mono uppercase tracking-widest text-emerald-400 font-semibold mb-1">
                Clinical Intuition &times; Self-Trained Dev
              </p>
              <p class="text-sm font-semibold leading-snug">
                Chifen Sama Nduma
              </p>
              <p class="text-xs text-white/75 mt-0.5">
                Lead Architect @ LifeDrop &bull; M.Tech Data Science (COLTECH UBa)
              </p>
            </div>
          </div>

          <!-- Quick Proof Pill Strip attached to card -->
          <div class="pt-3 px-1 flex items-center justify-between text-[11px] font-mono text-slate">
            <span>&bull; Buea Regional Hospital Study</span>
            <span>&bull; MTN YaMo Winner</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Proof Strip at bottom of Hero -->
    <div class="mt-12 sm:mt-16 pt-6 border-t border-line/60 grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 text-xs text-slate">
      <div>
        <span class="block font-display text-2xl sm:text-3xl font-bold text-ink tabular-nums">5,000+</span>
        <span class="text-xs text-slate font-medium">Lives directly reached &amp; impacted</span>
      </div>
      <div>
        <span class="block font-display text-2xl sm:text-3xl font-bold text-ink tabular-nums">8,500+</span>
        <span class="text-xs text-slate font-medium">Platform reach across built tech</span>
      </div>
      <div>
        <span class="block font-display text-2xl sm:text-3xl font-bold text-ink tabular-nums">387</span>
        <span class="text-xs text-slate font-medium">Hospital clinicians surveyed</span>
      </div>
      <div>
        <span class="block font-display text-2xl sm:text-3xl font-bold text-ink tabular-nums">4</span>
        <span class="text-xs text-slate font-medium">African countries deployed</span>
      </div>
    </div>
  </div>
</section>
