---
import Scene3D from './Scene3D.astro';
import { site } from '../lib/site';
import { withBase } from '../lib/url';

const proofChips = [
  '⚡ SELF-TRAINED DEV',
  'The Nurse Who Codes',
  'Open Source & Automations',
  'M.Tech Data Science (COLTECH UBa)',
  'BSc Nursing Science (Top-up)',
  'HND Nursing (Honors)',
  'Lead Architect @ LifeDrop',
  'Lead Engineer @ CoastClear',
  'CEO @ INKWAVE',
  'Speaker @ PyCon Cameroon 2026',
];
---

<section class="hero-fullscreen w-full min-h-[calc(100vh-4.5rem)] flex flex-col justify-between px-4 sm:px-8 md:px-12 lg:px-16 xl:px-20 2xl:px-24 pt-4 pb-8 sm:pt-6 sm:pb-10 overflow-x-hidden">
  <!-- Top: Status and Persona -->
  <div class="w-full flex flex-wrap items-center justify-between gap-3 mb-2 sm:mb-4">
    <!-- Live Positioning Radar & Engineering Identity -->
    <div class="hero-line" style="--i:0">
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/25 shadow-xs">
        <span class="relative flex h-2 w-2 shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <!-- ECG pulse icon for The Nurse Who Codes -->
        <svg class="w-4 h-3 text-emerald-500 stroke-current fill-none stroke-[2] shrink-0" viewBox="0 0 24 14" aria-hidden="true">
          <path d="M1 7h4l2-5 3 10 3-8 2 5 2-2h7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="truncate font-mono text-[11px] tracking-wide uppercase">The Nurse Who Codes • Self-Trained Dev • Open Source &amp; Automations</span>
      </div>
    </div>

    <!-- Non-limiting global professional status -->
    <p class="hero-line eyebrow flex items-center gap-2 text-xs sm:text-sm text-slate" style="--i:0">
      <span class="relative flex h-2 w-2 shrink-0">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-70"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
      </span>
      <span>{site.name} &mdash; Software Architect &amp; Health-Tech Innovator</span>
    </p>
  </div>

  <!-- Giant Headline & Central Interactive Feature -->
  <h1 class="w-full my-auto flex flex-col justify-center">
    <span class="hero-line hero-giant-text block w-full text-ink tracking-tight select-none" style="--i:1">
      The Nurse
    </span>

    <!-- The middle band: stretches edge-to-edge between the two massive typography words -->
    <div
      class="hero-line my-3 sm:my-5 md:my-6 flex flex-col normal-case md:flex-row md:items-center justify-between gap-6 md:gap-10 lg:gap-14 w-full"
      style="--i:2"
    >
      <div class="w-40 sm:w-52 md:w-64 lg:w-72 xl:w-80 shrink-0 mx-auto md:mx-0">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-line/60 bg-paper-dim/40 transition-transform hover:scale-[1.02] duration-300">
          <Scene3D src="/scenes/scene-hero.mp4" rounded={false} label="Animated 3D illustration" />
        </div>
      </div>

      <div class="flex-1 max-w-3xl flex flex-col items-start gap-4 sm:gap-6">
        <p class="text-base sm:text-lg md:text-xl lg:text-2xl text-slate leading-relaxed font-sans font-normal">
          <strong class="text-ink font-semibold">The Nurse Who Codes.</strong> Self-trained software engineer, registered nurse, and health-tech innovator. Autodidactic engineering focused on open-source technologies, workflow automations, and resilient offline-first platforms.
        </p>

        <div class="flex flex-wrap items-center gap-3 sm:gap-4 pt-1">
          <a href={withBase('/work')} class="btn btn-accent btn-md px-6 py-3 text-sm sm:text-base font-semibold shadow-lg shadow-accent/25 hover:shadow-accent/40 transition-all">
            See the work
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a href={withBase('/about')} class="btn btn-ghost btn-md px-6 py-3 text-sm sm:text-base font-medium">
            About &amp; Story
          </a>
          <a href={withBase('/cv')} class="btn btn-ghost btn-md px-4 py-3 text-xs sm:text-sm text-slate hover:text-ink">
            View CV
          </a>
        </div>
      </div>
    </div>

    <span class="hero-line hero-giant-text block w-full text-accent tracking-tight select-none" style="--i:3">
      Who Codes
    </span>
  </h1>

  <!-- Proof chips / credential badges -->
  <div class="hero-line mt-4 sm:mt-6 flex flex-wrap gap-2 sm:gap-2.5 items-center w-full" style="--i:4" aria-label="Credentials">
    {
      proofChips.map((chip) => (
        <span class="inline-flex items-center gap-1.5 rounded-full border border-line bg-paper-dim/90 px-3 py-1.5 text-xs font-semibold text-slate hover:text-ink hover:border-accent/40 transition-all cursor-default">
          <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
          {chip}
        </span>
      ))
    }
  </div>

  <!-- Bottom: Scroll prompt & verified impact badge -->
  <div class="hero-line mt-4 pt-3 border-t border-line/40 hidden sm:flex items-center justify-between text-xs text-slate" style="--i:5">
    <div class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-slate">
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>8,500+ Accumulated Reach &bull; 5,000+ Lives Reached &bull; 4 Countries</span>
    </div>
    <div class="flex items-center gap-1.5 text-[11px] font-mono uppercase tracking-wider text-slate hover:text-accent transition-colors">
      <span>Scroll to explore</span>
      <svg class="w-3.5 h-3.5 animate-bounce text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </div>
</section>

<style>
  .hero-giant-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.6rem, 15.5vw, 14.5rem);
    line-height: 0.84;
    text-transform: uppercase;
    letter-spacing: -0.015em;
    width: 100%;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero-line {
      opacity: 0;
      animation: hero-rise 0.75s var(--ease-out-soft) forwards;
      animation-delay: calc(var(--i) * 110ms + 60ms);
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
