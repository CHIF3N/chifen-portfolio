---
import Scene3D from './Scene3D.astro';
import { site } from '../lib/site';
import { withBase } from '../lib/url';

const proofChips = [
  'Speaker @ PyCon & UbuCon Cameroon 2026',
  'District Data Manager · PMTCT Head, Kumba South',
  'Founder @ LifeDrop · WhatsApp Blood Donor Network',
  'Founder @ CoastClear',
  'Technical Writer · Tech Chantier · The African Wave',
];
---

<section class="shell pt-10 pb-16 sm:pt-16 sm:pb-24">
  <p class="hero-line eyebrow flex items-center gap-2.5" style="--i:0">
    <span class="relative flex h-2 w-2">
      <span
        class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-70"
      ></span>
      <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
    </span>
    Chifen Sama Nduma &mdash; {site.location}
  </p>

  <h1 class="mt-6">
    <span class="hero-line display-hero block" style="--i:1">Resilient</span>

    <!-- The middle band sits between the two hero words: portrait on the left,
         the pitch and call to action on the right. -->
    <span
      class="hero-line my-4 flex flex-col gap-6 normal-case sm:my-6 md:flex-row md:items-end"
      style="--i:2"
    >
      <!-- Sits between the two hero words, square-cornered, same as the reference. -->
      <span class="block w-44 shrink-0 sm:w-56">
        <Scene3D src="/scenes/scene-hero.mp4" rounded={false} label="Animated 3D illustration" />
      </span>

      <span class="flex flex-col items-start gap-6">
        <span class="lede block max-w-md">
          {site.headline} Nurse-trained. Built for the ward, the power cut, and the 2G
          connection.
        </span>
        <a href={withBase('/work')} class="btn btn-accent">
          See the work
          <span aria-hidden="true">&rarr;</span>
        </a>
      </span>
    </span>

    <span class="hero-line display-hero block" style="--i:3">Health Tech</span>
  </h1>

  <!-- Proof chips / credential badges -->
  <div class="hero-line mt-8 flex flex-wrap gap-2" style="--i:4" aria-label="Credentials">
    {
      proofChips.map((chip) => (
        <span class="inline-flex items-center gap-1.5 rounded-full border border-accent/40 bg-accent/8 px-3 py-1.5 text-xs font-semibold text-accent">
          <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
          {chip}
        </span>
      ))
    }
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero-line {
      opacity: 0;
      animation: hero-rise 0.75s var(--ease-out-soft) forwards;
      animation-delay: calc(var(--i) * 110ms + 60ms);
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
