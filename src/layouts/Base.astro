---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Doodles from '../components/Doodles.astro';
import Mascot from '../components/Mascot.astro';
import { site } from '../lib/site';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Per-page accent. Defaults to the site cobalt. */
  accent?: string;
  /** Extra JSON-LD for this page (a project, an article, the study). */
  schema?: Record<string, any> | Array<Record<string, any>>;
  /** Marks the page as a profile page in structured data (home, about). */
  profile?: boolean;
  /** Keep the page out of search engines (admin tools). */
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = '/og/default.png',
  accent,
  schema,
  profile = false,
  noindex = false,
} = Astro.props;

const pageTitle = title
  ? `${title} · Chifen Sama (CHIF3N)`
  : `Chifen Sama Nduma (CHIF3N) · The Nurse Who Codes`;

const pageDescription =
  description ||
  'Chifen Sama Nduma (CHIF3N), The Nurse Who Codes: a registered nurse and software engineer in Cameroon building health technology, WhatsApp services and research for low-bandwidth settings.';

const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://chifen.is-a.dev';
const canonical = new URL(Astro.url.pathname, siteOrigin);
const ogUrl = new URL(withBase(ogImage), siteOrigin).toString();

/* Only facts that are documented elsewhere on the site go in here. Headline
   reach figures that are not traceable to a source are deliberately left out. */
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteOrigin}/#person`,
  name: 'Chifen Sama Nduma',
  givenName: 'Chifen',
  familyName: 'Sama Nduma',
  alternateName: ['Chifen Sama', 'CHIF3N', 'Sama Chifen', 'The Nurse Who Codes'],
  jobTitle: 'Registered nurse and software engineer',
  description:
    'Registered nurse (BSc Nursing Science) and self-taught software engineer in Cameroon, building health technology for low-bandwidth, low-resource settings.',
  url: `${siteOrigin}/`,
  image: new URL(withBase('/photos/chifen-portrait.jpg'), siteOrigin).toString(),
  homeLocation: { '@type': 'Place', name: 'Buea, Cameroon' },
  sameAs: [...site.socials.map((s) => s.href), 'https://inkwave-cm.vercel.app/'],
  knowsAbout: [
    'Nursing',
    'Health technology',
    'Digital health',
    'Artificial intelligence in clinical decision-making',
    'WhatsApp Cloud API',
    'Offline-first mobile apps',
    'Health data systems (DHIS2)',
    'Data science',
  ],
  award: [
    'Winner, Silicon Mountain Challenge 2022 (Ayodah)',
    '3rd place, MTN YaMo Pitch Season 4 (LifeDrop)',
    'Best Overall HND Student, Gracious Higher Institute of Excellence',
  ],
  alumniOf: [
    {
      '@type': 'EducationalOrganization',
      name: 'Gracious Higher Institute of Excellence',
      address: 'Buea, Cameroon',
    },
  ],
  affiliation: [
    {
      '@type': 'EducationalOrganization',
      name: 'College of Technology (COLTECH), The University of Bamenda',
    },
    { '@type': 'Organization', name: 'INKWAVE', url: 'https://inkwave-cm.vercel.app/' },
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteOrigin}/#website`,
  url: `${siteOrigin}/`,
  name: 'CHIF3N · Chifen Sama Nduma',
  alternateName: ['The Nurse Who Codes', 'Chifen Sama'],
  inLanguage: 'en',
  publisher: { '@id': `${siteOrigin}/#person` },
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteOrigin}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const profileSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: canonical.toString(),
  name: pageTitle,
  mainEntity: { '@id': `${siteOrigin}/#person` },
};

/* Which margin doodles this page gets. Admin tools get none. */
const path = Astro.url.pathname;
const doodleSet = noindex && !title?.includes('Missing')
  ? null
  : path === '/' ? 'home'
  : path.startsWith('/work') || path.startsWith('/experiments') ? 'work'
  : path.startsWith('/blog') ? 'blog'
  : path.startsWith('/about') || path.startsWith('/journey') ? 'about'
  : 'default';

const extra = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const schemas = noindex ? [] : [personSchema, websiteSchema, ...(profile ? [profileSchema] : []), ...extra];
---

<!doctype html>
<!--
  The accent is set on <html> rather than <body>: `@theme inline` resolves
  --color-accent against :root, so an override further down the tree would be
  ignored and every child would inherit the already-computed default.
-->
<html lang="en" style={accent ? `--accent:${accent}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Chifen Sama Nduma" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#f5f0e7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171513" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.displayName}, ${site.brand}`} href={withBase('/rss.xml')} />

    <meta property="og:type" content={profile ? 'profile' : 'website'} />
    <meta property="og:site_name" content="CHIF3N · Chifen Sama Nduma" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CHIF3N, The Nurse Who Codes. Chifen Sama Nduma's portfolio." />
    {profile && <meta property="profile:first_name" content="Chifen" />}
    {profile && <meta property="profile:last_name" content="Sama Nduma" />}
    {profile && <meta property="profile:username" content="CHIF3N" />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@sama_chifen" />
    <meta name="twitter:creator" content="@sama_chifen" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogUrl} />

    {schemas.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(schemas).replace(/</g, '\\u003c')} />
    )}

    <link rel="preload" href={withBase('/fonts/clash-display-600.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={withBase('/fonts/general-sans-500.woff2')} as="font" type="font/woff2" crossorigin />

    <script is:inline>
      document.documentElement.classList.add('js');
      // Runs before first paint so a stored dark choice never flashes light.
      try {
        var stored = localStorage.getItem('theme');
        var isDark = stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
        document.documentElement.classList.toggle('dark', isDark);
      } catch (e) {}
      // Print is always the light theme, so dark-only classes never reach paper.
      (function () {
        var root = document.documentElement, saved = null;
        addEventListener('beforeprint', function () {
          saved = root.dataset.theme || null;
          root.dataset.theme = 'light';
          root.classList.remove('dark');
        });
        addEventListener('afterprint', function () {
          if (saved) root.dataset.theme = saved;
          root.classList.toggle('dark', saved === 'dark');
        });
        if (matchMedia('print').matches) { root.dataset.theme = 'light'; root.classList.remove('dark'); }
      })();
    </script>
  </head>

  <body class="min-h-screen">
    <div id="scroll-progress" aria-hidden="true"></div>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:text-paper"
    >
      Skip to content
    </a>

    <div data-pagefind-ignore>
      <Header />
    </div>
    <main id="main" class="relative" data-pagefind-body data-pagefind-meta={`title:${title ?? site.displayName}`}>
      {doodleSet && <Doodles set={doodleSet as any} />}
      <slot />
    </main>
    <div data-pagefind-ignore>
      <Footer />
      <CommandPalette />
      {!noindex && <Mascot />}
    </div>

    <script>
      // Scroll reveals: a sheet set down on the desk as it enters the viewport.
      const items = document.querySelectorAll('[data-reveal]');
      if (items.length && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.08 }
        );
        items.forEach((item) => observer.observe(item));
      } else {
        items.forEach((item) => item.classList.add('is-visible'));
      }

      // Reading progress along the top edge. One passive listener, one rAF.
      const bar = document.getElementById('scroll-progress');
      if (bar) {
        let queued = false;
        const update = () => {
          queued = false;
          const max = document.documentElement.scrollHeight - innerHeight;
          bar.style.width = max > 0 ? `${Math.min(100, (scrollY / max) * 100)}%` : '0%';
        };
        addEventListener(
          'scroll',
          () => {
            if (!queued) {
              queued = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true }
        );
        update();
      }
    </script>
    <script src={withBase('/scripts/site-bridge.js')} is:inline></script>
    {
      /* Vercel Web Analytics: cookieless page views, only on the Vercel deployment
         (the script path does not exist on GitHub Pages or in dev). Admin is excluded. */
      import.meta.env.PROD && !noindex && (
        <script is:inline>
          if (!/github\.io$|localhost|127\.0\.0\.1/.test(location.hostname)) {
            window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
            var va = document.createElement('script');
            va.defer = true;
            va.src = '/_vercel/insights/script.js';
            document.head.appendChild(va);
          }
        </script>
      )
    }
  </body>
</html>
