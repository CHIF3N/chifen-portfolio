---
/**
 * BlogPost.astro
 * ──────────────────────────────────────────────────────────────────────────────
 * Full reading layout for blog post detail pages.
 * Wraps Base.astro and adds:
 *   - Fixed reading-progress bar
 *   - Breadcrumb navigation (Home › Writing › Post Title)
 *   - Publication date + read-time badge + category tag pills
 *   - Centred max-w-3xl (--blog-container-max) prose area
 *   - Footer tag row matching the site's badge style
 *
 * All design tokens reference --blog-* from blog-tokens.css.
 * Import blog-tokens.css here so every post gets them automatically.
 */

import Base from './Base.astro';
import '../styles/blog-tokens.css';
import { withBase } from '../lib/url';
import BlogEngagement from '../components/blog/BlogEngagement.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updated?: Date;
  tags?: string[];
  readMinutes?: number;
  /** Blog post slug, used by BlogEngagement for Firestore keying. */
  postId?: string;
  /** Public-folder path written by Sveltia CMS, e.g. /images/blog/cover.jpg */
  cover?: string | null;
}

const { title, description, pubDate, updated, tags = [], readMinutes = 1, cover, postId = '' } = Astro.props;


const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Base title={title} description={description}>
  <!-- ── Reading progress bar ── -->
  <div class="blog-progress" id="reading-progress" aria-hidden="true"></div>

  <article class="blog-post-page">
    <!-- ── Breadcrumb ── -->
    <nav class="blog-post-page__breadcrumb" aria-label="Breadcrumb">
      <ol class="blog-breadcrumbs">
        <li>
          <a href={withBase('/')} class="blog-breadcrumbs__link">Home</a>
        </li>
        <li aria-hidden="true" class="blog-breadcrumbs__sep">/</li>
        <li>
          <a href={withBase('/blog')} class="blog-breadcrumbs__link">Writing</a>
        </li>
        <li aria-hidden="true" class="blog-breadcrumbs__sep">/</li>
        <li class="blog-breadcrumbs__current" aria-current="page">{title}</li>
      </ol>
    </nav>

    <!-- ── Post header ── -->
    <header class="blog-post-page__header">
      <!-- Meta row: date · read time -->
      <div class="blog-post-page__meta">
        <time
          datetime={pubDate.toISOString()}
          class="blog-meta"
        >
          {dateFormat.format(pubDate)}
        </time>
        <span class="blog-meta" aria-hidden="true">·</span>
        <span class="blog-meta">{readMinutes} min read</span>

        {updated && (
          <>
            <span class="blog-meta" aria-hidden="true">·</span>
            <span class="blog-meta">
              Updated {dateFormat.format(updated)}
            </span>
          </>
        )}
      </div>

      <!-- Tag pills -->
      {tags.length > 0 && (
        <ul class="blog-post-page__tags" aria-label="Categories">
          {tags.map((tag) => (
            <li>
              <a
                href={withBase(`/blog?tag=${encodeURIComponent(tag)}`)}
                class="blog-tag"
              >
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )}

      <!-- Title & description -->
      <h1 class="blog-post-title">{title}</h1>
      <p class="blog-lede">{description}</p>
    </header>

    <!-- ── Cover image (optional) ── -->
    {cover && (
      <img
        src={cover}
        alt={title}
        class="w-full rounded-xl object-cover mb-8 max-h-[420px]"
        loading="lazy"
        decoding="async"
      />
    )}

    <!-- ── Prose body ── -->
    <div class="blog-post-page__body prose prose-zinc dark:prose-invert max-w-none dark:prose-code:text-zinc-200 dark:prose-code:bg-zinc-800 prose-body">
      <slot />
    </div>

    <!-- ── Footer tag row ── -->
    {tags.length > 0 && (
      <footer class="blog-post-page__footer">
        <ul class="blog-post-page__tags" aria-label="Tags">
          {tags.map((tag) => (
            <li>
              <a href={withBase(`/blog?tag=${encodeURIComponent(tag)}`)} class="blog-tag">
                {tag}
              </a>
            </li>
          ))}
        </ul>
      </footer>
    )}

    <!-- ── Back link ── -->
    <div class="blog-post-page__back">
      <a href={withBase('/blog')} class="blog-back">
        <span class="blog-back-arrow" aria-hidden="true">←</span>
        All writing
      </a>
    </div>

    <!-- ── Engagement: likes + comments ── -->
    {postId && <BlogEngagement postId={postId} />}
  </article>
</Base>

<style>
  /* Import blog tokens — already done via Astro import above, but the @layer
     below adds layout rules that reference those tokens. */

  .blog-post-page {
    width: 100%;
    max-width: var(--blog-container-max, 48rem);
    margin-inline: auto;
    padding-inline: var(--blog-container-px, 1.25rem);
    padding-top: clamp(3rem, 7vw, 5rem);
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }

  @media (min-width: 640px) {
    .blog-post-page {
      padding-inline: var(--blog-container-px-sm, 2rem);
    }
  }

  /* ── Breadcrumb ── */
  .blog-post-page__breadcrumb {
    margin-bottom: 2rem;
  }

  .blog-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .blog-breadcrumbs__link {
    font-family: var(--blog-font-body);
    font-size: var(--blog-meta-size, 0.875rem);
    font-weight: 500;
    color: var(--blog-text-muted);
    text-decoration: none;
    transition: color 0.18s ease;
  }
  .blog-breadcrumbs__link:hover {
    color: var(--blog-accent);
  }

  .blog-breadcrumbs__sep {
    font-size: var(--blog-meta-size, 0.875rem);
    color: var(--blog-text-faint);
  }

  .blog-breadcrumbs__current {
    font-family: var(--blog-font-body);
    font-size: var(--blog-meta-size, 0.875rem);
    font-weight: 500;
    color: var(--blog-text-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 22ch;
  }

  /* ── Header ── */
  .blog-post-page__header {
    border-bottom: 1px solid var(--blog-border, var(--color-line));
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
  }

  .blog-post-page__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
  }

  /* ── Tags row ── */
  .blog-post-page__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
    margin-bottom: 1.2rem;
  }
  .blog-post-page__tags a {
    text-decoration: none;
  }

  /* ── Title + lede ── */
  .blog-post-title {
    margin-bottom: 0.75rem;
  }

  /* ── Body ── */
  .blog-post-page__body {
    /* prose-body styles come from global.css */
  }

  /* ── Footer ── */
  .blog-post-page__footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--blog-border, var(--color-line));
  }

  /* ── Back link ── */
  .blog-post-page__back {
    margin-top: 2rem;
  }

  /* ── Enhanced Code Blocks across all blog posts ── */
  :global(.enhanced-code-block) {
    margin-block: 2rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: #0d1117;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    font-family: var(--blog-font-mono);
  }

  :global(.ecb-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.85rem;
    background: #161b22;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    user-select: none;
    gap: 0.75rem;
  }

  :global(.ecb-left) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  :global(.ecb-dots) {
    display: flex;
    gap: 5px;
    align-items: center;
  }

  :global(.ecb-dot) {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  :global(.ecb-dot--red)    { background: #ff5f56; }
  :global(.ecb-dot--yellow) { background: #ffbd2e; }
  :global(.ecb-dot--green)  { background: #27c93f; }

  :global(.ecb-lang) {
    font-size: 0.68rem;
    font-weight: 700;
    color: #7d8590;
    letter-spacing: 0.05em;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.12rem 0.45rem;
    border-radius: 4px;
  }

  :global(.ecb-actions) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  :global(.ecb-btn) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.6rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
    color: #c9d1d9;
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  :global(.ecb-btn:hover) {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }
  :global(.ecb-btn--download) {
    color: #93c5fd;
    border-color: rgba(56, 189, 248, 0.25);
    background: rgba(56, 189, 248, 0.06);
  }
  :global(.ecb-btn--download:hover) {
    background: rgba(56, 189, 248, 0.15);
    color: #e0f2fe;
  }
  :global(.ecb-btn--ok) {
    color: #3fb950 !important;
    border-color: rgba(63, 185, 80, 0.4) !important;
    background: rgba(63, 185, 80, 0.12) !important;
  }

  :global(.enhanced-code-block pre) {
    margin: 0 !important;
    padding: 1.1rem 1.25rem !important;
    overflow-x: auto !important;
    border-radius: 0 !important;
    background: transparent !important;
    border: none !important;
    font-size: 0.8125rem !important;
    line-height: 1.65 !important;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
  }
</style>

<script>
  // Reading progress bar
  const bar = document.getElementById('reading-progress');
  const article = document.querySelector('.blog-post-page__body');

  if (bar && article) {
    const update = () => {
      const { top, bottom } = article.getBoundingClientRect();
      const viewH = window.innerHeight;
      const total = bottom - top;
      const scrolled = Math.max(0, viewH - top);
      const pct = Math.min(100, Math.max(0, (scrolled / total) * 100));
      bar.style.width = pct + '%';
    };

    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  // Interactive Code Block Enhancer: adds clickable copy, download, and header bar to all blog code blocks
  (function enhanceBlogCodeBlocks() {
    const body = document.querySelector('.blog-post-page__body');
    if (!body) return;

    const preElements = body.querySelectorAll('pre');
    preElements.forEach((pre) => {
      // Skip if already enhanced or inside CodeWorkbench
      if (pre.closest('.cwb') || pre.closest('.enhanced-code-block')) return;

      const codeEl = pre.querySelector('code');
      const rawCode = (codeEl ? codeEl.innerText : pre.innerText).trimEnd();
      if (!rawCode) return;

      // Detect language
      let lang = 'CODE';
      let ext = 'txt';
      const classes = `${pre.className} ${codeEl?.className ?? ''}`.toLowerCase();
      if (classes.includes('typescript') || classes.includes('ts')) { lang = 'TYPESCRIPT'; ext = 'ts'; }
      else if (classes.includes('javascript') || classes.includes('js')) { lang = 'JAVASCRIPT'; ext = 'js'; }
      else if (classes.includes('python') || classes.includes('py')) { lang = 'PYTHON'; ext = 'py'; }
      else if (classes.includes('json')) { lang = 'JSON'; ext = 'json'; }
      else if (classes.includes('bash') || classes.includes('sh') || classes.includes('shell')) { lang = 'BASH'; ext = 'sh'; }
      else if (classes.includes('sql') || classes.includes('postgresql')) { lang = 'SQL'; ext = 'sql'; }
      else if (classes.includes('nginx')) { lang = 'NGINX'; ext = 'conf'; }
      else if (classes.includes('dockerfile') || classes.includes('docker')) { lang = 'DOCKER'; ext = 'dockerfile'; }
      else if (classes.includes('yaml') || classes.includes('yml')) { lang = 'YAML'; ext = 'yml'; }
      else if (classes.includes('html')) { lang = 'HTML'; ext = 'html'; }
      else if (classes.includes('css')) { lang = 'CSS'; ext = 'css'; }

      // Wrapper
      const wrapper = document.createElement('div');
      wrapper.className = 'enhanced-code-block';

      // Header
      const header = document.createElement('div');
      header.className = 'ecb-header';
      header.innerHTML = `
        <div class="ecb-left">
          <div class="ecb-dots" aria-hidden="true">
            <span class="ecb-dot ecb-dot--red"></span>
            <span class="ecb-dot ecb-dot--yellow"></span>
            <span class="ecb-dot ecb-dot--green"></span>
          </div>
          <span class="ecb-lang">${lang}</span>
        </div>
        <div class="ecb-actions">
          <button type="button" class="ecb-btn ecb-btn--copy" aria-label="Copy code">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span class="ecb-copy-label">Copy</span>
          </button>
          <button type="button" class="ecb-btn ecb-btn--download" aria-label="Download code snippet">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span class="ecb-dl-label">Download</span>
          </button>
        </div>
      `;

      // Copy logic
      const copyBtn = header.querySelector<HTMLButtonElement>('.ecb-btn--copy');
      const copyLabel = header.querySelector<HTMLElement>('.ecb-copy-label');
      copyBtn?.addEventListener('click', () => {
        navigator.clipboard?.writeText(rawCode).then(() => {
          if (copyLabel) copyLabel.textContent = 'Copied!';
          copyBtn.classList.add('ecb-btn--ok');
          setTimeout(() => {
            if (copyLabel) copyLabel.textContent = 'Copy';
            copyBtn.classList.remove('ecb-btn--ok');
          }, 2000);
        });
      });

      // Download logic
      const dlBtn = header.querySelector<HTMLButtonElement>('.ecb-btn--download');
      const dlLabel = header.querySelector<HTMLElement>('.ecb-dl-label');
      dlBtn?.addEventListener('click', () => {
        const blob = new Blob([rawCode], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `code-snippet.${ext}`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);

        if (dlLabel) dlLabel.textContent = 'Saved!';
        dlBtn.classList.add('ecb-btn--ok');
        setTimeout(() => {
          if (dlLabel) dlLabel.textContent = 'Download';
          dlBtn.classList.remove('ecb-btn--ok');
        }, 2000);
      });

      // Insert wrapper into DOM
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(header);
      wrapper.appendChild(pre);
    });
  })();
</script>
