---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/url';

const dissertations = (await getCollection('research')).sort((a, b) => b.data.year - a.data.year);

const workStatusLabel: Record<string, string> = {
  live: 'Live',
  shipped: 'Shipped',
  'in-progress': 'Ongoing',
  concept: 'Concept',
};

const studies = (await getCollection('work'))
  .filter((entry) => entry.data.tags.includes('research') && !entry.data.researchSlug)
  .sort((a, b) => a.data.order - b.data.order);

const dateFormat = new Intl.DateTimeFormat('en-GB', { year: 'numeric' });
---

<Base
  title="Research"
  description="Research and publications by Chifen Sama N.: the BSc dissertation on AI readiness at Buea Regional Hospital, plus other data and research work."
>
  <header class="border-b border-ink/10 bg-ink text-paper">
    <div class="mx-auto max-w-4xl px-5 pt-14 pb-16 sm:px-8 sm:pt-20">
      <h1 class="font-display text-4xl font-semibold sm:text-5xl">Research &amp; Publications</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-paper/70">
        Studies and data work, not just the one dissertation. Status is marked honestly: what is
        finished, what is ongoing, and what is a concept demo.
      </p>
    </div>
  </header>

  <section class="mx-auto max-w-4xl px-5 py-14 sm:px-8">
    <div class="grid gap-5">
      {
        dissertations.map((entry) => (
          <a
            href={withBase(`/research/${entry.id}`)}
            data-reveal
            class="group block rounded-2xl border border-ink/10 bg-white/60 p-7 transition-all duration-300 hover:-translate-y-1 hover:border-amber/50 hover:shadow-[0_16px_40px_-24px_rgba(10,42,51,0.5)] sm:p-9"
          >
            <div class="flex flex-wrap items-center gap-3">
              <span class="rounded-full bg-amber/15 px-2.5 py-1 text-xs font-medium text-ink">
                {entry.data.kind}
              </span>
              <span class="text-xs text-slate-light">{dateFormat.format(new Date(entry.data.year, 0))}</span>
            </div>
            <h2 class="mt-4 font-display text-2xl font-semibold sm:text-3xl">{entry.data.title}</h2>
            <p class="mt-3 leading-relaxed text-slate">{entry.data.summary}</p>
            <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-amber">
              Read the study
              <span class="transition-transform duration-200 group-hover:translate-x-0.5">&rarr;</span>
            </span>
          </a>
        ))
      }

      {
        studies.map((entry) => (
          <a
            href={withBase(`/work/${entry.id}`)}
            data-reveal
            class="group block rounded-2xl border border-ink/10 bg-white/60 p-7 transition-all duration-300 hover:-translate-y-1 hover:border-amber/50 hover:shadow-[0_16px_40px_-24px_rgba(10,42,51,0.5)] sm:p-9"
          >
            <div class="flex flex-wrap items-center gap-3">
              <span class="rounded-full bg-ink/5 px-2.5 py-1 text-xs font-medium text-slate">
                {workStatusLabel[entry.data.status]}
              </span>
              <span class="text-xs text-slate-light">{dateFormat.format(new Date(entry.data.year, 0))}</span>
            </div>
            <h2 class="mt-4 font-display text-2xl font-semibold sm:text-3xl">{entry.data.title}</h2>
            <p class="mt-3 leading-relaxed text-slate">{entry.data.summary}</p>
            <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-amber">
              Read the case study
              <span class="transition-transform duration-200 group-hover:translate-x-0.5">&rarr;</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</Base>
