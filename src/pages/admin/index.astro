---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import siteConfig from '../../data/siteConfig.json';
import { masterCvData } from '../../lib/masterCvData';
import { storyChapters, professionalBio } from '../../data/storyData';
import { impactMetrics } from '../../data/metrics';
import talksData from '../../data/talks.json';
import { archiveItems, archiveCategories } from '../../data/archiveData';
import { withBase } from '../../lib/url';

// Load all content collections
const workEntries = await getCollection('work');
const blogEntries = await getCollection('blog');
const researchEntries = await getCollection('research');

// Package initial data for client-side administration
const initialMasterData = {
  siteConfig,
  masterCvData,
  professionalBio,
  storyChapters,
  impactMetrics,
  talks: talksData,
  archiveItems,
  archiveCategories,
  projects: workEntries.map(e => ({
    id: e.id,
    slug: e.id.replace(/\.(md|mdx)$/, ''),
    title: e.data.title,
    summary: e.data.summary,
    role: e.data.role,
    tags: e.data.tags,
    status: e.data.status,
    year: e.data.year,
    liveUrl: e.data.liveUrl || '',
    repoUrl: e.data.repoUrl || '',
    featured: e.data.featured || false,
    metrics: e.data.metrics || [],
    order: e.data.order ?? 100,
    note: e.data.note || '',
    researchSlug: e.data.researchSlug || '',
    body: e.body || ''
  })),
  research: researchEntries.map(e => ({
    id: e.id,
    slug: e.id.replace(/\.(md|mdx)$/, ''),
    title: e.data.title,
    summary: e.data.summary,
    institution: e.data.institution,
    year: e.data.year,
    tags: e.data.tags,
    kind: e.data.kind,
    status: e.data.status,
    abstractUrl: e.data.abstractUrl || '',
    pdfUrl: e.data.pdfUrl || '',
    supervisor: e.data.supervisor || '',
    site: e.data.site || '',
    body: e.body || ''
  })),
  blogPosts: blogEntries.map(e => ({
    id: e.id,
    slug: e.id.replace(/\.(md|mdx)$/, ''),
    title: e.data.title,
    description: e.data.description,
    pubDate: e.data.pubDate ? new Date(e.data.pubDate).toISOString().slice(0, 10) : '',
    updated: e.data.updated ? new Date(e.data.updated).toISOString().slice(0, 10) : '',
    tags: e.data.tags || [],
    draft: Boolean(e.data.draft),
    cover: e.data.cover || '',
    body: e.body || ''
  })),
  mediaAssets: [
    {
      id: 'photo-portrait',
      name: 'chifen-portrait.jpg',
      title: 'Studio Portrait (Hero Persona)',
      category: 'hero',
      url: '/photos/chifen-portrait.jpg',
      aspect: '1:1',
      dimensions: '1536 × 1536',
      size: '107 KB',
      format: 'JPEG',
      usedIn: 'Homepage Hero Card & Base Meta',
      activeUsage: 'hero'
    },
    {
      id: 'photo-outdoor-1',
      name: 'chifen-outdoor-1.jpg',
      title: 'Outdoor Natural Portrait (The Nurse Who Codes)',
      category: 'hero',
      url: '/photos/chifen-outdoor-1.jpg',
      aspect: '3:4',
      dimensions: '1920 × 2560',
      size: '186 KB',
      format: 'JPEG',
      usedIn: 'Homepage Section 4 Story Card (2nd Image Down)',
      activeUsage: 'story'
    },
    {
