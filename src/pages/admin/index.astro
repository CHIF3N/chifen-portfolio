      // RENDER: PROJECTS
      function renderProjects(filterText = '') {
        const container = document.getElementById('projects-list-container');
        if (!container) return;
        const list = state.projects || [];
        const term = filterText.toLowerCase();
        const filtered = list.filter(p => 
          !term || 
          p.title?.toLowerCase().includes(term) || 
          p.summary?.toLowerCase().includes(term) || 
          p.tags?.some(t => t.toLowerCase().includes(term)) ||
          p.status?.toLowerCase().includes(term)
        );

        if (!filtered.length) {
          container.innerHTML = '<div class="col-span-full py-8 text-center text-xs text-zinc-500">No matching projects found. Click "+ Add New Project" to create one.</div>';
          return;
        }

        container.innerHTML = filtered.map((p, idx) => `
          <div
            draggable="true"
            data-proj-id="${escapeHtml(p.id)}"
            data-proj-idx="${idx}"
            class="project-card-item rounded-xl border border-zinc-800 bg-zinc-900/60 p-5 flex flex-col justify-between hover:border-zinc-700 transition-all select-none cursor-grab active:cursor-grabbing"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-2.5">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <span class="cursor-grab text-zinc-500 hover:text-white font-mono text-xs px-1 py-0.5 rounded bg-zinc-800" title="Drag to reorder projects">⠿ Move</span>
                  <span class="rounded bg-zinc-800 px-2 py-0.5 text-[10px] font-mono font-semibold uppercase text-zinc-300">
                    ${p.status}
                  </span>
                  ${p.domain === 'clinical' 
                    ? '<span class="rounded bg-emerald-950/80 text-emerald-300 border border-emerald-800 px-1.5 py-0.5 text-[9px] font-mono">🩺 Clinical</span>' 
                    : (p.domain === 'health-tech' || !p.domain)
                    ? '<span class="rounded bg-purple-950/80 text-purple-300 border border-purple-800 px-1.5 py-0.5 text-[9px] font-mono">🏥 Health Tech</span>' 
                    : '<span class="rounded bg-cyan-950/80 text-cyan-300 border border-cyan-800 px-1.5 py-0.5 text-[9px] font-mono">💻 Tech</span>'}
                </div>
                <span class="text-xs font-mono text-zinc-500">${p.year}</span>
              </div>
              ${p.cover ? `
                <div class="aspect-video w-full rounded-lg overflow-hidden bg-black mb-3 border border-zinc-800">
                  <img src="${escapeHtml(p.cover)}" alt="${escapeHtml(p.title)}" class="w-full h-full object-cover" />
                </div>
              ` : ''}
              <h4 class="text-base font-bold text-white">${escapeHtml(p.title)}</h4>
              <p class="mt-2 text-xs text-zinc-400 line-clamp-3 leading-relaxed">${escapeHtml(p.summary || '')}</p>
              <div class="mt-3 flex flex-wrap gap-1">
                ${(p.tags || []).slice(0, 4).map(t => `<span class="rounded bg-zinc-800/80 px-1.5 py-0.5 text-[10px] text-zinc-400">${escapeHtml(t)}</span>`).join('')}
              </div>
            </div>
            <div class="mt-5 pt-3 border-t border-zinc-800/80 flex items-center justify-between">
              <span class="text-[11px] font-mono text-zinc-500">${p.role || ''}</span>
              <div class="flex items-center gap-2">
                <button class="btn-edit-project text-xs font-semibold text-purple-400 hover:text-purple-300 px-2 py-1 rounded bg-purple-950/40 border border-purple-900/50" data-id="${p.id}">
                  Edit
                </button>
                <button class="btn-del-project text-xs text-red-400 hover:text-red-300 px-1.5 py-1" data-id="${p.id}" title="Delete project">
                  ✕
                </button>
              </div>
            </div>
          </div>
        `).join('');

        // Wire drag and drop reordering
        let draggedProjIdx = null;
        container.querySelectorAll('.project-card-item').forEach(card => {
          card.addEventListener('dragstart', (e) => {
            draggedProjIdx = parseInt(card.getAttribute('data-proj-idx'), 10);
            e.dataTransfer.setData('text/plain', card.getAttribute('data-proj-id'));
            e.dataTransfer.effectAllowed = 'move';
            card.classList.add('opacity-40', 'ring-2', 'ring-purple-500');
          });

          card.addEventListener('dragend', () => {
            card.classList.remove('opacity-40', 'ring-2', 'ring-purple-500');
            container.querySelectorAll('.project-card-item').forEach(c => {
              c.classList.remove('border-purple-500', 'bg-purple-950/20');
            });
          });

          card.addEventListener('dragover', (e) => {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            card.classList.add('border-purple-500', 'bg-purple-950/20');
          });

          card.addEventListener('dragleave', () => {
            card.classList.remove('border-purple-500', 'bg-purple-950/20');
          });

          card.addEventListener('drop', (e) => {
            e.preventDefault();
            card.classList.remove('border-purple-500', 'bg-purple-950/20');
            const targetIdx = parseInt(card.getAttribute('data-proj-idx'), 10);
            if (draggedProjIdx !== null && targetIdx !== null && draggedProjIdx !== targetIdx) {
              const movedItem = state.projects.splice(draggedProjIdx, 1)[0];
              state.projects.splice(targetIdx, 0, movedItem);
              // Update order values
              state.projects.forEach((item, i) => { item.order = i * 10; });
              persistState(`Reordered "${movedItem.title}" to position #${targetIdx + 1}`);
              showToast(`✓ Reordered projects! Order priority saved.`);
              renderProjects(activeProjectFilter);
            }
          });
        });

        container.querySelectorAll('.btn-edit-project').forEach(b => {
          b.addEventListener('click', () => openProjectModal(b.dataset.id));
        });
        container.querySelectorAll('.btn-del-project').forEach(b => {
          b.addEventListener('click', () => deleteProject(b.dataset.id));
        });
      }

      let activeProjectFilter = '';
      document.getElementById('search-projects')?.addEventListener('input', e => {
        activeProjectFilter = e.target.value;
        renderProjects(activeProjectFilter);
      });

