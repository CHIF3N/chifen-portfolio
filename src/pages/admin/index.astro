      function renderResearch() {
        const container = document.getElementById('research-list-container');
        if (!container) return;
        const list = state.research || [];

        container.innerHTML = list.map(r => `
          <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="rounded bg-cyan-950 px-2 py-0.5 text-[10px] font-semibold text-cyan-300 border border-cyan-800">${r.kind}</span>
                <span class="text-xs font-mono text-zinc-500">${r.year} · ${escapeHtml(r.institution)}</span>
              </div>
              <h4 class="text-sm font-bold text-white">${escapeHtml(r.title)}</h4>
              <p class="text-xs text-zinc-400 line-clamp-2">${escapeHtml(r.summary)}</p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <button class="btn-edit-research text-xs text-cyan-400 px-3 py-1.5 rounded-lg bg-cyan-950/40 border border-cyan-900/50" data-id="${r.id}">Edit</button>
              <button class="btn-del-research text-xs text-red-400 p-1.5" data-id="${r.id}">✕</button>
            </div>
          </div>
        `).join('');

        container.querySelectorAll('.btn-edit-research').forEach(b => {
          b.addEventListener('click', () => openResearchModal(b.dataset.id));
        });
        container.querySelectorAll('.btn-del-research').forEach(b => {
          b.addEventListener('click', () => deleteResearch(b.dataset.id));
        });
      }

      function openResearchModal(id = null) {
        const isNew = !id;
        const item = isNew ? {
          id: 'research-' + Date.now() + '.md',
          title: '',
          summary: '',
          institution: 'College of Technology (COLTECH), University of Bamenda',
          year: 2026,
          kind: 'Ongoing work',
          status: 'in-progress',
          tags: ['Data Science', 'AI', 'Healthcare'],
          body: ''
        } : (state.research.find(r => r.id === id) || {});

        const html = `
          <div class="space-y-4">
            <div>
              <label class="admin-label">Study / Dissertation Title</label>
              <input type="text" id="m-res-title" value="${escapeHtml(item.title || '')}" class="admin-input" required />
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="admin-label">Institution</label>
                <input type="text" id="m-res-inst" value="${escapeHtml(item.institution || '')}" class="admin-input" />
              </div>
              <div>
                <label class="admin-label">Year</label>
                <input type="number" id="m-res-year" value="${item.year || 2026}" class="admin-input" />
              </div>
              <div>
                <label class="admin-label">Publication Kind</label>
                <select id="m-res-kind" class="admin-input">
                  <option value="Dissertation" ${item.kind === 'Dissertation' ? 'selected' : ''}>Dissertation</option>
                  <option value="Published article" ${item.kind === 'Published article' ? 'selected' : ''}>Published article</option>
                  <option value="Ongoing work" ${item.kind === 'Ongoing work' ? 'selected' : ''}>Ongoing work</option>
                  <option value="Conference presentation" ${item.kind === 'Conference presentation' ? 'selected' : ''}>Conference presentation</option>
                </select>
              </div>
              <div>
                <label class="admin-label">Status</label>
                <select id="m-res-status" class="admin-input">
                  <option value="complete" ${item.status === 'complete' ? 'selected' : ''}>Complete</option>
                  <option value="in-progress" ${item.status === 'in-progress' ? 'selected' : ''}>In Progress</option>
                </select>
              </div>
            </div>
            <div>
              <label class="admin-label">Abstract / Summary</label>
              <textarea id="m-res-summary" rows="4" class="admin-input">${escapeHtml(item.summary || '')}</textarea>
            </div>
          </div>
        `;

        openModal(isNew ? 'Add Research Project' : 'Edit: ' + item.title, html, () => {
          const title = document.getElementById('m-res-title')?.value.trim();
          if (!title) return alert('Title required');
          const updated = {
            ...item,
            title,
            institution: document.getElementById('m-res-inst')?.value.trim(),
            year: Number(document.getElementById('m-res-year')?.value) || 2026,
            kind: document.getElementById('m-res-kind')?.value,
            status: document.getElementById('m-res-status')?.value,
            summary: document.getElementById('m-res-summary')?.value.trim(),
          };
          if (isNew) state.research.unshift(updated);
          else {
            const idx = state.research.findIndex(r => r.id === id);
            if (idx >= 0) state.research[idx] = updated;
          }
          persistState('Research record saved!');
          renderResearch();
          closeModal();
        }, !isNew ? () => deleteResearch(id) : null);
      }

      function deleteResearch(id) {
        if (!confirm('Are you sure you want to delete this research study?')) return;
        state.research = state.research.filter(r => r.id !== id);
        persistState('Research deleted.');
        renderResearch();
        closeModal();
      }

      document.getElementById('btn-add-research')?.addEventListener('click', () => openResearchModal(null));

      // RENDER: TALKS
      function renderTalks() {
        const container = document.getElementById('talks-list-container');
        if (!container) return;
        const list = state.talks || [];

        container.innerHTML = list.map(t => `
          <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-4 sm:p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
            <div>
              <div class="flex items-center gap-2">
                <span class="rounded bg-accent/20 px-2 py-0.5 text-[10px] font-semibold text-accent border border-accent/30">${escapeHtml(t.event)}</span>
                <span class="text-xs font-mono text-zinc-500">${t.date} · ${t.location}</span>
              </div>
              <h4 class="text-sm font-bold text-white mt-1">${escapeHtml(t.title)}</h4>
              <p class="text-xs text-zinc-400 line-clamp-1">${escapeHtml(t.abstract || '')}</p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <button class="btn-edit-talk text-xs text-purple-400 px-2.5 py-1 rounded bg-zinc-800 border border-zinc-700" data-id="${t.id}">Edit</button>
              <button class="btn-del-talk text-xs text-red-400 p-1" data-id="${t.id}">✕</button>
            </div>
          </div>
        `).join('');

        container.querySelectorAll('.btn-edit-talk').forEach(b => {
          b.addEventListener('click', () => openTalkModal(b.dataset.id));
        });
        container.querySelectorAll('.btn-del-talk').forEach(b => {
          b.addEventListener('click', () => deleteTalk(b.dataset.id));
        });
      }

      function openTalkModal(id = null) {
        const isNew = !id;
        const item = isNew ? {
          id: 'talk-' + Date.now(),
          title: '',
          event: '',
          location: 'Yaoundé, Cameroon',
          date: '2026',
          abstract: '',
          embedUrl: '',
          deckUrl: '',
          videoUrl: '',
          tags: []
        } : (state.talks.find(t => t.id === id) || {});

        const html = `
          <div class="space-y-4">
            <div>
              <label class="admin-label">Talk / Keynote Title</label>
              <input type="text" id="m-talk-title" value="${escapeHtml(item.title || '')}" class="admin-input" required />
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="admin-label">Conference / Event</label>
                <input type="text" id="m-talk-event" value="${escapeHtml(item.event || '')}" class="admin-input" />
              </div>
              <div>
                <label class="admin-label">Date</label>
                <input type="text" id="m-talk-date" value="${escapeHtml(item.date || '')}" class="admin-input" />
              </div>
              <div>
                <label class="admin-label">Location</label>
                <input type="text" id="m-talk-location" value="${escapeHtml(item.location || '')}" class="admin-input" />
              </div>
              <div>
                <label class="admin-label">Slides / Deck URL</label>
                <input type="url" id="m-talk-deck" value="${escapeHtml(item.deckUrl || '')}" class="admin-input text-xs font-mono" />
              </div>
            </div>
            <div>
              <label class="admin-label">Abstract / System Description</label>
              <textarea id="m-talk-abstract" rows="3" class="admin-input">${escapeHtml(item.abstract || '')}</textarea>
            </div>
          </div>
        `;

        openModal(isNew ? 'Add Speaking Event' : 'Edit Talk', html, () => {
          const title = document.getElementById('m-talk-title')?.value.trim();
          if (!title) return alert('Title required');
          const updated = {
            ...item,
            title,
            event: document.getElementById('m-talk-event')?.value.trim(),
            date: document.getElementById('m-talk-date')?.value.trim(),
            location: document.getElementById('m-talk-location')?.value.trim(),
            deckUrl: document.getElementById('m-talk-deck')?.value.trim(),
            abstract: document.getElementById('m-talk-abstract')?.value.trim()
          };
          if (isNew) state.talks.unshift(updated);
          else {
            const idx = state.talks.findIndex(t => t.id === id);
            if (idx >= 0) state.talks[idx] = updated;
          }
          persistState('Talk updated!');
          renderTalks();
          closeModal();
        }, !isNew ? () => deleteTalk(id) : null);
      }

      function deleteTalk(id) {
        if (!confirm('Are you sure you want to delete this talk?')) return;
        state.talks = state.talks.filter(t => t.id !== id);
        persistState('Talk deleted.');
        renderTalks();
        closeModal();
      }

      document.getElementById('btn-add-talk')?.addEventListener('click', () => openTalkModal(null));

      // RENDER: STORY TIMELINE
      function renderStory() {
        const container = document.getElementById('story-list-container');
        if (!container) return;
        const list = state.storyChapters || [];

        container.innerHTML = list.map((c, i) => `
          <div class="rounded-xl border border-zinc-800 bg-zinc-900/40 p-4 flex items-start justify-between gap-3">
            <div class="space-y-0.5">
              <div class="flex items-center gap-2">
                <span class="text-xs font-mono font-bold text-accent">Chapter ${c.number || (i + 1)}</span>
                <span class="text-xs text-zinc-500">· ${c.year}</span>
              </div>
              <h4 class="text-sm font-bold text-white">${escapeHtml(c.title)}</h4>
              <p class="text-xs text-zinc-400 line-clamp-1">${escapeHtml(c.headline || '')}</p>
            </div>
            <button class="btn-edit-chapter text-xs text-purple-400 px-2.5 py-1 rounded bg-zinc-800 border border-zinc-700 shrink-0" data-index="${i}">Edit</button>
          </div>
        `).join('');

        container.querySelectorAll('.btn-edit-chapter').forEach(b => {
          b.addEventListener('click', () => openChapterModal(Number(b.dataset.index)));
        });
      }

      function openChapterModal(index) {
        const isNew = index === -1;
        const item = isNew ? {
          id: 'chapter-' + Date.now(),
          number: String((state.storyChapters.length || 0) + 1),
          year: '2026',
          title: '',
          headline: '',
          era: 'active',
          paragraphs: [],
          pullQuote: ''
        } : state.storyChapters[index];

        const html = `
          <div class="space-y-4">
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="admin-label">Chapter Number</label>
                <input type="text" id="m-chap-num" value="${escapeHtml(item.number || '')}" class="admin-input" />
              </div>
              <div>
                <label class="admin-label">Year / Period</label>
                <input type="text" id="m-chap-year" value="${escapeHtml(item.year || '')}" class="admin-input" />
              </div>
            </div>
            <div>
              <label class="admin-label">Chapter Title</label>
              <input type="text" id="m-chap-title" value="${escapeHtml(item.title || '')}" class="admin-input" required />
            </div>
            <div>
              <label class="admin-label">Headline / Narrative Hook</label>
              <input type="text" id="m-chap-headline" value="${escapeHtml(item.headline || '')}" class="admin-input" />
            </div>
            <div>
              <label class="admin-label">Pull Quote</label>
              <input type="text" id="m-chap-quote" value="${escapeHtml(item.pullQuote || '')}" class="admin-input" />
            </div>
            <div>
              <label class="admin-label">Paragraphs (Separate paragraphs with double newlines)</label>
              <textarea id="m-chap-paras" rows="6" class="admin-input leading-relaxed">${escapeHtml((item.paragraphs || []).join('\n\n'))}</textarea>
            </div>
          </div>
        `;

        openModal(isNew ? 'Add Timeline Chapter' : 'Edit Chapter ' + item.number, html, () => {
          const title = document.getElementById('m-chap-title')?.value.trim();
          if (!title) return alert('Title required');
          const updated = {
            ...item,
            number: document.getElementById('m-chap-num')?.value.trim(),
            year: document.getElementById('m-chap-year')?.value.trim(),
            title,
            headline: document.getElementById('m-chap-headline')?.value.trim(),
            pullQuote: document.getElementById('m-chap-quote')?.value.trim(),
            paragraphs: document.getElementById('m-chap-paras')?.value.split('\n\n').map(s => s.trim()).filter(Boolean)
          };
          if (isNew) state.storyChapters.push(updated);
          else state.storyChapters[index] = updated;

          persistState('Chapter saved!');
          renderStory();
          closeModal();
        });
      }

      document.getElementById('btn-add-chapter')?.addEventListener('click', () => openChapterModal(-1));

      // RENDER: ARCHIVE ARTIFACTS & MULTI-PHOTO GALLERIES
      let archiveFilterTerm = '';
      let archiveFilterCategory = 'all';

      const searchArchiveInput = document.getElementById('search-archive');
      const filterArchiveSelect = document.getElementById('filter-archive-category');
      const btnManageCats = document.getElementById('btn-manage-categories');

      searchArchiveInput?.addEventListener('input', (e) => {
        archiveFilterTerm = (e.target && 'value' in e.target) ? String(e.target.value) : '';
        renderArchive();
      });

      filterArchiveSelect?.addEventListener('change', (e) => {
        archiveFilterCategory = (e.target && 'value' in e.target) ? String(e.target.value) : 'all';
        renderArchive();
      });

      btnManageCats?.addEventListener('click', () => openCategoryModal());

      function sanitizeMediaSrc(src) {
        if (!src) return '';
        return src.startsWith('/src') ? src.replace('/src', '') : src;
      }

      function renderArchive() {
        const container = document.getElementById('archive-list-container');
        if (!container) return;
        const list = state.archiveItems || [];

        // Update categories dropdown if not yet matching
        if (filterArchiveSelect) {
          const currentVal = archiveFilterCategory;
          const optionsHtml = `<option value="all">All Categories (${list.length})</option>` +
            (state.archiveCategories || []).filter(c => c.id !== 'all').map(c => {
              const count = list.filter(item => item.category === c.id).length;
              return `<option value="${c.id}" ${c.id === currentVal ? 'selected' : ''}>${escapeHtml(c.label)} (${count})</option>`;
            }).join('');
          if (filterArchiveSelect.innerHTML !== optionsHtml) {
            filterArchiveSelect.innerHTML = optionsHtml;
          }
        }

        const term = archiveFilterTerm.toLowerCase().trim();
        const filtered = list.filter(a => {
          const matchCat = archiveFilterCategory === 'all' || a.category === archiveFilterCategory;
          const matchTerm = !term ||
            a.title?.toLowerCase().includes(term) ||
            a.caption?.toLowerCase().includes(term) ||
            a.location?.toLowerCase().includes(term) ||
            (a.tags && a.tags.some(t => t.toLowerCase().includes(term)));
          return matchCat && matchTerm;
        });

        if (!filtered.length) {
          container.innerHTML = `
            <div class="col-span-full py-12 text-center text-zinc-500 text-xs">
              <p class="font-medium text-zinc-400">No artifacts found</p>
              <p class="mt-1">Try clearing filters or click "+ Add Photo / GIF Artifact" above.</p>
            </div>
          `;
          return;
        }

        container.innerHTML = filtered.map((a) => {
          const realIndex = list.indexOf(a);
          const allImages = a.images && a.images.length > 0 ? a.images : (a.imageSrc ? [a.imageSrc] : []);
          const primaryImg = a.imageSrc || allImages[0] || '';
          const isGif = primaryImg.toLowerCase().endsWith('.gif') || allImages.some(u => u?.toLowerCase().endsWith('.gif'));
          const cleanThumb = sanitizeMediaSrc(primaryImg);

          return `
            <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-4 space-y-3 flex flex-col justify-between hover:border-zinc-700 transition-colors">
              <div>
                <div class="relative w-full aspect-[16/10] overflow-hidden rounded-lg bg-zinc-950 mb-2 border border-zinc-800/80">
                  ${primaryImg.endsWith('.mp4') ? `
                    <video src="${cleanThumb}" class="h-full w-full object-cover"></video>
                  ` : primaryImg ? `
                    <img src="${cleanThumb}" class="h-full w-full object-cover" loading="lazy" />
                  ` : `
                    <div class="flex items-center justify-center h-full text-zinc-600 text-xs font-mono">No Image/GIF</div>
                  `}
                  <div class="absolute top-2 left-2 flex items-center gap-1 z-10">
                    ${isGif ? '<span class="rounded bg-purple-600 px-1.5 py-0.5 text-[9px] font-mono font-bold text-white shadow-xs">GIF</span>' : ''}
                    <span class="rounded bg-black/75 px-1.5 py-0.5 text-[10px] font-mono text-zinc-200 backdrop-blur-sm border border-white/10">📷 ${allImages.length}</span>
                  </div>
                  <span class="absolute top-2 right-2 rounded bg-black/75 px-1.5 py-0.5 text-[10px] font-mono text-zinc-300 backdrop-blur-sm z-10">${escapeHtml(a.year || '')}</span>
                </div>

                <div class="flex items-center justify-between text-xs mb-1">
                  <span class="rounded bg-amber-950/70 text-amber-300 border border-amber-800/80 px-1.5 py-0.5 text-[10px] font-mono">${escapeHtml(a.categoryLabel || a.category)}</span>
                  ${a.location ? `<span class="text-zinc-500 text-[10px] truncate max-w-[120px]">📍 ${escapeHtml(a.location)}</span>` : ''}
                </div>

                <h4 class="text-xs font-bold text-white line-clamp-1">${escapeHtml(a.title)}</h4>
                <p class="text-[11px] text-zinc-400 line-clamp-2 mt-1 leading-relaxed">${escapeHtml(a.caption || '')}</p>
              </div>

              <div class="flex items-center justify-between pt-2 border-t border-zinc-800/60">
                <button class="btn-del-artifact text-xs text-red-400 hover:text-red-300 hover:underline" data-index="${realIndex}">Delete</button>
                <div class="flex items-center gap-2">
                  <button class="btn-clone-artifact text-xs text-zinc-400 hover:text-white" data-index="${realIndex}">Duplicate</button>
                  <button class="btn-edit-artifact text-xs text-purple-400 hover:text-purple-300 hover:underline font-semibold" data-index="${realIndex}">Edit (${allImages.length} photos)</button>
                </div>
              </div>
            </div>
          `;
        }).join('');

        container.querySelectorAll('.btn-edit-artifact').forEach(b => {
          b.addEventListener('click', () => openArtifactModal(Number(b.dataset.index)));
        });

        container.querySelectorAll('.btn-clone-artifact').forEach(b => {
          b.addEventListener('click', () => {
            const idx = Number(b.dataset.index);
            const source = state.archiveItems[idx];
            if (!source) return;
            const cloned = JSON.parse(JSON.stringify(source));
            cloned.id = 'artifact-' + Date.now();
            cloned.title = cloned.title + ' (Copy)';
            state.archiveItems.splice(idx + 1, 0, cloned);
            persistState('Artifact duplicated!');
            renderArchive();
          });
        });

        container.querySelectorAll('.btn-del-artifact').forEach(b => {
          b.addEventListener('click', () => {
            const idx = Number(b.dataset.index);
            const target = state.archiveItems[idx];
            if (!target) return;
            if (confirm(`Delete artifact "${target.title}"?`)) {
              state.archiveItems.splice(idx, 1);
              persistState('Artifact deleted!');
              renderArchive();
            }
          });
        });
      }

      function openArtifactModal(index) {
        const isNew = index === -1;
        const item = isNew ? {
          id: 'artifact-' + Date.now(),
          title: '',
          category: (state.archiveCategories && state.archiveCategories[1]?.id) || 'current-work',
          categoryLabel: (state.archiveCategories && state.archiveCategories[1]?.label) || 'Current Work',
          year: new Date().getFullYear().toString(),
          location: 'Buea, Cameroon',
          caption: '',
          altText: '',
          imageSrc: '',
          images: [],
          isAvailable: true,
          tags: []
        } : state.archiveItems[index];

        // Clone current images array for this modal
        let modalImages = Array.isArray(item.images) && item.images.length > 0 
          ? [...item.images] 
          : (item.imageSrc ? [item.imageSrc] : []);

        const html = `
          <div class="space-y-4 max-h-[75vh] overflow-y-auto pr-1">
            <div>
              <label class="admin-label">Artifact Title</label>
              <input type="text" id="m-art-title" value="${escapeHtml(item.title || '')}" class="admin-input" placeholder="e.g. LifeDrop Blood Transfusion Logs" required />
            </div>

            <div class="grid gap-3 sm:grid-cols-2">
              <div>
                <div class="flex items-center justify-between mb-1">
                  <label class="admin-label mb-0">Archive Category / Album</label>
                  <button type="button" id="m-art-btn-new-cat" class="text-[10px] text-purple-400 hover:underline">+ New Album</button>
                </div>
                <select id="m-art-cat" class="admin-input">
                  ${(state.archiveCategories || []).filter(c => c.id !== 'all').map(c => `
                    <option value="${c.id}" ${item.category === c.id ? 'selected' : ''}>${escapeHtml(c.label)}</option>
                  `).join('')}
                </select>
              </div>

              <div>
                <label class="admin-label">Year / Date</label>
                <input type="text" id="m-art-year" value="${escapeHtml(item.year || '')}" class="admin-input" placeholder="e.g. 2026 or 2022–2024" />
              </div>
            </div>

            <div>
              <label class="admin-label">Geographic Location</label>
              <input type="text" id="m-art-location" value="${escapeHtml(item.location || '')}" class="admin-input" placeholder="e.g. Buea Regional Hospital, Cameroon" />
            </div>

            <!-- PRIMARY MEDIA (Photo or Animated GIF) -->
            <div class="rounded-xl border border-zinc-800 bg-zinc-900/60 p-4 space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-purple-400">Primary Photo or Animated GIF</span>
                <span class="text-[10px] font-mono text-zinc-400">Supports .gif, .jpg, .png, .webp, .mp4</span>
              </div>

              <div class="flex gap-2">
                <input type="text" id="m-art-img" value="${escapeHtml(item.imageSrc || '')}" class="admin-input text-xs font-mono" placeholder="Paste URL (https://...) or path (/assets/...)" />
                <label class="btn btn-sm border border-zinc-700 bg-zinc-800 text-zinc-300 hover:text-white shrink-0 cursor-pointer">
                  📁 Pick File/GIF
                  <input type="file" id="m-art-file-picker" accept="image/*,.gif,video/mp4" class="hidden" />
                </label>
              </div>

              <!-- Live Preview Box -->
              <div id="m-art-primary-preview" class="relative w-full aspect-[16/9] rounded-lg bg-zinc-950 border border-zinc-800 overflow-hidden flex items-center justify-center">
                <span class="text-zinc-600 text-xs">Preview will appear here</span>
              </div>
            </div>

            <!-- MULTI-PHOTO & GIF GALLERY MANAGER -->
            <div class="rounded-xl border border-purple-500/20 bg-purple-950/10 p-4 space-y-3">
              <div class="flex items-center justify-between">
                <div>
                  <h4 class="text-xs font-bold uppercase tracking-wider text-white">Additional Photos &amp; GIFs for this Archive</h4>
                  <p class="text-[11px] text-zinc-400">Add multiple photos or animated GIFs to make this a rich evidence gallery.</p>
                </div>
                <span id="m-gallery-count-badge" class="rounded bg-purple-500/20 border border-purple-500/30 px-2 py-0.5 text-[10px] font-mono font-semibold text-purple-300">
                  ${modalImages.length} attached
                </span>
              </div>

              <!-- Multi-file upload button and Single URL Adder -->
              <div class="flex flex-wrap gap-2">
                <input type="text" id="m-gallery-url-input" placeholder="Paste extra Photo/GIF URL..." class="admin-input text-xs font-mono flex-1 min-w-[200px]" />
                <button type="button" id="m-gallery-btn-add-url" class="btn btn-sm btn-accent shrink-0">
                  + Add URL
                </button>
                <label class="btn btn-sm border border-zinc-700 bg-zinc-800 text-zinc-300 hover:text-white shrink-0 cursor-pointer">
                  📁 Upload Multiple Photos/GIFs
                  <input type="file" id="m-gallery-multi-picker" accept="image/*,.gif,video/mp4" multiple class="hidden" />
                </label>
              </div>

              <!-- Bulk Paste Accordion -->
              <details class="text-xs text-zinc-400">
                <summary class="cursor-pointer hover:text-zinc-200 select-none py-1">Bulk Paste URLs (one per line) ▾</summary>
                <div class="mt-2 space-y-2">
                  <textarea id="m-gallery-bulk-textarea" rows="3" class="admin-input text-xs font-mono" placeholder="https://.../photo1.jpg&#10;https://.../demo.gif&#10;https://.../photo2.png"></textarea>
                  <button type="button" id="m-gallery-btn-bulk-add" class="btn btn-sm border border-zinc-700 bg-zinc-800 text-zinc-200">Append All URLs</button>
                </div>
              </details>

              <!-- Gallery Items Strip / Grid -->
              <div id="m-gallery-items-container" class="grid grid-cols-3 sm:grid-cols-4 gap-2 pt-2">
                <!-- Injected via JavaScript -->
              </div>
            </div>

            <div>
              <label class="admin-label">Caption / Documentary Context</label>
              <textarea id="m-art-caption" rows="3" class="admin-input" placeholder="Describe the technical, clinical, or field context...">${escapeHtml(item.caption || '')}</textarea>
            </div>

            <div class="grid gap-3 sm:grid-cols-2">
              <div>
                <label class="admin-label">Tags (comma-separated)</label>
                <input type="text" id="m-art-tags" value="${escapeHtml((item.tags || []).join(', '))}" class="admin-input text-xs" placeholder="e.g. LifeDrop, Clinical, Prototype" />
              </div>
              <div>
                <label class="admin-label">Verification Note (optional proof)</label>
                <input type="text" id="m-art-verified" value="${escapeHtml(item.verifiedNote || '')}" class="admin-input text-xs" placeholder="e.g. Buea Regional Hospital IRB approval" />
              </div>
            </div>
          </div>
        `;

        openModal(isNew ? 'Add Photo / GIF Artifact' : 'Edit Archive Artifact & Gallery', html, () => {
          const title = document.getElementById('m-art-title')?.value.trim();
          if (!title) return alert('Artifact Title is required.');
          const cat = document.getElementById('m-art-cat')?.value;
          const catObj = (state.archiveCategories || []).find(c => c.id === cat);
          const primaryImg = document.getElementById('m-art-img')?.value.trim() || (modalImages[0] || '');

          // Ensure primaryImg is in modalImages
          if (primaryImg && !modalImages.includes(primaryImg)) {
            modalImages.unshift(primaryImg);
          }

          const rawTags = document.getElementById('m-art-tags')?.value || '';
          const tags = rawTags.split(',').map(t => t.trim()).filter(Boolean);

          const updated = {
            ...item,
            title,
            category: cat,
            categoryLabel: catObj ? catObj.label : cat,
            year: document.getElementById('m-art-year')?.value.trim(),
            location: document.getElementById('m-art-location')?.value.trim(),
            caption: document.getElementById('m-art-caption')?.value.trim(),
            imageSrc: primaryImg,
            images: modalImages,
            altText: title,
            tags,
            verifiedNote: document.getElementById('m-art-verified')?.value.trim()
          };

          if (isNew) state.archiveItems.push(updated);
          else state.archiveItems[index] = updated;

          persistState('Archive artifact and photos saved!');
          renderArchive();
          closeModal();
        });

        // Wire up modal interactivity
        const primaryInput = document.getElementById('m-art-img');
        const primaryPreview = document.getElementById('m-art-primary-preview');
        const primaryPicker = document.getElementById('m-art-file-picker');
        const galleryContainer = document.getElementById('m-gallery-items-container');
        const galleryCountBadge = document.getElementById('m-gallery-count-badge');
        const galleryUrlInput = document.getElementById('m-gallery-url-input');
        const galleryAddUrlBtn = document.getElementById('m-gallery-btn-add-url');
        const galleryMultiPicker = document.getElementById('m-gallery-multi-picker');
        const galleryBulkTextarea = document.getElementById('m-gallery-bulk-textarea');
        const galleryBulkBtn = document.getElementById('m-gallery-btn-bulk-add');
        const btnNewCat = document.getElementById('m-art-btn-new-cat');

        function updatePrimaryPreview() {
          if (!primaryPreview) return;
          const src = primaryInput?.value?.trim() || '';
          if (!src) {
            primaryPreview.innerHTML = '<span class="text-zinc-600 text-xs">No media specified</span>';
            return;
          }
          const clean = sanitizeMediaSrc(src);
          const isGif = src.toLowerCase().endsWith('.gif');
          if (src.endsWith('.mp4')) {
            primaryPreview.innerHTML = `
              <video src="${clean}" autoplay loop muted playsinline class="h-full w-full object-contain"></video>
            `;
          } else {
            primaryPreview.innerHTML = `
              <img src="${clean}" class="h-full w-full object-contain" />
              ${isGif ? '<span class="absolute top-2 left-2 bg-purple-600 text-white font-mono font-bold text-[9px] px-1.5 py-0.5 rounded shadow-xs">ANIMATED GIF</span>' : ''}
            `;
          }
        }

        primaryInput?.addEventListener('input', updatePrimaryPreview);
        updatePrimaryPreview();

        primaryPicker?.addEventListener('change', (e) => {
          const target = e.target;
          const file = (target && 'files' in target && target.files) ? target.files[0] : null;
          if (!file) return;
          const reader = new FileReader();
          reader.onload = (ev) => {
            const dataUrl = (ev.target && 'result' in ev.target) ? String(ev.target.result) : '';
            if (primaryInput && 'value' in primaryInput) primaryInput.value = dataUrl;
            if (!modalImages.includes(dataUrl)) modalImages.unshift(dataUrl);
            updatePrimaryPreview();
            renderModalGallery();
          };
          reader.readAsDataURL(file);
        });

        function renderModalGallery() {
          if (!galleryContainer) return;
          if (galleryCountBadge) galleryCountBadge.textContent = `${modalImages.length} attached`;

          if (!modalImages.length) {
            galleryContainer.innerHTML = '<p class="col-span-full text-zinc-500 text-[11px] italic">No extra photos/GIFs attached yet.</p>';
            return;
          }

          galleryContainer.innerHTML = modalImages.map((src, idx) => {
            const clean = sanitizeMediaSrc(src);
            const isGif = src.toLowerCase().endsWith('.gif');
            const isPrimary = (primaryInput && 'value' in primaryInput ? String(primaryInput.value).trim() : '') === src;

            return `
              <div class="relative group aspect-square rounded-lg border ${isPrimary ? 'border-purple-500 ring-1 ring-purple-500' : 'border-zinc-800'} bg-zinc-950 overflow-hidden">
                ${src.endsWith('.mp4') ? `
                  <video src="${clean}" class="h-full w-full object-cover"></video>
                ` : `
                  <img src="${clean}" class="h-full w-full object-cover" />
                `}
                <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-1">
                  <button type="button" class="btn-set-primary text-[10px] bg-purple-600 text-white px-1.5 py-0.5 rounded hover:bg-purple-500" data-idx="${idx}" title="Set as primary photo">★</button>
                  <button type="button" class="btn-del-thumb text-[10px] bg-red-600 text-white px-1.5 py-0.5 rounded hover:bg-red-500" data-idx="${idx}" title="Remove photo">✕</button>
                </div>
                ${isGif ? '<span class="absolute bottom-1 left-1 bg-purple-600 text-white text-[8px] font-mono font-bold px-1 rounded">GIF</span>' : ''}
                ${isPrimary ? '<span class="absolute top-1 left-1 bg-accent text-zinc-950 text-[8px] font-bold px-1 rounded">Primary</span>' : ''}
              </div>
            `;
          }).join('');

          galleryContainer.querySelectorAll('.btn-set-primary').forEach(b => {
            b.addEventListener('click', (e) => {
              e.stopPropagation();
              const idx = Number(b.getAttribute('data-idx'));
              const selected = modalImages[idx];
              if (selected && primaryInput && 'value' in primaryInput) {
                primaryInput.value = selected;
                updatePrimaryPreview();
                renderModalGallery();
              }
            });
          });

          galleryContainer.querySelectorAll('.btn-del-thumb').forEach(b => {
            b.addEventListener('click', (e) => {
              e.stopPropagation();
              const idx = Number(b.getAttribute('data-idx'));
              modalImages.splice(idx, 1);
              renderModalGallery();
            });
          });
        }

        renderModalGallery();

        galleryAddUrlBtn?.addEventListener('click', () => {
          const url = (galleryUrlInput && 'value' in galleryUrlInput) ? String(galleryUrlInput.value).trim() : '';
          if (!url) return;
          modalImages.push(url);
          if (galleryUrlInput && 'value' in galleryUrlInput) galleryUrlInput.value = '';
          renderModalGallery();
        });

        galleryMultiPicker?.addEventListener('change', (e) => {
          const target = e.target;
          const files = (target && 'files' in target && target.files) ? target.files : null;
          if (!files || !files.length) return;
          Array.from(files).forEach(file => {
            const reader = new FileReader();
            reader.onload = (ev) => {
              const res = (ev.target && 'result' in ev.target) ? String(ev.target.result) : '';
              if (res && !modalImages.includes(res)) {
                modalImages.push(res);
                renderModalGallery();
              }
            };
            reader.readAsDataURL(file);
          });
        });

        galleryBulkBtn?.addEventListener('click', () => {
          const text = (galleryBulkTextarea && 'value' in galleryBulkTextarea) ? String(galleryBulkTextarea.value) : '';
          const lines = text.split('\n').map(l => l.trim()).filter(Boolean);
          if (!lines.length) return;
          lines.forEach(u => {
            if (!modalImages.includes(u)) modalImages.push(u);
          });
          if (galleryBulkTextarea && 'value' in galleryBulkTextarea) galleryBulkTextarea.value = '';
          renderModalGallery();
        });

        btnNewCat?.addEventListener('click', () => {
          const newName = prompt('Enter New Archive Album / Category Name:');
          if (!newName || !newName.trim()) return;
          const cleanName = newName.trim();
          const newId = cleanName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
          
          if (!state.archiveCategories) state.archiveCategories = [];
          if (!state.archiveCategories.some(c => c.id === newId)) {
            state.archiveCategories.push({ id: newId, label: cleanName });
            persistState(`Added new category "${cleanName}"!`);
          }

          const catSelect = document.getElementById('m-art-cat');
          if (catSelect && 'innerHTML' in catSelect && 'value' in catSelect) {
            catSelect.innerHTML = (state.archiveCategories || []).filter(c => c.id !== 'all').map(c => `
              <option value="${c.id}" ${c.id === newId ? 'selected' : ''}>${escapeHtml(c.label)}</option>
            `).join('');
            catSelect.value = newId;
          }
        });
      }

      function openCategoryModal() {
        const cats = state.archiveCategories || [];
        const items = state.archiveItems || [];

        const html = `
          <div class="space-y-4">
            <p class="text-xs text-zinc-300 leading-relaxed">
              Create new photographic archive categories or manage existing folders. Every category appears in the public Evidence filter bar.
            </p>

            <div class="rounded-xl border border-zinc-800 bg-zinc-900/60 p-4 space-y-3">
              <h4 class="text-xs font-bold uppercase tracking-wider text-accent">+ Create New Archive Album / Category</h4>
              <div class="grid gap-3 sm:grid-cols-2">
                <div>
                  <label class="admin-label">Category Title / Label</label>
                  <input type="text" id="m-newcat-label" class="admin-input text-xs" placeholder="e.g. Field Deployments 2026" />
                </div>
                <div>
                  <label class="admin-label">Category Slug / ID</label>
                  <input type="text" id="m-newcat-id" class="admin-input text-xs font-mono" placeholder="e.g. field-deployments-2026" />
                </div>
              </div>
              <button type="button" id="m-newcat-btn-add" class="btn btn-sm btn-accent">
                Add Category
              </button>
            </div>

            <div class="space-y-2">
              <h4 class="text-xs font-bold uppercase tracking-wider text-zinc-400">Existing Archive Albums</h4>
              <div class="max-h-60 overflow-y-auto space-y-1.5" id="m-cat-list-container">
                ${cats.map(c => {
                  const count = items.filter(i => i.category === c.id).length;
                  const isProtected = c.id === 'all';
                  return `
                    <div class="flex items-center justify-between p-2.5 rounded-lg bg-zinc-900 border border-zinc-800 text-xs">
                      <div class="flex items-center gap-2">
                        <span class="font-semibold text-white">${escapeHtml(c.label)}</span>
                        <span class="font-mono text-[10px] text-zinc-500">(${c.id})</span>
                        <span class="rounded bg-zinc-800 px-1.5 py-0.5 text-[10px] font-mono text-zinc-400">${count} items</span>
                      </div>
                      ${!isProtected ? `
                        <button type="button" class="btn-del-cat text-red-400 hover:text-red-300 text-xs hover:underline" data-id="${c.id}">
                          Delete
                        </button>
                      ` : '<span class="text-[10px] text-zinc-600">Default</span>'}
                    </div>
                  `;
                }).join('')}
              </div>
            </div>
          </div>
        `;

        openModal('Manage Archive Categories & Albums', html, () => {
          closeModal();
        });

        const labelInput = document.getElementById('m-newcat-label');
        const idInput = document.getElementById('m-newcat-id');
        const addBtn = document.getElementById('m-newcat-btn-add');

        labelInput?.addEventListener('input', () => {
          if (idInput && 'value' in idInput && 'dataset' in idInput && !idInput.dataset.touched && 'value' in labelInput) {
            idInput.value = String(labelInput.value || '')
              .toLowerCase()
              .replace(/[^a-z0-9]+/g, '-')
              .replace(/(^-|-$)/g, '');
          }
        });

        idInput?.addEventListener('input', () => {
          if (idInput && 'dataset' in idInput) idInput.dataset.touched = 'true';
        });

        addBtn?.addEventListener('click', () => {
          const label = (labelInput && 'value' in labelInput) ? String(labelInput.value).trim() : '';
          const id = (idInput && 'value' in idInput) ? String(idInput.value).trim() : '';
          if (!label || !id) return alert('Category Title and Slug are required.');

          if (!state.archiveCategories) state.archiveCategories = [];
          if (state.archiveCategories.some(c => c.id === id)) {
            return alert(`Category ID "${id}" already exists.`);
          }

          state.archiveCategories.push({ id, label });
          persistState(`Created new archive category "${label}"!`);
          renderArchive();
          closeModal();
          openCategoryModal();
        });

        document.querySelectorAll('.btn-del-cat').forEach(b => {
          b.addEventListener('click', () => {
            const catId = b.getAttribute('data-id');
            if (!catId) return;
            const targetCat = (state.archiveCategories || []).find(c => c.id === catId);
            const count = (state.archiveItems || []).filter(i => i.category === catId).length;
            if (confirm(`Delete category "${targetCat?.label || catId}"? (${count} items currently filed here)`)) {
              state.archiveCategories = state.archiveCategories.filter(c => c.id !== catId);
              persistState(`Deleted category "${targetCat?.label || catId}"`);
              renderArchive();
              closeModal();
              openCategoryModal();
            }
          });
        });
      }

      document.getElementById('btn-add-artifact')?.addEventListener('click', () => openArtifactModal(-1));

      // RENDER: IMPACT METRICS
      function renderMetrics() {
        const container = document.getElementById('metrics-list-container');
        if (!container) return;
        const list = state.impactMetrics || [];

        container.innerHTML = list.map((m, i) => `
          <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-4 flex flex-col justify-between">
            <div>
              <div class="flex items-baseline gap-1">
                <span class="text-2xl font-display font-bold text-white">${escapeHtml(m.value)}</span>
                <span class="text-lg font-bold text-accent">${escapeHtml(m.suffix || '')}</span>
              </div>
              <h4 class="text-xs font-bold text-zinc-200 mt-1">${escapeHtml(m.label)}</h4>
              <p class="text-[11px] text-zinc-400 mt-1 line-clamp-2">${escapeHtml(m.context || '')}</p>
            </div>
            <div class="mt-3 pt-2 border-t border-zinc-800 flex items-center justify-between text-[10px]">
              <span class="text-emerald-400 font-mono">${m.status}</span>
              <button class="text-purple-400 hover:underline" onclick="editMetric(${i})">Edit</button>
            </div>
          </div>
        `).join('');
      }

      window.editMetric = function(index) {
        const item = state.impactMetrics[index];
        const val = prompt('Metric Value (e.g. 387):', item.value);
        if (val !== null) {
          item.value = val;
          item.label = prompt('Metric Label:', item.label) || item.label;
          persistState('Metric updated!');
          renderMetrics();
        }
      };

      document.getElementById('btn-add-metric')?.addEventListener('click', () => {
        const val = prompt('Metric Value (e.g. 100):');
        const sfx = prompt('Suffix (e.g. + or % or leave blank):');
        const lbl = prompt('Metric Label:');
        const ctx = prompt('Context description:');
        if (val && lbl) {
          state.impactMetrics.unshift({
            id: 'metric-' + Date.now(),
            value: val,
            suffix: sfx || '',
            label: lbl,
            context: ctx || '',
            category: 'experience',
            status: 'verified'
          });
          persistState('New metric added!');
          renderMetrics();
        }
      });

      // MODAL HELPERS
      const modal = document.getElementById('admin-modal');
      const modalTitle = document.getElementById('modal-title');
      const modalBody = document.getElementById('modal-body');
      const modalSaveBtn = document.getElementById('modal-save-btn');
      const modalDelBtn = document.getElementById('modal-delete-btn');
      let currentSaveHandler = null;
      let currentDelHandler = null;

      function openModal(title, bodyHtml, onSave, onDelete = null) {
        modalTitle.textContent = title;
        modalBody.innerHTML = bodyHtml;
        modal.classList.remove('hidden');

        if (currentSaveHandler) modalSaveBtn.removeEventListener('click', currentSaveHandler);
        currentSaveHandler = onSave;
        modalSaveBtn.addEventListener('click', currentSaveHandler);

        if (onDelete) {
          modalDelBtn.classList.remove('hidden');
          if (currentDelHandler) modalDelBtn.removeEventListener('click', currentDelHandler);
          currentDelHandler = onDelete;
          modalDelBtn.addEventListener('click', currentDelHandler);
        } else {
          modalDelBtn.classList.add('hidden');
        }
      }

      function closeModal() {
        modal.classList.add('hidden');
        modalBody.innerHTML = '';
      }

      document.getElementById('modal-close-btn')?.addEventListener('click', closeModal);
      document.getElementById('modal-cancel-btn')?.addEventListener('click', closeModal);

      // EXPORT & BACKUP LOGIC
      function exportFullBackup() {
        const dataStr = 'data:text/json;charset=utf-8,' + encodeURIComponent(JSON.stringify(state, null, 2));
        const dlAnchor = document.createElement('a');
        dlAnchor.setAttribute('href', dataStr);
        dlAnchor.setAttribute('download', 'chifen-portfolio-backup-' + new Date().toISOString().slice(0, 10) + '.json');
        document.body.appendChild(dlAnchor);
        dlAnchor.click();
        dlAnchor.remove();
        showToast('Full backup downloaded!');
      }

      document.getElementById('btn-export-backup')?.addEventListener('click', exportFullBackup);
      document.getElementById('btn-export-json-file')?.addEventListener('click', exportFullBackup);

      // Import Backup
      document.getElementById('input-import-backup')?.addEventListener('change', e => {
        const file = e.target.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = ev => {
          try {
            const imported = JSON.parse(ev.target?.result);
            if (imported) {
              state = { ...state, ...imported };
              persistState('Backup successfully imported and applied!');
              refreshAll();
            }
          } catch (err) {
            alert('Failed to parse JSON backup file.');
          }
        };
        reader.readAsText(file);
      });

      // Clear all overrides
      document.getElementById('btn-clear-all-overrides')?.addEventListener('click', () => {
        if (!confirm('This will wipe all client customizations and restore defaults. Continue?')) return;
        localStorage.removeItem(STORAGE_KEY);
        state = JSON.parse(JSON.stringify(initialData));
        persistState('Reset to default repository data.');
        refreshAll();
      });

      // Code generator snippet
      window.copyCodeSnippet = function(type) {
        let code = '';
        let title = '';
        if (type === 'siteConfig') {
          code = JSON.stringify(state.siteConfig, null, 2);
          title = 'src/data/siteConfig.json';
        } else if (type === 'masterCv') {
          code = 'export const masterCvData = ' + JSON.stringify(state.masterCvData, null, 2) + ';\n';
          title = 'src/lib/masterCvData.ts';
        } else if (type === 'metrics') {
          code = 'export const impactMetrics = ' + JSON.stringify(state.impactMetrics, null, 2) + ';\n';
          title = 'src/data/metrics.ts';
        } else if (type === 'talks') {
          code = JSON.stringify(state.talks, null, 2);
          title = 'src/data/talks.json';
        }

        const pre = document.getElementById('code-snippet-pre');
        const ttl = document.getElementById('code-snippet-title');
        if (pre) pre.textContent = code;
        if (ttl) ttl.textContent = title;
      };

      document.getElementById('btn-copy-code-preview')?.addEventListener('click', () => {
        const pre = document.getElementById('code-snippet-pre');
        if (!pre || !pre.textContent) return;
        navigator.clipboard.writeText(pre.textContent).then(() => {
          showToast('Code copied to clipboard!');
        });
      });

      function escapeHtml(str) {
        if (!str) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      function refreshAll() {
        populateProfile();
        renderProjects();
        renderBlog();
        renderExperience();
        renderEducation();
        renderResearch();
        renderTalks();
        renderStory();
        renderArchive();
        renderMetrics();
        updateBadges();
      }

      // Initial boot
      refreshAll();
    })();
  </script>

  <style>
    .admin-tab {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.5rem 0.75rem;
      border-radius: 0.5rem;
      color: #a1a1aa;
      white-space: nowrap;
      transition: all 0.15s ease;
    }
    .admin-tab:hover {
      color: #ffffff;
      background-color: #27272a;
    }
    .admin-tab.active {
      color: #ffffff;
      background-color: #8b5cf6;
      font-weight: 600;
    }
    .count-pill {
      font-size: 0.65rem;
      padding: 0.1rem 0.35rem;
      border-radius: 9999px;
      background: rgba(0, 0, 0, 0.4);
      font-family: ui-monospace, monospace;
    }
    .admin-label {
      display: block;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #a1a1aa;
      margin-bottom: 0.375rem;
    }
    .admin-input {
      width: 100%;
      border-radius: 0.5rem;
      border: 1px solid #3f3f46;
      background-color: #18181b;
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
      color: #ffffff;
      outline: none;
      transition: border-color 0.15s ease;
    }
    .admin-input:focus {
      border-color: #8b5cf6;
    }
    /* Hide scrollbar for Chrome, Safari and Opera */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    /* Hide scrollbar for IE, Edge and Firefox */
    .no-scrollbar {
      -ms-overflow-style: none;  /* IE and Edge */
      scrollbar-width: none;  /* Firefox */
    }
  </style>
</Base>
