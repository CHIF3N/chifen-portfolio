  <!-- Embed Master Data for Client Engine -->
  <script id="admin-initial-data" type="application/json" is:inline set:html={JSON.stringify(initialMasterData)}></script>

  <!-- Client-Side Admin Application Logic -->
  <script is:inline>
    (() => {
      const STORAGE_KEY = 'chifen_site_overrides';
      const AUTH_KEY = 'chifen_admin_authenticated';
      const AUTH_EXPIRY_KEY = 'chifen_admin_auth_expiry';
      const FAIL_COUNT_KEY = 'chifen_admin_fail_count';
      const LOCKOUT_KEY = 'chifen_admin_lockout_until';
      const CUSTOM_HASH_KEY = 'chifen_custom_admin_hash';

      // SHA-256 hashes of authorized administrative passphrases
      const VALID_HASHES = [
        'fefae624ed8b9244b84cc4dbd60b88ada0fbdb600e886735e4bd670d6d52f6b8', // chif3n-admin-2026
        '5d69aa0e2e0b898f1b2973e5c091a92fdd8b245dca4cb004b517a4b8401fb271', // chifen2026!
        '5456005152ac4f1f7485ce16e27fd74a14df81cfbf91c9780a76471f157a6441'  // chif3n2026
      ];

      const authGate = document.getElementById('admin-auth-gate');
      const gateForm = document.getElementById('admin-gate-form');
      const gateInput = document.getElementById('admin-gate-password');
      const gateError = document.getElementById('admin-gate-error');
      const gateErrorText = document.getElementById('admin-gate-error-text');
      const gateSubmitBtn = document.getElementById('admin-gate-submit-btn');
      const logoutBtn = document.getElementById('btn-admin-logout');

      async function sha256(str) {
        const buf = new TextEncoder().encode(str);
        const digest = await window.crypto.subtle.digest('SHA-256', buf);
        return Array.from(new Uint8Array(digest)).map(b => b.toString(16).padStart(2, '0')).join('');
      }

      function isSessionValid() {
        const authed = sessionStorage.getItem(AUTH_KEY) === 'true';
        const expiry = parseInt(sessionStorage.getItem(AUTH_EXPIRY_KEY) || '0', 10);
        return authed && expiry > Date.now();
      }

      function checkLockout() {
        const lockoutUntil = parseInt(sessionStorage.getItem(LOCKOUT_KEY) || '0', 10);
        const now = Date.now();
        if (lockoutUntil > now) {
          const remainingSecs = Math.ceil((lockoutUntil - now) / 1000);
          if (gateErrorText) {
            gateErrorText.textContent = `Security lockout active: please wait ${remainingSecs}s.`;
          }
          if (gateError) gateError.classList.remove('hidden');
          if (gateInput) gateInput.disabled = true;
          if (gateSubmitBtn) gateSubmitBtn.disabled = true;
          return true;
        }
        if (gateInput) gateInput.disabled = false;
        if (gateSubmitBtn) gateSubmitBtn.disabled = false;
        return false;
      }

      function checkAuth() {
        if (isSessionValid()) {
          if (authGate) authGate.classList.add('hidden');
        } else {
          if (authGate) {
            authGate.classList.remove('hidden');
            if (checkLockout()) return;
            if (gateInput) {
              gateInput.value = '';
              setTimeout(() => gateInput.focus(), 60);
            }
          }
        }
      }

      gateForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (checkLockout()) return;

        const entered = gateInput?.value?.trim() || '';
        if (!entered) return;

        const hashed = await sha256(entered);
        const customHash = localStorage.getItem(CUSTOM_HASH_KEY);
        const isMatch = VALID_HASHES.includes(hashed) || (customHash && customHash === hashed);

        if (isMatch) {
          sessionStorage.removeItem(FAIL_COUNT_KEY);
          sessionStorage.removeItem(LOCKOUT_KEY);
          sessionStorage.setItem(AUTH_KEY, 'true');
          sessionStorage.setItem(AUTH_EXPIRY_KEY, String(Date.now() + 8 * 60 * 60 * 1000));
          if (authGate) authGate.classList.add('hidden');
          showToast('Welcome back, Chifen! Studio unlocked.');
        } else {
          let fails = parseInt(sessionStorage.getItem(FAIL_COUNT_KEY) || '0', 10) + 1;
          sessionStorage.setItem(FAIL_COUNT_KEY, String(fails));
          if (fails >= 5) {
            sessionStorage.setItem(LOCKOUT_KEY, String(Date.now() + 60 * 1000));
            checkLockout();
          } else {
            if (gateErrorText) {
              gateErrorText.textContent = `Incorrect admin password. (${5 - fails} attempts remaining)`;
            }
            if (gateError) gateError.classList.remove('hidden');
          }
          gateInput?.focus();
        }
      });

      logoutBtn?.addEventListener('click', () => {
        if (confirm('Lock Admin Studio and sign out?')) {
          sessionStorage.removeItem(AUTH_KEY);
          sessionStorage.removeItem(AUTH_EXPIRY_KEY);
          checkAuth();
        }
      });

      // Custom Admin Password updates
      const updatePassBtn = document.getElementById('btn-update-admin-pass');
      const resetPassBtn = document.getElementById('btn-reset-admin-pass');
      const newPassInput = document.getElementById('input-new-admin-pass');
      const confirmPassInput = document.getElementById('input-confirm-admin-pass');
      const passStatus = document.getElementById('admin-pass-status');

      updatePassBtn?.addEventListener('click', async () => {
        const p1 = newPassInput?.value?.trim() || '';
        const p2 = confirmPassInput?.value?.trim() || '';
        if (!p1) {
          alert('Please enter a new password.');
          return;
        }
        if (p1.length < 8) {
          alert('Password should be at least 8 characters long.');
          return;
        }
        if (p1 !== p2) {
          alert('Passwords do not match. Please re-enter.');
          return;
        }
        const hash = await sha256(p1);
        localStorage.setItem(CUSTOM_HASH_KEY, hash);
        if (passStatus) {
          passStatus.textContent = '✓ Custom admin password successfully saved! Protected with SHA-256.';
          passStatus.className = 'text-xs mt-2 text-emerald-400 font-semibold';
          passStatus.classList.remove('hidden');
        }
        if (newPassInput) newPassInput.value = '';
        if (confirmPassInput) confirmPassInput.value = '';
        showToast('Admin password updated successfully.');
      });

      resetPassBtn?.addEventListener('click', () => {
        if (confirm('Reset custom password and restore default administrative passwords?')) {
          localStorage.removeItem(CUSTOM_HASH_KEY);
          if (passStatus) {
            passStatus.textContent = '✓ Custom password removed. Default admin keys active.';
            passStatus.className = 'text-xs mt-2 text-cyan-400 font-semibold';
            passStatus.classList.remove('hidden');
          }
          showToast('Admin password reset to default.');
        }
      });

      checkAuth();
      
      // Load raw data
      const rawInitial = document.getElementById('admin-initial-data')?.textContent;
      const initialData = rawInitial ? JSON.parse(rawInitial) : {};

      // Load overrides from localStorage
      function loadActiveState() {
        try {
          const stored = localStorage.getItem(STORAGE_KEY);
          if (stored) {
            const parsed = JSON.parse(stored);
            return {
              ...initialData,
              ...parsed,
              siteConfig: { ...initialData.siteConfig, ...(parsed.siteConfig || {}) },
              masterCvData: { ...initialData.masterCvData, ...(parsed.masterCvData || {}) },
              projects: parsed.projects || initialData.projects || [],
              blogPosts: parsed.blogPosts || initialData.blogPosts || [],
              research: parsed.research || initialData.research || [],
              talks: parsed.talks || initialData.talks || [],
              storyChapters: parsed.storyChapters || initialData.storyChapters || [],
              archiveItems: parsed.archiveItems || initialData.archiveItems || [],
              archiveCategories: parsed.archiveCategories || initialData.archiveCategories || [],
              impactMetrics: parsed.impactMetrics || initialData.impactMetrics || [],
            };
          }
        } catch (e) {
          console.error('Error loading stored overrides', e);
        }
        return JSON.parse(JSON.stringify(initialData));
      }

      let state = loadActiveState();

      // Persist state to localStorage and update indicators
      function persistState(message = 'Changes saved successfully!') {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
          showToast(message);
          updateBadges();
          const ind = document.getElementById('storage-status-indicator');
          if (ind) ind.textContent = 'Storage: Sync Saved (' + new Date().toLocaleTimeString() + ')';
        } catch (e) {
          console.error('Error saving state', e);
          showToast('Failed to save to localStorage', true);
        }
      }

      function showToast(msg, isError = false) {
        const toast = document.getElementById('admin-toast');
        const txt = document.getElementById('toast-message');
        if (!toast || !txt) return;
        txt.textContent = msg;
        if (isError) {
          toast.classList.remove('border-emerald-500/40', 'text-emerald-300');
          toast.classList.add('border-red-500/40', 'text-red-300');
        } else {
          toast.classList.remove('border-red-500/40', 'text-red-300');
          toast.classList.add('border-emerald-500/40', 'text-emerald-300');
        }
        toast.classList.remove('translate-y-[-150%]', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');
        setTimeout(() => {
          toast.classList.add('translate-y-[-150%]', 'opacity-0');
          toast.classList.remove('translate-y-0', 'opacity-100');
        }, 3200);
      }

      // Tab Switching
      const tabButtons = document.querySelectorAll('.admin-tab');
      const tabPanes = document.querySelectorAll('.admin-tab-pane');

      tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const target = btn.dataset.target;
          tabButtons.forEach(b => b.classList.remove('active'));
          tabPanes.forEach(p => p.classList.add('hidden'));
          btn.classList.add('active');
          document.getElementById(target)?.classList.remove('hidden');
        });
      });

      // Populate Profile Form
      function populateProfile() {
        const cfg = state.siteConfig || {};
        const fields = ['name', 'displayName', 'brand', 'creativeIdentity', 'role', 'tagline', 'pitch', 'github', 'linkedin', 'email', 'whatsapp', 'location', 'inkwave', 'softwareBackground'];
        fields.forEach(f => {
          const el = document.getElementById('field-prof-' + f);
          if (el) el.value = cfg[f] || '';
        });
      }

      document.getElementById('btn-save-profile')?.addEventListener('click', () => {
        const fields = ['name', 'displayName', 'brand', 'creativeIdentity', 'role', 'tagline', 'pitch', 'github', 'linkedin', 'email', 'whatsapp', 'location', 'inkwave', 'softwareBackground'];
        state.siteConfig = state.siteConfig || {};
        fields.forEach(f => {
          const el = document.getElementById('field-prof-' + f);
          if (el) state.siteConfig[f] = el.value.trim();
        });
        persistState('Site Profile saved successfully!');
      });

      // Update badge counts
      function updateBadges() {
        const setVal = (id, count) => {
          const el = document.getElementById(id);
          if (el) el.textContent = String(count);
        };
        setVal('badge-projects-count', (state.projects || []).length);
        setVal('badge-blog-count', (state.blogPosts || []).length);
        setVal('badge-exp-count', (state.masterCvData?.activeRoles?.length || 0) + (state.masterCvData?.concludedRoles?.length || 0));
        setVal('badge-research-count', (state.research || []).length);
        setVal('badge-talks-count', (state.talks || []).length);
        setVal('badge-story-count', (state.storyChapters || []).length);
        setVal('badge-archive-count', (state.archiveItems || []).length);
        setVal('dash-metrics-count', (state.impactMetrics || []).length);
      }

      // RENDER: PROJECTS
      function renderProjects(filterText = '') {
        const container = document.getElementById('projects-list-container');
        if (!container) return;
        const list = state.projects || [];
        const term = filterText.toLowerCase();
        const filtered = list.filter(p => 
          !term || 
          p.title?.toLowerCase().includes(term) || 
          p.summary?.toLowerCase().includes(term) || 
          p.tags?.some(t => t.toLowerCase().includes(term)) ||
          p.status?.toLowerCase().includes(term)
        );

        if (!filtered.length) {
          container.innerHTML = '<div class="col-span-full py-8 text-center text-xs text-zinc-500">No matching projects found. Click "+ Add New Project" to create one.</div>';
          return;
        }

        container.innerHTML = filtered.map(p => `
          <div class="rounded-xl border border-zinc-800 bg-zinc-900/60 p-5 flex flex-col justify-between hover:border-zinc-700 transition-colors">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="rounded bg-zinc-800 px-2 py-0.5 text-[10px] font-mono font-semibold uppercase text-zinc-300">
                  ${p.status}
                </span>
                <span class="text-xs font-mono text-zinc-500">${p.year}</span>
              </div>
              <h4 class="text-base font-bold text-white">${escapeHtml(p.title)}</h4>
