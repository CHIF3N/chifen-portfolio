        if (choice === '1') {
          const deg = prompt('Degree Name (e.g. M.Tech in Data Science):');
          const inst = prompt('Institution (e.g. COLTECH University of Bamenda):');
          const per = prompt('Period (e.g. 2026 - Present):');
          if (deg && inst) {
            state.masterCvData.education.unshift({ degree: deg, institution: inst, period: per || '2026', highlights: [] });
            persistState('Degree added.');
            renderEducation();
          }
        } else if (choice === '2') {
          const awd = prompt('Award Title:');
          if (awd) {
            state.masterCvData.awards.unshift(awd);
            persistState('Award added.');
            renderEducation();
          }
        } else if (choice === '3') {
          const cert = prompt('Certification Name:');
          const iss = prompt('Issuer:');
          if (cert) {
            state.masterCvData.certifications.unshift({ name: cert, issuer: iss || '' });
            persistState('Certification added.');
            renderEducation();
          }
        }
      });

