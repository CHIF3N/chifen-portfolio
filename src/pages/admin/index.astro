                  <div class="w-full aspect-video rounded overflow-hidden bg-black">
                    <img src="${a.url}" alt="${escapeHtml(a.title || a.name)}" class="w-full h-full object-cover" onerror="this.src='/photos/chifen-portrait.jpg';" />
