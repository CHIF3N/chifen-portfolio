---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import siteConfig from '../../data/siteConfig.json';
import { masterCvData } from '../../lib/masterCvData';
import { storyChapters, professionalBio } from '../../data/storyData';
import { impactMetrics } from '../../data/metrics';
import talksData from '../../data/talks.json';
import { archiveItems, archiveCategories } from '../../data/archiveData';
import { withBase } from '../../lib/url';

// Load all content collections
const workEntries = await getCollection('work');
const blogEntries = await getCollection('blog');
const researchEntries = await getCollection('research');

// Package initial data for client-side administration
const initialMasterData = {
  siteConfig,
  masterCvData,
  professionalBio,
  storyChapters,
  impactMetrics,
  talks: talksData,
  archiveItems,
  archiveCategories,
  projects: workEntries.map(e => ({
    id: e.id,
    slug: e.id.replace(/\.(md|mdx)$/, ''),
    title: e.data.title,
    summary: e.data.summary,
    role: e.data.role,
    tags: e.data.tags,
    status: e.data.status,
    year: e.data.year,
    liveUrl: e.data.liveUrl || '',
    repoUrl: e.data.repoUrl || '',
    featured: e.data.featured || false,
    metrics: e.data.metrics || [],
    order: e.data.order ?? 100,
    note: e.data.note || '',
    researchSlug: e.data.researchSlug || '',
    body: e.body || ''
  })),
  research: researchEntries.map(e => ({
    id: e.id,
    slug: e.id.replace(/\.(md|mdx)$/, ''),
    title: e.data.title,
    summary: e.data.summary,
    institution: e.data.institution,
    year: e.data.year,
    tags: e.data.tags,
    kind: e.data.kind,
    status: e.data.status,
    abstractUrl: e.data.abstractUrl || '',
    pdfUrl: e.data.pdfUrl || '',
    supervisor: e.data.supervisor || '',
    site: e.data.site || '',
    body: e.body || ''
  })),
  blogPosts: blogEntries.map(e => ({
    id: e.id,
    slug: e.id.replace(/\.(md|mdx)$/, ''),
    title: e.data.title,
    description: e.data.description,
    pubDate: e.data.pubDate ? new Date(e.data.pubDate).toISOString().slice(0, 10) : '',
    updated: e.data.updated ? new Date(e.data.updated).toISOString().slice(0, 10) : '',
    tags: e.data.tags || [],
    draft: Boolean(e.data.draft),
    cover: e.data.cover || '',
    body: e.body || ''
  }))
};
---

<Base
  title="Admin Control Suite"
  description="Comprehensive Admin Studio to manage content, projects, research, experience, and site configurations for chifen.is-a.dev"
  accent="#8b5cf6"
>
  <div class="min-h-screen bg-zinc-950 text-zinc-100 font-sans pb-24" id="admin-app-root">
    <!-- Top Bar -->
    <header class="sticky top-0 z-40 border-b border-zinc-800 bg-zinc-900/90 backdrop-blur-md px-4 py-3 sm:px-6">
      <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <a href={withBase('/')} class="flex items-center gap-2 group">
            <span class="font-display text-xl font-bold tracking-tight uppercase">
              Chif<span class="text-accent">3</span>n
            </span>
            <span class="rounded bg-accent/20 px-2 py-0.5 text-[11px] font-mono font-semibold text-accent border border-accent/30">
              STUDIO ADMIN
            </span>
          </a>
          <span class="hidden md:inline-block text-xs text-zinc-500">|</span>
          <div class="hidden sm:flex items-center gap-2 text-xs font-mono text-zinc-400">
            <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span id="storage-status-indicator">Storage: Local Engine</span>
          </div>
        </div>

        <div class="flex items-center gap-2.5">
          <button
            id="btn-export-backup"
            type="button"
            class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-700 bg-zinc-800/80 px-3 py-1.5 text-xs font-semibold text-zinc-200 transition-colors hover:bg-zinc-700 hover:text-white"
            title="Download full JSON snapshot of all custom data"
          >
            <svg class="w-3.5 h-3.5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            Export Backup
          </button>

          <label
            for="input-import-backup"
            class="inline-flex cursor-pointer items-center gap-1.5 rounded-lg border border-zinc-700 bg-zinc-800/80 px-3 py-1.5 text-xs font-semibold text-zinc-200 transition-colors hover:bg-zinc-700 hover:text-white"
            title="Upload previously exported JSON backup"
          >
            <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
            </svg>
            Import Backup
            <input type="file" id="input-import-backup" accept=".json" class="hidden" />
          </label>

          <a
            href={withBase('/')}
            target="_blank"
            class="inline-flex items-center gap-1 rounded-lg bg-accent px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition-transform hover:scale-[1.02]"
          >
            <span>Live Site</span>
            <span aria-hidden="true">&rarr;</span>
          </a>

          <button
            id="btn-admin-logout"
            type="button"
            class="inline-flex items-center gap-1.5 rounded-lg border border-red-500/30 bg-red-950/30 px-2.5 py-1.5 text-xs font-semibold text-red-300 transition-colors hover:bg-red-900/50 hover:text-white"
            title="Lock Studio and Sign Out"
          >
            <svg class="w-3.5 h-3.5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
            <span>Lock</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Fullscreen Unique Password Gate for direct /admin visits -->
    <div id="admin-auth-gate" class="fixed inset-0 z-50 flex items-center justify-center bg-zinc-950 p-4">
      <div class="w-full max-w-md rounded-2xl border border-purple-500/30 bg-zinc-900/90 p-8 shadow-2xl backdrop-blur-xl text-center space-y-6">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-purple-500/10 text-purple-400 border border-purple-500/30">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
        </div>
        <div>
          <h2 class="font-display text-2xl font-bold uppercase text-white tracking-tight">Studio Admin Protection</h2>
          <p class="text-xs text-zinc-400 mt-2 leading-relaxed">
            This administration suite is password protected. Enter your unique admin password to unlock the studio dashboard.
          </p>
        </div>
        <form id="admin-gate-form" class="space-y-4 text-left">
          <div>
            <label for="admin-gate-password" class="admin-label">Unique Admin Password</label>
            <input
              type="password"
              id="admin-gate-password"
              required
              placeholder="Enter unique admin password..."
              class="admin-input text-sm"
              autocomplete="current-password"
            />
            <p id="admin-gate-error" class="hidden mt-2 text-xs text-red-400 font-medium">
              ✕ <span id="admin-gate-error-text">Incorrect admin password. Access denied.</span>
            </p>
          </div>
          <button
            type="submit"
            id="admin-gate-submit-btn"
            class="w-full rounded-xl bg-purple-600 py-2.5 text-xs font-bold text-white shadow-lg transition-transform hover:scale-[1.01] hover:bg-purple-500 disabled:opacity-50"
          >
            Unlock &amp; Enter Studio &rarr;
          </button>
          <div class="text-center pt-2">
            <a href={withBase('/')} class="text-xs text-zinc-500 hover:text-zinc-300">
              &larr; Return to public site
            </a>
          </div>
        </form>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="border-b border-zinc-800 bg-zinc-900/60 sticky top-[57px] z-30 overflow-x-auto no-scrollbar">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <nav class="flex space-x-1 py-2 text-xs font-medium" id="admin-tabs-nav" aria-label="Admin Navigation">
          <button class="admin-tab active" data-target="tab-overview">
            <span>📊 Dashboard</span>
          </button>
          <button class="admin-tab" data-target="tab-profile">
            <span>👤 Profile & Links</span>
          </button>
          <button class="admin-tab" data-target="tab-projects">
            <span>💼 Projects</span>
            <span class="count-pill" id="badge-projects-count">11</span>
          </button>
          <button class="admin-tab" data-target="tab-blog">
            <span>✍️ Blog Posts</span>
            <span class="count-pill" id="badge-blog-count">8</span>
          </button>
          <button class="admin-tab" data-target="tab-experience">
            <span>🏢 Career & Gigs</span>
            <span class="count-pill" id="badge-exp-count">8</span>
          </button>
          <button class="admin-tab" data-target="tab-education">
            <span>🎓 Education & Credentials</span>
          </button>
          <button class="admin-tab" data-target="tab-research">
            <span>🔬 Research</span>
            <span class="count-pill" id="badge-research-count">2</span>
          </button>
          <button class="admin-tab" data-target="tab-talks">
            <span>🎤 Talks</span>
            <span class="count-pill" id="badge-talks-count">3</span>
          </button>
          <button class="admin-tab" data-target="tab-story">
            <span>📖 Story Timeline</span>
            <span class="count-pill" id="badge-story-count">14</span>
          </button>
          <button class="admin-tab" data-target="tab-archive">
            <span>🖼️ Evidence Archive</span>
            <span class="count-pill" id="badge-archive-count">18</span>
          </button>
          <button class="admin-tab" data-target="tab-metrics">
            <span>📈 Verified Metrics</span>
          </button>
          <button class="admin-tab" data-target="tab-sync">
            <span>💾 Code Sync & Export</span>
          </button>
        </nav>
      </div>
    </div>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 pt-6">
      <!-- Toast Notification Container -->
      <div id="admin-toast" class="fixed top-20 right-6 z-50 transform transition-all duration-300 translate-y-[-150%] opacity-0 pointer-events-none rounded-xl border border-emerald-500/40 bg-zinc-900/95 p-4 shadow-2xl text-emerald-300 text-sm flex items-center gap-3 backdrop-blur-md">
        <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span id="toast-message">Action successful!</span>
      </div>

      <!-- TAB 1: OVERVIEW & DASHBOARD -->
      <section id="tab-overview" class="admin-tab-pane space-y-6">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-5 hover:border-zinc-700 transition-colors">
            <div class="flex items-center justify-between text-zinc-400">
              <span class="text-xs uppercase tracking-wider font-semibold">Active Ventures</span>
              <span class="h-2 w-2 rounded-full bg-purple-500"></span>
            </div>
            <p class="mt-3 text-3xl font-display font-bold text-white">4</p>
            <p class="mt-1 text-xs text-zinc-400">LifeDrop, CoastClear, INKWAVE, LinkedIn Local</p>
          </div>

          <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-5 hover:border-zinc-700 transition-colors">
            <div class="flex items-center justify-between text-zinc-400">
              <span class="text-xs uppercase tracking-wider font-semibold">Postgraduate Status</span>
              <span class="h-2 w-2 rounded-full bg-cyan-400"></span>
            </div>
            <p class="mt-3 text-xl font-display font-bold text-cyan-300">COLTECH UBa</p>
            <p class="mt-1 text-xs text-zinc-400">M.Tech Data Science (2026–Present)</p>
          </div>

          <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-5 hover:border-zinc-700 transition-colors">
            <div class="flex items-center justify-between text-zinc-400">
              <span class="text-xs uppercase tracking-wider font-semibold">Engineering Path</span>
              <span class="h-2 w-2 rounded-full bg-amber-400"></span>
            </div>
            <p class="mt-3 text-xl font-display font-bold text-amber-300">Self-Taught</p>
            <p class="mt-1 text-xs text-zinc-400">Autodidactic Dev + Bedside Clinical Grit</p>
          </div>

          <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-5 hover:border-zinc-700 transition-colors">
            <div class="flex items-center justify-between text-zinc-400">
              <span class="text-xs uppercase tracking-wider font-semibold">Verified Metrics</span>
              <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
            </div>
            <p class="mt-3 text-3xl font-display font-bold text-emerald-400" id="dash-metrics-count">14</p>
            <p class="mt-1 text-xs text-zinc-400">387 study respondents, 92.4% rate, &gt;95% DHIS2</p>
          </div>
        </div>

        <!-- Banner for recent update -->
        <div class="rounded-2xl border border-purple-900/40 bg-purple-950/20 p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="rounded-full bg-purple-500/20 px-2.5 py-0.5 text-xs font-semibold text-purple-300 border border-purple-500/30">
                Latest Academic & Career Sync
              </span>
              <span class="text-xs text-zinc-400">October 2026</span>
            </div>
            <h3 class="text-base font-semibold text-white">Master of Technology in Data Science & Self-Trained Engineering</h3>
            <p class="text-xs text-zinc-300 max-w-2xl leading-relaxed">
              Updated: College of Technology (COLTECH), The University of Bamenda (UBa) Data Science Masters, explicit self-taught software background, old gigs categorized as voluntary, and GitHub profile set to <code class="font-mono text-cyan-300">https://github.com/CHIF3N</code>.
            </p>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <button class="btn btn-sm btn-accent" onclick="document.querySelector('[data-target=\'tab-profile\']').click()">
              Edit Profile
            </button>
            <button class="btn btn-sm border border-zinc-700 bg-zinc-800 text-zinc-200" onclick="document.querySelector('[data-target=\'tab-projects\']').click()">
              Manage Work
            </button>
          </div>
        </div>

        <!-- Quick Summary Table -->
        <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6">
          <h3 class="text-sm font-bold uppercase tracking-wider text-zinc-400 mb-4">Site Architecture & Direct Admin Control</h3>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 text-xs">
            <div class="flex items-start gap-3 p-3 rounded-lg bg-zinc-900/80 border border-zinc-800">
              <span class="text-lg">⚡</span>
              <div>
                <strong class="text-white block font-medium">Zero-Code Updates</strong>
                <span class="text-zinc-400">Add, edit, or delete items right in this studio. Changes take effect across all pages.</span>
              </div>
            </div>
            <div class="flex items-start gap-3 p-3 rounded-lg bg-zinc-900/80 border border-zinc-800">
              <span class="text-lg">🔒</span>
              <div>
                <strong class="text-white block font-medium">Automatic Local Persistence</strong>
                <span class="text-zinc-400">Edits are securely stored in your browser and automatically synchronized with the frontend.</span>
              </div>
            </div>
            <div class="flex items-start gap-3 p-3 rounded-lg bg-zinc-900/80 border border-zinc-800">
              <span class="text-lg">📦</span>
              <div>
                <strong class="text-white block font-medium">Full Backup & Code Export</strong>
                <span class="text-zinc-400">Export clean JSON or git-ready TypeScript files whenever you want to commit to GitHub.</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- TAB 2: PROFILE & IDENTITY -->
      <section id="tab-profile" class="admin-tab-pane hidden space-y-6">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-lg font-bold text-white">Site Identity & Core Profile</h2>
            <p class="text-xs text-zinc-400">Manage names, brand, elevator pitch, GitHub, contacts, and public metadata.</p>
          </div>
          <button id="btn-save-profile" type="button" class="btn btn-sm btn-accent">
            Save Profile
          </button>
        </div>

        <form id="form-site-profile" class="grid gap-5 md:grid-cols-2 rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6">
          <div>
            <label class="admin-label">Full Legal Name</label>
            <input type="text" name="name" id="field-prof-name" class="admin-input" />
          </div>

          <div>
            <label class="admin-label">Display Name (Short)</label>
            <input type="text" name="displayName" id="field-prof-displayName" class="admin-input" />
          </div>

          <div>
            <label class="admin-label">Brand Persona</label>
            <input type="text" name="brand" id="field-prof-brand" class="admin-input" />
          </div>

          <div>
            <label class="admin-label">Creative Identity / Alias</label>
            <input type="text" name="creativeIdentity" id="field-prof-creativeIdentity" class="admin-input" />
          </div>

          <div class="md:col-span-2">
            <label class="admin-label">Professional Role Headline</label>
            <input type="text" name="role" id="field-prof-role" class="admin-input" />
          </div>

          <div class="md:col-span-2">
            <label class="admin-label">Site Tagline</label>
            <textarea name="tagline" id="field-prof-tagline" rows="2" class="admin-input"></textarea>
          </div>

          <div class="md:col-span-2">
            <label class="admin-label">Elevator Pitch / Bio Summary</label>
            <textarea name="pitch" id="field-prof-pitch" rows="3" class="admin-input"></textarea>
          </div>

          <div>
            <label class="admin-label">GitHub URL</label>
            <input type="url" name="github" id="field-prof-github" class="admin-input text-cyan-300 font-mono text-xs" />
          </div>

          <div>
            <label class="admin-label">LinkedIn URL</label>
            <input type="url" name="linkedin" id="field-prof-linkedin" class="admin-input font-mono text-xs" />
          </div>

          <div>
            <label class="admin-label">Primary Email</label>
            <input type="email" name="email" id="field-prof-email" class="admin-input font-mono text-xs" />
          </div>

          <div>
            <label class="admin-label">WhatsApp Contact Number</label>
            <input type="text" name="whatsapp" id="field-prof-whatsapp" class="admin-input font-mono text-xs" />
          </div>

          <div>
            <label class="admin-label">Geographic Location</label>
            <input type="text" name="location" id="field-prof-location" class="admin-input" />
          </div>

          <div>
            <label class="admin-label">INKWAVE Platform URL</label>
            <input type="url" name="inkwave" id="field-prof-inkwave" class="admin-input font-mono text-xs" />
          </div>

          <div class="md:col-span-2">
            <label class="admin-label">Software Background Specification</label>
            <input type="text" name="softwareBackground" id="field-prof-softwareBackground" class="admin-input" placeholder="e.g. 100% self-trained software engineer..." />
          </div>

          <!-- Admin Security & Password Control Card -->
          <div class="md:col-span-2 rounded-xl border border-purple-500/30 bg-purple-950/20 p-5 mt-4">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-2">
                <span class="flex h-6 w-6 items-center justify-center rounded-md bg-purple-500/20 text-purple-400">
                  🔒
                </span>
                <h4 class="text-sm font-bold text-white uppercase tracking-wider">Admin Security &amp; Custom Password</h4>
              </div>
              <span class="text-[11px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
                SHA-256 Protected
              </span>
            </div>
            <p class="text-xs text-zinc-300 mb-4 leading-relaxed">
              Set your own custom unique admin password. It will be cryptographically hashed with SHA-256 and used to unlock the Admin Studio from both the footer button and direct URL.
            </p>
            <div class="grid gap-3 sm:grid-cols-3 items-end">
              <div>
                <label class="admin-label">New Unique Password</label>
                <input type="password" id="input-new-admin-pass" placeholder="Enter new custom password..." class="admin-input text-xs" />
              </div>
              <div>
                <label class="admin-label">Confirm New Password</label>
                <input type="password" id="input-confirm-admin-pass" placeholder="Confirm password..." class="admin-input text-xs" />
              </div>
              <div class="flex gap-2">
                <button type="button" id="btn-update-admin-pass" class="btn btn-sm btn-accent w-full justify-center">
                  Update Password
                </button>
                <button type="button" id="btn-reset-admin-pass" class="btn btn-sm border border-zinc-700 bg-zinc-800 text-zinc-300 hover:text-white" title="Reset to default password">
                  Reset
                </button>
              </div>
            </div>
            <p id="admin-pass-status" class="text-xs mt-2 hidden"></p>
          </div>
        </form>
      </section>

      <!-- TAB 3: PROJECTS & WORK -->
      <section id="tab-projects" class="admin-tab-pane hidden space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div>
            <h2 class="text-lg font-bold text-white">Work & Project Portfolio</h2>
            <p class="text-xs text-zinc-400">Add, edit, or delete production software, prototypes, and clinical systems.</p>
          </div>
          <button id="btn-add-project" type="button" class="btn btn-sm btn-accent inline-flex items-center gap-1.5">
            <span>+ Add New Project</span>
          </button>
        </div>

        <!-- Search Bar -->
        <div class="flex items-center gap-3">
          <input
            type="text"
            id="search-projects"
            placeholder="Search projects by title, stack, status, or tag..."
            class="admin-input max-w-md text-xs"
          />
        </div>

        <!-- Projects Grid / Table -->
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3" id="projects-list-container">
          <!-- Injected via JavaScript -->
        </div>
      </section>

      <!-- TAB 4: BLOG & WRITING -->
      <section id="tab-blog" class="admin-tab-pane hidden space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div>
            <h2 class="text-lg font-bold text-white">Blog & Technical Articles</h2>
