---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';

const sections = [
  {
    title: 'The Journey Timeline',
    href: '/journey',
    badge: '14 Chapters',
    icon: '📖',
    accent: '#8b5cf6',
    description: 'The complete documentary trajectory of The Nurse Who Codes — from rural clinical wards and autodidactic coding to founding LifeDrop and keynoting PyCon 2026.',
    highlights: ['COVID-19 Remote Learning', 'Ayodah Blood Network', 'Buea Regional Hospital', 'PyCon Cameroon Keynote'],
  },
  {
    title: 'Scientific & Clinical AI Research',
    href: '/research',
    badge: 'Empirical Studies',
    icon: '🔬',
    accent: '#08b9d4',
    description: 'Empirical clinical informatics, AI readiness assessments at Buea Regional Hospital, and predictive statistical analyses of maternal health risks.',
    highlights: ['387 Healthcare Professionals Surveyed', '92.4% Response Rate', '808 Antenatal Records Evaluated'],
  },
  {
    title: 'Career & Clinical Tenures',
    href: '/experience',
    badge: 'Tenures & Gigs',
    icon: '🏢',
    accent: '#10b981',
    description: 'Full chronological record of health data management, startup leadership, public health registry audits, and clinical volunteer mandates.',
    highlights: ['LifeDrop Lead Architect', 'CoastClear Lead Engineer', 'Kumba South PMTCT Lead', 'INKWAVE CEO'],
  },
  {
    title: 'Technical Capabilities & Services',
    href: '/services',
    badge: 'Advisory & Builds',
    icon: '⚡',
    accent: '#2fd643',
    description: 'Commercial product engineering, low-bandwidth WhatsApp automations, clinical database management, and offline-first field applications.',
    highlights: ['Health Product Builds', 'WhatsApp Bots & MoMo', 'DHIS2 Reporting Audits', 'Offline-First SQLite'],
  },
  {
    title: 'Evidence Archive & Artifacts',
    href: '/archive',
    badge: '18+ Artifacts',
    icon: '🖼️',
    accent: '#f59e0b',
    description: 'Photographic evidence, hardware experiments, hospital ward clinical training, certificates, and event recordings verifying every claim on this site.',
    highlights: ['Ward Clinical Practicums', 'Hardware Prototyping', 'Hackathon Awards', 'Speaking Photos'],
  },
  {
    title: 'Master CV & Professional Record',
    href: '/cv',
    badge: 'Fanaka Verified',
    icon: '🎯',
    accent: '#8b5cf6',
    description: 'Comprehensive curriculum vitae detailing clinical qualifications (BSc Nursing Science), postgraduate studies (M.Tech Data Science), and technical skills.',
    highlights: ['Effort vs Value Bullets', 'Academic Degrees', 'Verifiable Honors', 'Clinical Competencies'],
  },
  {
    title: 'Work & Systems Portfolio',
    href: '/work',
    badge: '11 Systems',
    icon: '💼',
    accent: '#ff083d',
    description: 'Complete catalogue of production software, prototypes, and open-source automations built for environments with zero margin for failure.',
    highlights: ['LifeDrop', 'CoastClear', 'MORIA & Aunty Queen', 'LockedIn', 'Ayodah'],
  },
  {
    title: 'Technical Writing & Articles',
    href: '/blog',
    badge: 'Deep Dives',
    icon: '✍️',
    accent: '#8b5cf6',
    description: 'Long-form engineering essays on message queues under blackout conditions, FHIR records over WhatsApp, and zero-float pediatric dosage engines.',
    highlights: ['WhatsApp Cloud API', 'Resilient Message Queues', 'Offline Sync Patterns', 'Clinical Chatbots'],
  },
  {
    title: 'Speaking, Keynotes & Demos',
    href: '/talks',
    badge: 'Conferences',
    icon: '🎤',
    accent: '#08b9d4',
    description: 'Conference slide decks, keynotes, and live architecture walkthroughs recorded on 2G and 3G connections to demonstrate real resilience.',
    highlights: ['PyCon Cameroon 2026', 'LifeDrop End-to-End Demo', 'CoastClear Architecture Walkthrough'],
  },
  {
    title: 'Site Search & Discovery',
    href: '/search',
    badge: 'Full-Text Index',
    icon: '🔍',
    accent: '#08b9d4',
    description: 'Instant search across every article, project, research document, timeline chapter, and speaking presentation on chifen.is-a.dev.',
    highlights: ['Fast Client-Side Search', 'Keyboard Accessible', 'Tags & Topics'],
  },
  {
    title: 'Admin Studio & Media Library',
    href: '/admin',
    badge: 'CMS & Media',
    icon: '⚙️',
    accent: '#8b5cf6',
    description: 'Protected studio dashboard to manage content, talks, verified evidence metrics, and visual storytelling media assets.',
    highlights: ['Visual Media Library', 'Hero Image Swapper', 'Content Overrides', 'Instant Sync'],
  },
];
---

<Base
  title="More Content & Directory"
  description="Comprehensive index to all secondary content of Chifen Sama Nduma's portfolio — Journey, Clinical AI Research, Evidence Archive, Experience, Services, and Systems."
  accent="#08b9d4"
>
  <main class="shell pt-12 pb-20 sm:pt-16 sm:pb-24">
    <!-- Header -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-accent font-semibold mb-3">
        <span>Site Index &bull; Secondary Directory</span>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold uppercase tracking-tight text-ink leading-[0.95]">
        More Content.
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate leading-relaxed">
        Beyond the homepage trailer lies the full documentary record: 14 chapters of personal trajectory, empirical clinical research, photographic proof, service offerings, and technical deep-dives.
      </p>
    </div>

    <!-- Directory Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {
        sections.map((section) => (
          <a
            href={withBase(section.href)}
            class="group relative flex flex-col justify-between p-7 rounded-2xl border border-line bg-paper hover:border-ink/20 hover:shadow-xl transition-all duration-300"
          >
            <div>
              <div class="flex items-center justify-between gap-3 mb-4">
                <span class="text-2xl">{section.icon}</span>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold bg-paper-dim text-slate border border-line">
                  {section.badge}
                </span>
              </div>

              <h2 class="font-display text-2xl font-bold text-ink uppercase tracking-tight group-hover:text-accent transition-colors flex items-center gap-1.5">
                <span>{section.title}</span>
                <span aria-hidden="true" class="text-sm transition-transform group-hover:translate-x-1">&rarr;</span>
              </h2>

              <p class="mt-3 text-sm text-slate leading-relaxed">
                {section.description}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-line/60">
              <div class="flex flex-wrap gap-x-2 gap-y-1 text-xs font-mono text-slate-light">
                {
                  section.highlights.map((h, i) => (
                    <span>
                      {i > 0 && <span class="mr-1.5 text-line">&bull;</span>}
                      {h}
                    </span>
                  ))
                }
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <!-- Quick Footer Banner -->
    <div class="mt-14 p-8 rounded-2xl border border-line bg-paper-dim flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h3 class="font-display text-xl font-bold text-ink uppercase">Looking for something specific?</h3>
        <p class="text-xs text-slate mt-1">Use full-text search or reach out directly via WhatsApp and email.</p>
      </div>
      <div class="flex items-center gap-3">
        <a href={withBase('/search')} class="btn btn-secondary btn-sm">
          Instant Search &rarr;
        </a>
        <a href={withBase('/contact')} class="btn btn-accent btn-sm">
          Get in Touch &rarr;
        </a>
      </div>
    </div>
  </main>
</Base>
