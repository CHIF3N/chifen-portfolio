---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/photos/chifen-portrait.jpg';
import { site } from '../lib/site';
import { withBase } from '../lib/url';

/*
 * Three-Pillar Fanaka Narrative
 *
 * Pillar 1: Clinical Domain Insider  — the nursing background as structural advantage
 * Pillar 2: African Technical Resilience — building for the real constraints
 * Pillar 3: Community Architecture — what gets built when the founder stays
 */

const journey = [
  {
    year: '2020',
    title: 'Co-founded Ayodah',
    body: 'Built a blood donor coordination platform that grew to 400+ registered donors, 310 mediated donations, and partnerships with 3 hospitals and 5+ NGOs across Cameroon.',
  },
  {
    year: '2022',
    title: 'Won the Silicon Mountain Challenge',
    body: "Ayodah took the prize at Cameroon's premier startup competition. The network was real: 400 donors, 310 donations, 3 hospitals. The app died at the install screen.",
  },
  {
    year: '2022 – 2024',
    title: 'HND Nursing',
    body: 'Clinical training at Gracious Higher Institute of Excellence. Best Overall Student, Best Nursing Student. Ran innovation projects in parallel — not after.',
  },
  {
    year: '2023',
    title: 'Co-founded INKWAVE',
    body: 'Launched INKWAVE (https://inkwave-cm.vercel.app/) as a digital storytelling agency and developer advocacy studio driving technical communication across Central and West Africa.',
  },
  {
    year: '2024 – 2026',
    title: 'BSc Nursing & the AI research',
    body: 'Top-up BSc through GHIE, mentored by the University of Bamenda. Ran a 387-respondent cross-sectional study at Buea Regional Hospital on whether health workers are ready for AI in clinical decision-making. 92.4% response rate.',
  },
  {
    year: '2025 – 2026',
    title: 'District Data Manager & PMTCT Departmental Head',
    body: 'Concluded mandate as District Data Manager for Kumba South Health District and PMTCT programme head. Automated DHIS2 local-to-cloud facility sync workflows, audited clinical registries, and improved data completeness to >95%.',
  },
  {
    year: '2026',
    title: 'Launched LifeDrop',
    body: "Rebuilt the Ayodah network inside WhatsApp — where families already ask for help. Placed third in the MTN YaMo Pitch Season 4. Pilot target: 1,000 donors and 200 matches in Buea's first six months.",
  },
  {
    year: '2026',
    title: 'Speaker @ PyCon & UbuCon Cameroon',
    body: 'Delivered talks on building health technology in low-bandwidth environments and on open-source tools for clinical data management in Africa.',
  },
  {
    year: 'Next',
    title: "Master's in health technology",
    body: 'Postgraduate study in health technology or digital health, peer-reviewed publication, and health-tech ventures that work across more of the continent.',
  },
];

const awards = [
  'Best Overall HND Student',
  'Best Nursing Student, HND',
  'Innovative Excellence Award',
  'Best Creative Thinker',
  'Proactive Student Award',
  '3rd Place, MTN YaMo Pitch Season 4 (LifeDrop)',
  'Winner, Silicon Mountain Challenge 2022 (Ayodah)',
];

const certifications = [
  { name: 'Certificate of Training Completion', issuer: 'The Tony Elumelu Foundation' },
  { name: 'Certificate of Business Management Training', issuer: 'The Tony Elumelu Foundation' },
  { name: 'UNLEASH Hack Talent, Certificate of Participation', issuer: 'UNLEASH' },
  { name: 'Medical Abortion Course for Providers', issuer: 'International Planned Parenthood Federation' },
  { name: 'Teaching English as a Foreign Language (TEFL)', issuer: 'Teacher Record' },
  { name: 'Advancing the Role of Women in Politics', issuer: 'Regional Leadership Center East Africa' },
];

const skills = [
  {
    group: 'Clinical nursing',
    items: ['Emergency care', 'PMTCT workflows', 'Clinical research', 'Health education', 'Patient data management'],
  },
  {
    group: 'Research and data',
    items: ['SPSS', 'KoboCollect', 'PRISMA methodology', 'Data analysis', 'Scientific writing'],
  },
  {
    group: 'Engineering',
    items: [
      'JavaScript / TypeScript',
      'Python',
      'React Native / Expo',
      'Next.js',
      'Astro',
      'Tailwind CSS',
      'WhatsApp Cloud API',
      'Firebase / Firestore',
      'scikit-learn',
      'n8n automation',
      'Git / GitHub',
      'Figma',
    ],
  },
  {
    group: 'Communication',
    items: ['Technical writing', 'Content strategy', 'Brand development', 'SEO', 'English & French'],
  },
];

const pillars = [
  {
    number: '01',
    title: 'Clinical Domain Insider',
    body: "I trained and worked as a registered nurse before I learned to build software. That matters because the gap between what a health product claims to do and what actually happens in a ward is almost always invisible to people who have never worked in one. I have seen a blood transfusion delayed because nobody could find a compatible donor in a city that had one. I have seen a form that does not ask the right question. I have seen what fails at two in the morning and what holds. That is not user research. It is structural knowledge, and it changes what gets built.",
  },
  {
    number: '02',
    title: 'African Technical Resilience',
    body: "Most health software is built for conditions that do not exist in most of the world: reliable power, fast internet, smartphones with storage to spare, users who have time to learn an interface. I build for what is actually there. Low data. Unreliable power. A phone rather than a laptop. A language a government form does not offer. That is not a constraint I work around. It is a design specification I start from.",
  },
  {
    number: '03',
    title: 'Community Architecture',
    body: "Ayodah built a real network — 400 donors, 3 hospitals, 5 NGOs — and the app still died at the install screen. That is the lesson LifeDrop is built on. Coordination infrastructure only works if it lives where people already communicate. The 2 a.m. message asking for a blood donor was never going to stop. What changed was where I answered it.",
  },
];
---

<Base
  title="About"
  description="Chifen Sama Nduma is a registered nurse and software engineer in Buea, Cameroon, building health technology for low-resource settings."
>
  <!-- Header -->
  <section class="mx-auto max-w-6xl px-5 pt-14 pb-16 sm:px-8 sm:pt-20">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16">
      <div>
        <h1 class="font-display text-4xl font-semibold sm:text-5xl">About</h1>

        <div class="mt-8 space-y-5 text-lg leading-relaxed text-slate">
          <p>
            I am a registered nurse and software engineer. I work at the intersection of medicine,
            technology, and the real constraints of health delivery in Cameroon. The combination is
            not incidental. It is the point.
          </p>
          <p>
            Nursing showed me the front line: what a ward runs out of, what a form does not ask,
            what breaks at two in the morning and what holds. Software gave me a way to fix some of
            it rather than chart it and move on. What I build now sits between the two: blood donor
            networks, clinical data tools, WhatsApp health services, and research that holds up
            under scrutiny.
          </p>
          <p>
            Following the conclusion of my mandate as District Data Manager and PMTCT Head for Kumba South
            Health District, my engineering focus is on LifeDrop's WhatsApp emergency dispatch architecture,
            CoastClear's conservation logistics, and <a href="https://inkwave-cm.vercel.app/" target="_blank" rel="noopener noreferrer" class="font-medium text-accent underline underline-offset-2 hover:text-ink transition-colors">INKWAVE's ↗</a> technical storytelling. Three lanes, one direction.
          </p>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={withBase('/cv')} class="btn btn-accent btn-sm">
            View full CV
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a href={withBase('/work')} class="btn btn-ghost btn-sm">
            See the work
          </a>
        </div>
      </div>

      <div class="lg:pt-20">
        <div class="overflow-hidden rounded-2xl">
          <Image
            src={portrait}
            alt="Chifen Sama Nduma, registered nurse and software engineer, based in Buea, Cameroon."
            widths={[400, 640]}
            sizes="(max-width: 1024px) 80vw, 32vw"
            loading="lazy"
            decoding="async"
            class="w-full object-cover"
          />
        </div>
        <p class="mt-4 text-sm text-slate-light">
          Chifen Sama Nduma. Registered nurse, software engineer, {site.location}.
        </p>
      </div>
    </div>
  </section>

  <!-- Three Pillars -->
  <section class="border-y border-ink/10 bg-paper-dim/60">
    <div class="mx-auto max-w-4xl px-5 py-16 sm:px-8 sm:py-20">
      <p class="eyebrow text-accent" data-reveal>How I work</p>
      <h2 class="mt-4 font-display text-3xl font-semibold sm:text-4xl" data-reveal>
        Three things that shape everything I build
      </h2>
      <ol class="mt-12 space-y-10">
        {
          pillars.map((pillar, i) => (
            <li
              class="grid gap-4 border-l-4 border-accent pl-8 sm:grid-cols-[auto_1fr] sm:gap-8"
              data-reveal
              style={`--reveal-delay:${i * 80}ms`}
            >
              <span class="font-display text-5xl font-bold text-accent/20 leading-none">
                {pillar.number}
              </span>
              <div>
                <h3 class="font-display text-xl font-semibold">{pillar.title}</h3>
                <p class="mt-3 leading-relaxed text-slate">{pillar.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Off duty -->
  <section class="mx-auto max-w-4xl px-5 pb-4 pt-16 sm:px-8">
    <div
      class="rounded-2xl border border-accent/30 bg-accent/5 px-7 py-8 sm:px-9 sm:py-10"
      data-reveal
    >
      <h2 class="font-display text-xs font-semibold tracking-widest text-accent uppercase">
        Off duty
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-slate">
        Chess, anime, picking up a new language for the exercise, music, and any excuse to travel
        somewhere new. I am messy about process and serious about outcomes. Not much patience for
        rules without reasons behind them. Fairly convinced this can be done at a much larger scale
        than last time.
      </p>
    </div>
  </section>

  <!-- Journey timeline -->
  <section class="border-y border-ink/10 bg-paper-dim/60">
    <div class="mx-auto max-w-4xl px-5 py-16 sm:px-8 sm:py-20">
      <h2 class="font-display text-3xl font-semibold sm:text-4xl" data-reveal>The route here</h2>

      <ol class="mt-10 space-y-0">
        {
          journey.map((item, i) => (
            <li
              class="relative border-l border-ink/15 pb-9 pl-7 last:pb-0 sm:pl-9"
              data-reveal
              style={`--reveal-delay:${i * 60}ms`}
            >
              <span class="absolute top-1.5 -left-[5px] h-2.5 w-2.5 rounded-full bg-accent" />
              <p class="font-display text-sm font-semibold tracking-wider text-accent uppercase">
                {item.year}
              </p>
              <h3 class="mt-1.5 font-display text-xl font-semibold">{item.title}</h3>
              <p class="mt-2 leading-relaxed text-slate">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Awards -->
  <section class="mx-auto max-w-4xl px-5 py-16 sm:px-8 sm:py-20">
    <h2 class="font-display text-3xl font-semibold sm:text-4xl text-zinc-900 dark:text-zinc-100" data-reveal>Awards</h2>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        awards.map((award, i) => (
          <li
            class="flex items-center gap-3 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white/70 dark:bg-zinc-900/60 px-5 py-4"
            data-reveal
            style={`--reveal-delay:${i * 50}ms`}
          >
            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
            <span class="font-display font-medium text-zinc-900 dark:text-zinc-100">{award}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Certifications -->
  <section class="border-t border-ink/10 bg-paper-dim/60">
    <div class="mx-auto max-w-4xl px-5 py-16 sm:px-8 sm:py-20">
      <h2 class="font-display text-3xl font-semibold sm:text-4xl text-zinc-900 dark:text-zinc-100" data-reveal>Certifications</h2>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {
          certifications.map((cert, i) => (
            <li
              class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white/70 dark:bg-zinc-900/60 px-5 py-4"
              data-reveal
              style={`--reveal-delay:${i * 50}ms`}
            >
              <p class="font-display font-medium text-zinc-900 dark:text-zinc-100">{cert.name}</p>
              <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">{cert.issuer}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Skills -->
  <section class="border-t border-ink/10">
    <div class="mx-auto max-w-4xl px-5 py-16 sm:px-8 sm:py-20">
      <h2 class="font-display text-3xl font-semibold sm:text-4xl" data-reveal>What I work with</h2>
      <div class="mt-10 grid gap-9 sm:grid-cols-2">
        {
          skills.map((section, i) => (
            <div data-reveal style={`--reveal-delay:${i * 60}ms`}>
              <h3 class="font-display text-xs font-semibold tracking-widest text-accent uppercase">
                {section.group}
              </h3>
              <ul class="mt-4 flex flex-wrap gap-2">
                {section.items.map((item) => (
                  <li class="rounded-full border border-ink/12 bg-white/60 px-3 py-1.5 text-sm text-slate">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Get in touch -->
  <section class="mx-auto max-w-4xl px-5 py-16 text-center sm:px-8 sm:py-20">
    <h2 class="font-display text-3xl font-semibold sm:text-4xl" data-reveal>Get in touch</h2>
    <p class="mx-auto mt-3 max-w-lg text-slate" data-reveal>
      WhatsApp is fastest. Or send an email — I read them all.
    </p>
    <div class="mt-7 flex flex-wrap justify-center gap-3" data-reveal>
      <a
        href={withBase('/contact')}
        class="group inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 font-medium text-paper transition-transform duration-200 hover:-translate-y-0.5"
      >
        Get in touch
        <span class="transition-transform duration-200 group-hover:translate-x-0.5">&rarr;</span>
      </a>
      <a
        href={withBase('/cv')}
        class="group inline-flex items-center gap-2 rounded-full border border-ink/20 px-6 py-3 font-medium transition-all duration-200 hover:border-accent hover:text-accent"
      >
        View CV
      </a>
    </div>
  </section>
</Base>
