---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';

/*
 * Interactive Experience Timeline
 *
 * Three track types, distinguished visually:
 *   clinical   — Clinical & Data Leadership
 *   software   — Software Engineering
 *   community  — Community Architecture & Stewardship
 *
 * Each milestone records:
 *   - Operational context (the real environment, constraints)
 *   - Effort  (the technical action, architectural choices)
 *   - Value   (concrete outcomes, metrics, system results)
 *   - Stack   (the exact tools and protocols)
 *
 * Fanaka rule: no entry ships without at least one concrete metric or
 * verifiable outcome in the Value field.
 */

type Track = 'clinical' | 'software' | 'community';

interface Milestone {
  id: string;
  track: Track;
  role: string;
  org: string;
  orgUrl?: string;
  location: string;
  period: string;
  current?: boolean;
  context: string;
  effort: string[];
  value: string[];
  stack: string[];
}

const milestones: Milestone[] = [
  {
    id: 'district-data-manager',
    track: 'clinical',
    role: 'District Data Manager & PMTCT Head',
    org: 'Kumba South Health District',
    location: 'South West Region, Cameroon',
    period: '2025 – Present',
    current: true,
    context:
      'Managing health information architecture across high-burden clinical districts where network degradation is routine. Responsible for PMTCT programme data integrity from antenatal enrolment through 18-month infant outcome across multiple peripheral facilities.',
    effort: [
      'Designed and enforced standardised monthly reporting pipelines for all district facilities, replacing ad-hoc paper-to-spreadsheet workflows.',
      'Built patient cohort tracking from first antenatal visit to 18-month postnatal outcome — the full PMTCT cascade — with no data drop-off between facilities.',
      'Coordinated inter-facility data reconciliation to eliminate duplicate records and close reporting gaps before national DHIS2 submission deadlines.',
    ],
    value: [
      'Cut district reporting submission lag from 5 days to same-day, eliminating national reporting penalties.',
      'Maintained zero missed PMTCT cohort entries across all enrolled facilities for the first reporting cycle.',
    ],
    stack: ['DHIS2', 'PMTCT Workflows', 'Microsoft Excel', 'Clinical Data Management', 'PRISMA'],
  },
  {
    id: 'lifedrop',
    track: 'software',
    role: 'Founder & Systems Architect',
    org: 'LifeDrop',
    orgUrl: 'https://lifedropcam.netlify.app/',
    location: 'Buea / Yaoundé, Cameroon',
    period: '2026 – Present',
    current: true,
    context:
      'Blood supply shortages in Cameroonian hospitals can be fatal within hours. LifeDrop routes urgent donor requests through WhatsApp — the highest-penetration communication channel in the region — using webhooks that survive 2G packet loss and MTN MoMo payment latency.',
    effort: [
      'Architected asynchronous WhatsApp Cloud API webhooks with idempotent request queues to handle duplicate deliveries on degraded connections.',
      'Built a donor-matching heuristic scoring compatibility (blood type), proximity, and recency of last donation — dispatching to the nearest eligible donor within seconds.',
      'Integrated MTN Mobile Money API for optional donor incentive payments, with retry logic that handles MoMo\'s 30s+ response latency.',
      'Implemented English/French bilingual conversational flows with a no-install constraint: all interactions happen inside WhatsApp, requiring zero app download.',
    ],
    value: [
      'Enabled automated donor dispatch across Cameroonian urban centres during active blood shortages.',
      'Rebuilt the Ayodah network (400+ donors, 310 mediated donations) into a zero-installation platform that survives connectivity degradation.',
      '3rd Place, MTN YaMo Pitch Competition Season 4 — the largest startup competition in Central Africa.',
    ],
    stack: ['WhatsApp Cloud API', 'JavaScript', 'Node.js', 'MTN MoMo API', 'n8n', 'Webhook Queues'],
  },
  {
    id: 'ayodah',
    track: 'software',
    role: 'Co-founder',
    org: 'Ayodah Blood Donor Platform',
    location: 'Buea, Cameroon',
    period: '2020 – 2026',
    context:
      'First attempt at structured blood donor coordination in Cameroon. Built to solve the immediate problem: hospitals had no way to locate willing donors outside their existing contact lists.',
    effort: [
      'Co-built a blood donor registration and matching platform from zero — no prior team, no external funding, no existing donor database.',
      'Grew the donor network through direct hospital partnerships and community outreach, not algorithmic growth.',
    ],
    value: [
      '400+ registered donors, 310 mediated donations, 3 partner hospitals, 5+ NGO partnerships.',
      'Won Silicon Mountain Challenge 2022 — Cameroon\'s premier startup competition.',
      'Identified the root failure: native mobile app install friction. Led directly to LifeDrop\'s WhatsApp-native rebuild.',
    ],
    stack: ['Mobile App', 'Health-tech', 'Community Outreach'],
  },
  {
    id: 'coastclear',
    track: 'software',
    role: 'Lead Engineer',
    org: 'CoastClear',
    location: 'Cameroon',
    period: '2024 – Present',
    context:
      'AI-powered waste coordination for coastal communities. The real challenge is multilingual UX — English, French, and Cameroonian Pidgin — and classifying waste from low-resolution smartphone photos taken in poor lighting.',
    effort: [
      'Built a multilingual UI supporting three languages with dynamic locale switching at runtime.',
      'Integrated AI-based photographic waste classification using a model trained on a synthetic dataset built to compensate for the absence of labelled coastal African waste images.',
      'Connected classification output to community cleanup dispatch workflows, routing tasks to local volunteers.',
    ],
    value: [
      'Enabled automated waste classification and community cleanup coordination in three languages.',
      'Synthetic training dataset addressed the absence of regionally representative waste imagery.',
    ],
    stack: ['Next.js', 'Mapbox', 'Supabase', 'AI Classification', 'Multilingual UI', 'Synthetic Data'],
  },
  {
    id: 'ai-clinical-research',
    track: 'clinical',
    role: 'Principal Investigator',
    org: 'BSc Nursing Dissertation, Buea Regional Hospital',
    location: 'Buea, Cameroon',
    period: '2024 – 2026',
    context:
      'A cross-sectional study on AI readiness among clinical health workers. Not a desk study — 387 health workers surveyed at point of care, across all departments of Buea Regional Hospital.',
    effort: [
      'Designed the research instrument, ethical approval process, and data collection protocol for a 387-respondent cross-sectional study.',
      'Conducted fieldwork across hospital departments, achieving a 92.4% response rate without incentives.',
      'Analysed data using SPSS with PRISMA-compliant systematic review methods.',
    ],
    value: [
      '387 respondents, 92.4% response rate — statistically significant sample.',
      'Findings contribute to evidence base for AI clinical decision support deployment policy in Cameroon.',
    ],
    stack: ['SPSS', 'KoboCollect', 'PRISMA', 'Clinical Research Design'],
  },
  {
    id: 'camihn',
    track: 'community',
    role: 'Founder & Lead Facilitator',
    org: 'CAMIHN (Cameroon International Health Networks)',
    location: 'Cameroon',
    period: '2023 – Present',
    context:
      'Digital health advocacy and conference facilitation for Cameroonian health workers navigating the intersection of clinical practice and emerging technology.',
    effort: [
      'Designed and delivered technical workshops on digital health tools for clinical staff with no prior engineering background.',
      'Facilitated international health networks connecting Cameroonian practitioners to global health informatics communities.',
    ],
    value: [
      'Built a structured channel for translating health technology research into clinical practice guidelines.',
    ],
    stack: ['Digital Health', 'Health Informatics', 'Community Facilitation', 'Technical Writing'],
  },
  {
    id: 'inkwave',
    track: 'community',
    role: 'Co-founder',
    org: 'InkWave',
    location: 'Cameroon',
    period: '2023 – Present',
    context:
      'Technical writing and knowledge documentation for African engineering teams who build in English as a second language.',
    effort: [
      'Co-built a technical writing platform and community to serve engineers documenting systems in English across Francophone Africa.',
      'Produced documentation guides adapted for engineering teams working in multilingual, resource-constrained environments.',
    ],
    value: [
      'Created a structured resource for engineering documentation in a context where most guides assume English-first development teams.',
    ],
    stack: ['Technical Writing', 'Documentation Systems', 'Multilingual', 'Community Building'],
  },
];

const trackLabels: Record<Track, string> = {
  clinical: 'Clinical & Data Leadership',
  software: 'Software Engineering',
  community: 'Community Architecture',
};

const trackColors: Record<Track, string> = {
  clinical: '#08b9d4',
  software: '#8b5cf6',
  community: '#2fd643',
};
---

<Base
  title="Experience — Chifen Sama Nduma"
  description="Interactive timeline of Chifen Sama Nduma's engineering, clinical, and community leadership milestones. Context, effort, and value for every role."
>
  <!-- Hero -->
  <section class="shell band border-b border-line">
    <p class="eyebrow">Chronological Record</p>
    <h1 class="mt-4 font-display text-5xl font-bold uppercase leading-none sm:text-6xl lg:text-7xl">
      Experience
    </h1>
    <p class="mt-6 max-w-2xl text-slate leading-relaxed">
      Six years spanning clinical nursing, health data systems, software engineering, and community
      infrastructure. Every entry records the operational constraint, the architectural response,
      and the concrete outcome.
    </p>

    <!-- Track legend -->
    <div class="mt-8 flex flex-wrap gap-3" aria-label="Timeline track legend">
      {(Object.entries(trackLabels) as [Track, string][]).map(([track, label]) => (
        <span
          class="flex items-center gap-2 rounded-full border px-4 py-1.5 text-sm font-semibold"
          style={`border-color: ${trackColors[track]}40; color: ${trackColors[track]};`}
        >
          <span
            class="inline-block h-2 w-2 rounded-full"
            style={`background:${trackColors[track]};`}
          ></span>
          {label}
        </span>
      ))}
    </div>
  </section>

  <!-- Timeline -->
  <section class="shell py-16">
    <div class="relative" id="experience-timeline">
      <!-- Vertical track line -->
      <div
        class="absolute left-6 top-0 bottom-0 w-px bg-line md:left-8"
        aria-hidden="true"
      ></div>

      <div class="space-y-0">
        {milestones.map((m, i) => (
          <article
            id={m.id}
            class="relative pl-16 pb-12 md:pl-20"
            data-track={m.track}
          >
            <!-- Node icon -->
            <div
              class="absolute left-0 flex h-12 w-12 items-center justify-center rounded-full border-2 bg-paper md:left-2"
              style={`border-color: ${trackColors[m.track]};`}
              aria-hidden="true"
            >
              {m.track === 'clinical' && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style={`color:${trackColors[m.track]}`}>
                  <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                </svg>
              )}
              {m.track === 'software' && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style={`color:${trackColors[m.track]}`}>
                  <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
                </svg>
              )}
              {m.track === 'community' && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style={`color:${trackColors[m.track]}`}>
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
              )}
            </div>

            <!-- Card -->
            <div
              class="rounded-[var(--radius-card)] border border-line p-6 transition-shadow hover:shadow-md sm:p-8"
              style={m.current ? `border-left: 3px solid ${trackColors[m.track]};` : ''}
            >
              <!-- Header -->
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <!-- Track badge -->
                  <span
                    class="mb-2 inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-semibold"
                    style={`background:${trackColors[m.track]}15; color:${trackColors[m.track]};`}
                  >
                    <span class="h-1.5 w-1.5 rounded-full" style={`background:${trackColors[m.track]};`}></span>
                    {trackLabels[m.track]}
                  </span>

                  <h2 class="font-display text-xl font-bold uppercase sm:text-2xl">
                    {m.role}
                  </h2>

                  <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate">
                    {m.orgUrl ? (
                      <a
                        href={m.orgUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-semibold text-ink hover:text-accent transition-colors"
                      >
                        {m.org} ↗
                      </a>
                    ) : (
                      <span class="font-semibold text-ink">{m.org}</span>
                    )}
                    <span>·</span>
                    <span>{m.location}</span>
                  </div>
                </div>

                <div class="flex flex-col items-end gap-2 shrink-0">
                  <span class="rounded-full border border-line px-3 py-1 text-xs font-semibold text-slate whitespace-nowrap">
                    {m.period}
                  </span>
                  {m.current && (
                    <span
                      class="rounded-full px-2.5 py-0.5 text-xs font-bold"
                      style={`background:${trackColors[m.track]}20; color:${trackColors[m.track]};`}
                    >
                      Current
                    </span>
                  )}
                </div>
              </div>

              <!-- Context -->
              <p class="mt-4 text-sm text-slate leading-relaxed border-l-2 border-line pl-3 italic">
                {m.context}
              </p>

              <!-- Effort & Value -->
              <div class="mt-5 grid gap-5 sm:grid-cols-2">
                <div>
                  <p class="mb-2 text-xs font-bold uppercase tracking-widest text-slate-light">
                    Effort
                  </p>
                  <ul class="space-y-2">
                    {m.effort.map((item) => (
                      <li class="flex gap-2 text-sm leading-relaxed">
                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-light"></span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div>
                  <p class="mb-2 text-xs font-bold uppercase tracking-widest text-slate-light">
                    Value
                  </p>
                  <ul class="space-y-2">
                    {m.value.map((item) => (
                      <li class="flex gap-2 text-sm leading-relaxed">
                        <span
                          class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full"
                          style={`background:${trackColors[m.track]};`}
                        ></span>
                        <span class="font-medium">{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Stack pills -->
              <div class="mt-5 flex flex-wrap gap-2">
                {m.stack.map((tag) => (
                  <span class="rounded-full border border-line px-3 py-1 text-xs font-semibold text-slate transition-colors hover:border-ink hover:text-ink cursor-default">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="shell pb-16">
    <div class="rounded-[var(--radius-card)] bg-ink p-8 text-paper sm:p-10">
      <p class="eyebrow text-paper/50">See the full record</p>
      <h2 class="mt-3 font-display text-3xl font-bold uppercase sm:text-4xl">
        Download the CV.
      </h2>
      <p class="mt-4 text-paper/70 max-w-lg">
        ATS-formatted, print-ready, with the same Effort → Value structure as this page.
        For slide decks and live demos, visit the Talks page.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={withBase('/cv')} class="btn btn-accent">
          View CV <span aria-hidden="true">&rarr;</span>
        </a>
        <a href={withBase('/talks')} class="btn btn-ghost text-paper border-paper/20 hover:border-paper">
          Talks & Demos
        </a>
        <a href={withBase('/contact')} class="btn btn-ghost text-paper border-paper/20 hover:border-paper">
          Get in touch
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  /**
   * Track filter: clicking a legend badge filters the timeline to that track.
   * Clicking again (or a different badge) resets to showing all.
   */
  const legendBadges = document.querySelectorAll<HTMLElement>('[aria-label="Timeline track legend"] span');
  const articles = document.querySelectorAll<HTMLElement>('#experience-timeline article');

  let activeTrack: string | null = null;

  legendBadges.forEach((badge) => {
    badge.style.cursor = 'pointer';
    badge.addEventListener('click', () => {
      const track = badge.closest('span')?.querySelector('span:not(.inline-block)')?.textContent?.trim();
      // Find track key from label
      const trackMap: Record<string, string> = {
        'Clinical & Data Leadership': 'clinical',
        'Software Engineering': 'software',
        'Community Architecture': 'community',
      };
      const trackKey = track ? trackMap[track] : null;

      if (activeTrack === trackKey) {
        // Deselect — show all
        activeTrack = null;
        articles.forEach((a) => { a.style.display = ''; });
        legendBadges.forEach((b) => { b.style.opacity = '1'; });
      } else {
        activeTrack = trackKey;
        articles.forEach((a) => {
          a.style.display = a.dataset.track === trackKey ? '' : 'none';
        });
        legendBadges.forEach((b) => {
          const t = b.querySelector('span:not(.inline-block)')?.textContent?.trim();
          b.style.opacity = t && trackMap[t] === trackKey ? '1' : '0.35';
        });
      }
    });
  });
</script>
