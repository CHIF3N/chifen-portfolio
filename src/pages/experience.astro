<script>
  /**
   * Track filter: clicking a legend badge filters all milestones across active & concluded to that track.
   * Clicking again resets to showing all.
   */
  const legendBadges = document.querySelectorAll<HTMLElement>('[data-filter-track]');
  const articles = document.querySelectorAll<HTMLElement>('article[data-track]');

  let activeTrack: string | null = null;

  legendBadges.forEach((badge) => {
    badge.addEventListener('click', () => {
      const trackKey = badge.dataset.filterTrack ?? null;

      if (activeTrack === trackKey) {
        // Deselect — show all
        activeTrack = null;
        articles.forEach((a) => { a.style.display = ''; });
        legendBadges.forEach((b) => { b.style.opacity = '1'; });
      } else {
        activeTrack = trackKey;
        articles.forEach((a) => {
          a.style.display = a.dataset.track === trackKey ? '' : 'none';
        });
        legendBadges.forEach((b) => {
          b.style.opacity = b.dataset.filterTrack === trackKey ? '1' : '0.35';
        });
      }
    });
  });
</script>
