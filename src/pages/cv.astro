  <!-- Interactive Domain Filter Script -->
  <script is:inline>
    (() => {
      const filterButtons = document.querySelectorAll('#cv-domain-filter-bar .cv-filter-btn');
      const domainItems = document.querySelectorAll('.cv-domain-item');

      filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const selected = btn.getAttribute('data-domain');

          filterButtons.forEach(b => {
            if (b === btn) {
              b.className = 'cv-filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold bg-accent text-white border border-accent shadow-xs transition-colors';
            } else {
              b.className = 'cv-filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold text-zinc-600 dark:text-zinc-300 hover:text-white bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 transition-colors';
            }
          });

          domainItems.forEach(item => {
            const itemDomain = item.getAttribute('data-domain');
            if (selected === 'all' || itemDomain === selected) {
              item.style.display = '';
            } else {
              item.style.display = 'none';
            }
          });
        });
      });
    })();
  </script>

