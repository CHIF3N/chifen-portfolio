    h3 { font-size: 10pt !important; }
    p, li { font-size: 9pt !important; color: #222 !important; }

    /* ── Accent colour survives print ─────────────────────────────────────── */
    .text-accent { color: #6d28d9 !important; }
    .border-accent { border-color: #6d28d9 !important; }
  }
</style>
