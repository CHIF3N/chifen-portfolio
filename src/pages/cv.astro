---
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
import { withBase } from '../lib/url';

/*
 * The CV page is the ATS-parseable, publicly accessible counterpart to the
 * private Admin AI Studio. Every item here is verified against source docs.
 * The structure follows the Fanaka "Show the Parts" principle: every entry
 * records Effort (the technical action) and Value (the real-world outcome).
 */

const education = [
  {
    degree: 'BSc Nursing (Top-up)',
    institution: 'Gracious Higher Institute of Excellence',
    note: 'Mentored by the University of Bamenda',
    period: '2024 – 2026',
    highlights: [
      'Dissertation: AI-assisted clinical decision-making readiness among health workers at Buea Regional Hospital (387 respondents, 92.4% response rate)',
      'Third place, MTN YaMo Pitch Competition Season 4 (LifeDrop)',
    ],
  },
  {
    degree: 'HND Nursing',
    institution: 'Gracious Higher Institute of Excellence',
    note: 'Buea, Cameroon',
    period: '2022 – 2024',
    highlights: [
      'Best Overall HND Student',
      'Best Nursing Student, HND',
      'Innovative Excellence Award',
      'Best Creative Thinker',
      'Proactive Student Award',
    ],
  },
];

// ── Active Roles ONLY ────────────────────────────────────────────────────
const activeExperience = [
  {
    role: 'Co-Founder & Chief Executive Officer',
    org: 'INKWAVE',
    url: 'https://inkwave-cm.vercel.app/',
    location: 'Buea, Cameroon',
    period: '2023 – Present',
    type: 'Leadership · Active',
    items: [
      'Directing digital storytelling studio and developer advocacy operations across Central and West Africa.',
      'Authored technical columns for Tech Chantier and The African Wave on low-bandwidth architectures and regional ecosystems.',
      'Established international ecosystem partnerships (e.g., ATWCE) and open-source documentation mentorship programs.',
      'Built a regional engineering community and mentored dozens of developers into global open-source ecosystems.',
    ],
  },
  {
    role: 'Lead Architect & Systems Developer',
    org: 'LifeDrop',
    url: 'https://lifedropcam.netlify.app/',
    location: 'Buea / Yaoundé, Cameroon',
    period: '2025 – Present',
    type: 'Venture · Active',
    items: [
      'Architected asynchronous webhooks integrating the WhatsApp Cloud API with Python/Node.js backends and Redis queues, enabling zero-install donor triage.',
      'Reduced emergency donor matching turnaround time to under 3 minutes per automated dispatch.',
      'Implemented idempotent request queues and retry policies to prevent duplicate alerts during 2G packet loss.',
      'Awarded 3rd Place in the MTN YaMo Pitch Competition Season 4.',
    ],
  },
  {
    role: 'Lead Engineer',
    org: 'CoastClear',
    location: 'Limbe / Coastal Cameroon',
    period: '2025 – Present',
    type: 'Venture · Active',
    items: [
      'Engineered responsive web dashboards with full localization (English, French, Cameroonian Pidgin) integrated with lightweight computer-vision models for photographic waste tagging.',
      'Delivered live spatial density heatmaps enabling volunteer cleanup operations to deploy resources with 40% higher efficiency.',
      'Implemented offline-first sync pipelines allowing field cleanup volunteers to log waste coordinates without cellular reception.',
    ],
  },
  {
    role: 'Community Ambassador',
    org: 'LinkedIn Local Buea',
    location: 'Buea, Cameroon',
    period: '2026 – Present',
    type: 'Community · Active',
    items: [
      'Curating grassroots networking initiatives connecting clinical healthcare professionals with Silicon Mountain tech startup founders.',
      'Facilitated cross-disciplinary roundtable sessions on health-tech adoption and clinical informatics.',
    ],
  },
];

// ── Concluded Past Mandates (Past Tense Only) ─────────────────────────────
const concludedExperience = [
  {
    role: 'District Data Manager & PMTCT Departmental Head',
    org: 'Kumba South District Health Service',
    location: 'South West Region, Cameroon',
    period: '2025 – 2026',
    type: 'Clinical Data · Concluded',
    items: [
      'Supervised regional health information systems across district clinical facilities facing intermittent power and network degradation.',
      'Restructured weekly facility reporting pipelines, audited electronic PMTCT registries, and implemented automated local-to-cloud sync workflows for DHIS2 reporting.',
      'Eliminated paper reporting backlogs across remote facilities and improved district data completeness from ~70% to >95%.',
      'Cut district reporting submission lag from 5 days to same-day, eliminating national DHIS2 reporting penalties.',
    ],
  },
  {
    role: 'Founding Board Member & Conference Lead',
    org: 'Cameroon Innovative Health Network (CAMIHN / HETEFA)',
    location: 'Cameroon',
    period: '2025 – 2026',
    type: 'Advocacy · Concluded',
    items: [
      'Co-founded health-tech advocacy network and formulated youth health-tech programs across Cameroon.',
      'Organized and moderated keynote sessions for the Cameroon Innovative Health Conference.',
    ],
  },
  {
    role: 'Digital Health Field Volunteer',
    org: 'Vision in Action Cameroon (VIAC)',
    location: 'South West Region, Cameroon',
    period: '2025 – 2026',
    type: 'Field Ops · Concluded',
    items: [
      'Advised community outreach teams on mobile data collection tools and offline data capture for youth health interventions.',
      'Ensured seamless survey data synchronization during remote field operations without connectivity loss.',
    ],
  },
  {
    role: 'Co-Founder & CTO / Project Manager',
    org: 'Ayodah Blood Donor Platform',
    location: 'Buea, Cameroon',
    period: '2020 – 2023',
    type: 'Venture · Concluded',
    items: [
      'Designed relational database schemas and prototype mobile interfaces for volunteer blood donor coordination.',
      'Validated donor response behaviors across clinical wards; built 400+ donor registry with 310 mediated donations across 3 partner hospitals.',
      'Won the Silicon Mountain Challenge 2022 (Cameroon’s premier startup competition).',
    ],
  },
];

// ── Compact Speaking & Civic Engagements ──────────────────────────────────
const speakingAndCivic = [
  {
    role: 'Keynote Speaker',
    event: 'PyCon & UbuCon Cameroon 2026 (Yaoundé)',
    topic: 'Building WhatsApp-Based Health Tech Networks in Low-Connectivity Environments',
    year: 'September 2026',
    note: 'Delivered live keynote presentation and automated system demonstration.',
  },
  {
    role: 'Speaker',
    event: 'SIC Conference 2025',
    topic: 'Youth & STEM Innovation in Regional Ecosystems',
    year: '2025',
    note: 'Keynote on grassroots technical enablement in Cameroon.',
  },
  {
    role: 'Participant',
    event: 'YALI Anti-Corruption & Civic Leadership Workshop',
    topic: 'Grassroots Anti-Corruption, Organizational Integrity & Public Healthcare Ethics',
    year: '2022',
    note: 'Mandela Washington Fellows Alumni Association / US Embassy Yaoundé.',
  },
];

const projects = [
  {
    name: 'LifeDrop',
    url: 'https://lifedropcam.netlify.app/',
    summary:
      'Emergency blood donor dispatch system operating under extreme cellular data constraints. Asynchronous WhatsApp Cloud API webhooks with idempotent queues, donor-proximity heuristics, and zero-install triage.',
    tags: ['WhatsApp Cloud API', 'Python', 'Node.js', 'Docker', 'Redis'],
  },
  {
    name: 'INKWAVE Platform',
    url: 'https://inkwave-cm.vercel.app/',
    summary:
      'Digital storytelling agency and developer advocacy platform driving technical communication and regional ecosystem activations across Central and West Africa.',
    tags: ['Next.js', 'TypeScript', 'Tailwind CSS', 'Brand Architecture'],
  },
  {
    name: 'CoastClear',
    url: undefined,
    summary:
      'Multilingual coastal waste monitoring and cleanup logistics platform for conservation teams. Real-time spatial density heatmaps and photographic waste classification.',
    tags: ['Next.js', 'TypeScript', 'Tailwind CSS', 'Computer Vision APIs', 'i18n'],
  },
  {
    name: 'AI Clinical Decision-Making Research',
    url: undefined,
    summary:
      '387-respondent cross-sectional study at Buea Regional Hospital on clinician AI readiness. KoboCollect pipeline → SPSS analysis → PRISMA-compliant write-up (92.4% response rate).',
    tags: ['KoboCollect', 'SPSS', 'Clinical research', 'PRISMA'],
  },
  {
    name: 'Maternal Health Risk Predictor',
    url: undefined,
    summary:
      'scikit-learn logistic regression model trained on anonymised clinical records. Risk stratification across 5 maternal outcome variables deployed as a lightweight REST endpoint for midwife tablets.',
    tags: ['Python', 'scikit-learn', 'REST API', 'Clinical ML'],
  },
  {
    name: 'MORIA Nurse Intern Assistant',
    url: undefined,
    summary:
      'Offline-first React Native mobile reference tool for nurse interns: drug dosage calculation, emergency resuscitation protocols, and patient handover checklists.',
    tags: ['React Native', 'Expo', 'SQLite', 'Offline-first'],
  },
  {
    name: 'VIAC Chatbots',
    url: undefined,
    summary:
      'Bilingual health information chatbots deployed for an NGO cervical cancer awareness campaign. n8n automation, WhatsApp Cloud API; handled 200+ patient queries in the pilot month.',
    tags: ['n8n', 'WhatsApp Cloud API', 'Health-tech'],
  },
];

const skills = [
  {
    group: 'Languages & Systems',
    items: ['TypeScript', 'JavaScript', 'Python', 'HTML5 / CSS3', 'SQL'],
  },
  {
    group: 'Frameworks & Libraries',
    items: ['Astro', 'Next.js (App Router)', 'React Native / Expo', 'Tailwind CSS', 'scikit-learn'],
  },
  {
    group: 'Platforms & Protocols',
    items: ['WhatsApp Cloud API', 'Docker', 'Redis', 'Firebase / Firestore', 'Supabase', 'DHIS2', 'n8n', 'Google Gemini API'],
  },
  {
    group: 'Clinical & Health Data',
    items: ['SPSS', 'KoboCollect', 'PRISMA', 'Clinical Data Management', 'PMTCT Cohorts', 'Health Informatics'],
  },
  {
    group: 'Engineering Operations',
    items: ['Git / GitHub', 'Vercel', 'Figma', 'Offline-First Workflows', 'Low-Bandwidth Optimization', 'Technical Writing'],
  },
];

const certifications = [
  { name: 'Certificate of Training Completion', issuer: 'The Tony Elumelu Foundation' },
  { name: 'Certificate of Business Management Training', issuer: 'The Tony Elumelu Foundation' },
  { name: 'UNLEASH Hack Talent, Certificate of Participation', issuer: 'UNLEASH' },
  { name: 'Medical Abortion Course for Providers', issuer: 'International Planned Parenthood Federation' },
  { name: 'Teaching English as a Foreign Language (TEFL)', issuer: 'Teacher Record' },
  { name: 'Advancing the Role of Women in Politics', issuer: 'Regional Leadership Center East Africa' },
];
---

<Base
  title="CV"
  description="Curriculum vitae of Chifen Sama Nduma — software engineer, registered nurse, and health technology founder based in Buea, Cameroon."
  accent="#8b5cf6"
>
  <!-- Print controls -->
  <div class="shell py-6 print:hidden">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <p class="body-sm text-zinc-500 dark:text-zinc-400">
        Full CV · Updated October 2026
      </p>
      <div class="flex gap-3">
        <button
          onclick="window.print()"
          class="btn btn-ghost btn-sm"
          type="button"
        >
          Print / Save PDF
          <span aria-hidden="true">↓</span>
        </button>
        <a href={withBase('/contact')} class="btn btn-accent btn-sm">
          Get in touch
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Talks callout — screen only -->
  <div class="shell print:hidden">
    <a
      href={withBase('/talks')}
      class="flex items-center gap-3 rounded-xl border border-accent/30 bg-accent/8 px-5 py-3.5 text-sm font-semibold text-accent transition-colors hover:bg-accent/12"
    >
      <span aria-hidden="true">▶</span>
      <span>
        For interactive slide decks and live architecture demos, visit
        <span class="underline underline-offset-2">chifen.is-a.dev/talks</span>
      </span>
      <span aria-hidden="true" class="ml-auto">&rarr;</span>
    </a>
  </div>

  <section class="shell border-t border-zinc-200 dark:border-zinc-800 py-10 sm:py-14 print:py-6">
    <div class="grid gap-6 sm:grid-cols-[1fr_auto]">
      <div>
        <h1 class="font-display text-5xl font-bold leading-none uppercase sm:text-6xl text-zinc-900 dark:text-zinc-100">
          Chifen Sama <span class="text-accent">Nduma</span>
        </h1>
        <p class="mt-3 text-lg font-medium text-zinc-700 dark:text-zinc-300">
          Software Engineer · Health Technology Innovator · Technical Writer
        </p>
        <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">{site.location}</p>
      </div>
      <div class="flex flex-col gap-1.5 text-sm text-zinc-600 dark:text-zinc-400 print:text-xs">
        <a href={`mailto:${site.emails[0]}`} class="hover:text-accent transition-colors text-zinc-700 dark:text-zinc-300">
          {site.emails[0]}
        </a>
        <a href={site.whatsapp[0].href} class="hover:text-accent transition-colors text-zinc-700 dark:text-zinc-300">
          {site.whatsapp[0].label}
        </a>
        <a href={site.linkedin} class="hover:text-accent transition-colors text-zinc-700 dark:text-zinc-300">
          linkedin.com/in/chif3n
        </a>
        <a href={site.github} class="hover:text-accent transition-colors text-zinc-700 dark:text-zinc-300">
          github.com/chifensama01-coder
        </a>
        <a href="https://inkwave-cm.vercel.app/" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors text-accent font-medium">
          inkwave-cm.vercel.app ↗
        </a>
      </div>
    </div>

    <!-- Engineering headline -->
    <blockquote class="mt-8 border-l-4 border-accent pl-5 text-lg leading-relaxed text-zinc-700 dark:text-zinc-300 print:mt-4 italic">
      Registered nurse and software engineer. I build digital health infrastructure for settings
      with unreliable power, low bandwidth, and no margin for system failure. Clinical domain
      knowledge from the inside — not inferred from user interviews.
    </blockquote>
  </section>

  <!-- 1. Active Roles -->
  <section class="shell band band-line print:py-4">
    <h2 class="eyebrow text-accent">Active Roles & Ventures</h2>
    <ul class="mt-8 space-y-10 print:mt-4 print:space-y-6">
      {
        activeExperience.map((job, i) => (
          <li data-reveal style={`--reveal-delay:${i * 50}ms`} class="grid gap-3 sm:grid-cols-[1fr_auto] sm:items-start">
            <div>
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="font-display text-xl font-bold text-zinc-900 dark:text-zinc-100">{job.role}</span>
                <span class="text-xs font-semibold tracking-wider text-emerald-600 dark:text-emerald-400 uppercase rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-0.5">
                  {job.type}
                </span>
              </div>
              <p class="mt-0.5 text-sm font-semibold text-zinc-600 dark:text-zinc-400">
                {job.url ? (
                  <a href={job.url} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
                    {job.org} ↗
                  </a>
                ) : (
                  <span>{job.org}</span>
                )} &middot; {job.location}
              </p>
              <ul class="mt-3 space-y-1.5">
                {job.items.map((item) => (
                  <li class="flex gap-2.5 text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">
                    <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
            <p class="ordinal shrink-0 text-right text-sm text-zinc-500 dark:text-zinc-400 font-mono">{job.period}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 2. Concluded Mandates -->
  <section class="shell band band-line print:py-4">
    <h2 class="eyebrow text-accent">Concluded Mandates & Tenures</h2>
    <ul class="mt-8 space-y-8 print:mt-4 print:space-y-6">
      {
        concludedExperience.map((job, i) => (
          <li data-reveal style={`--reveal-delay:${i * 40}ms`} class="grid gap-3 sm:grid-cols-[1fr_auto] sm:items-start opacity-90">
            <div>
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="font-display text-xl font-bold text-zinc-900 dark:text-zinc-100">{job.role}</span>
                <span class="text-xs font-semibold tracking-wider text-zinc-600 dark:text-zinc-400 uppercase rounded-full border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-800 px-2.5 py-0.5">
                  {job.type}
                </span>
              </div>
              <p class="mt-0.5 text-sm font-semibold text-zinc-600 dark:text-zinc-400">
                {job.org} &middot; {job.location}
              </p>
              <ul class="mt-3 space-y-1.5">
                {job.items.map((item) => (
                  <li class="flex gap-2.5 text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">
                    <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-zinc-400 dark:bg-zinc-600" aria-hidden="true" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
            <p class="ordinal shrink-0 text-right text-sm text-zinc-500 dark:text-zinc-400 font-mono">{job.period}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 3. Speaking & Civic Engagements (Compact) -->
  <section class="shell band band-line print:py-4">
    <h2 class="eyebrow text-accent">Speaking & Civic Engagements</h2>
    <ul class="mt-8 space-y-4 print:mt-4">
      {
        speakingAndCivic.map((talk, i) => (
          <li
            data-reveal
            style={`--reveal-delay:${i * 40}ms`}
            class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-zinc-200 dark:border-zinc-800 pb-4 last:border-0"
          >
            <div>
              <div class="flex items-center gap-2">
                <span class="text-xs font-semibold text-accent">{talk.role}</span>
                <span class="text-zinc-400 text-xs">·</span>
                <p class="font-display font-bold text-zinc-900 dark:text-zinc-100">{talk.event}</p>
              </div>
              <p class="mt-0.5 text-sm text-zinc-700 dark:text-zinc-300">{talk.topic}</p>
              {talk.note && <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{talk.note}</p>}
            </div>
            <span class="ordinal text-sm text-zinc-500 dark:text-zinc-400 font-mono">{talk.year}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Selected Projects -->
  <section class="shell band band-line print:py-4">
    <h2 class="eyebrow text-accent">Selected Projects</h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 print:mt-4 print:grid-cols-2">
      {
        projects.map((project, i) => (
          <li
            data-reveal
            style={`--reveal-delay:${i * 40}ms`}
            class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 p-5 shadow-sm"
          >
            <div class="flex items-start justify-between gap-3">
              <p class="font-display text-base font-bold text-zinc-900 dark:text-zinc-100">{project.name}</p>
              {project.url && (
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener"
                  class="shrink-0 text-xs font-semibold text-accent underline-offset-4 hover:underline"
                  aria-label={`Visit ${project.name}`}
                >
                  Live &rarr;
                </a>
              )}
            </div>
            <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{project.summary}</p>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {project.tags.map((tag) => (
                <li class="rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700 px-2.5 py-0.5 text-xs font-medium">
                  {tag}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
    <a
      href={withBase('/work')}
      class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-accent underline-offset-4 hover:underline print:hidden"
    >
      Full case studies &rarr;
    </a>
  </section>

  <!-- Education -->
  <section class="shell band band-line print:py-4">
    <h2 class="eyebrow text-accent">Education & Academic Record</h2>
    <ul class="mt-8 space-y-8 print:mt-4 print:space-y-4">
      {
        education.map((edu, i) => (
          <li data-reveal style={`--reveal-delay:${i * 50}ms`} class="grid gap-2 sm:grid-cols-[1fr_auto] sm:items-start">
            <div>
              <p class="font-display text-xl font-bold text-zinc-900 dark:text-zinc-100">{edu.degree}</p>
              <p class="mt-0.5 text-sm text-zinc-600 dark:text-zinc-400">
                {edu.institution}
                {edu.note && <span class="text-zinc-500 dark:text-zinc-500"> &middot; {edu.note}</span>}
              </p>
              <ul class="mt-3 space-y-1">
                {edu.highlights.map((h) => (
                  <li class="flex gap-2.5 text-sm text-zinc-700 dark:text-zinc-300">
                    <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                    {h}
                  </li>
                ))}
              </ul>
            </div>
            <p class="ordinal shrink-0 text-right text-sm text-zinc-500 dark:text-zinc-400 font-mono">{edu.period}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Skills -->
  <section class="shell band band-line print:py-4">
    <h2 class="eyebrow text-accent">Technical & Clinical Skills</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 print:mt-4 print:grid-cols-3">
      {
        skills.map((section, i) => (
          <div data-reveal style={`--reveal-delay:${i * 40}ms`}>
            <h3 class="text-xs font-bold tracking-widest text-accent uppercase">
              {section.group}
            </h3>
            <ul class="mt-3 space-y-1.5">
              {section.items.map((item) => (
                <li class="text-sm text-zinc-700 dark:text-zinc-300">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Certifications -->
  <section class="shell band band-line print:py-4">
    <h2 class="eyebrow text-accent">Certifications & Training</h2>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2 print:mt-4 print:grid-cols-2">
      {
        certifications.map((cert, i) => (
          <li
            data-reveal
            style={`--reveal-delay:${i * 40}ms`}
            class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white/70 dark:bg-zinc-900/60 px-5 py-4"
          >
            <p class="font-display font-bold text-sm text-zinc-900 dark:text-zinc-100">{cert.name}</p>
            <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{cert.issuer}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Print CTA strip — only visible on screen -->
  <section class="shell py-12 print:hidden">
    <div class="rounded-[var(--radius-card)] bg-ink p-8 text-paper sm:p-10">
      <p class="eyebrow text-paper/50">Working on something in health or digital infrastructure?</p>
      <h2 class="mt-3 font-display text-3xl font-bold uppercase sm:text-4xl text-paper">
        Let's talk.
      </h2>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={withBase('/contact')} class="btn btn-accent">
          Get in touch
          <span aria-hidden="true">&rarr;</span>
        </a>
        <button onclick="window.print()" class="btn btn-ghost text-paper border-paper/20 hover:border-paper" type="button">
          Download PDF
        </button>
      </div>
    </div>
  </section>
</Base>

<style>
  @media print {
    /* ── Page setup: A4 Portrait, tight margins ─────────────────────────────── */
    @page {
      size: A4 portrait;
      margin: 10mm 12mm;
    }

    /* ── Base reset for print ─────────────────────────────────────────────── */
    :root {
      --ink: #000;
      --paper: #fff;
      --slate: #333;
      --accent: #6d28d9;
    }
    body {
      background: white !important;
      color: #111827 !important;
