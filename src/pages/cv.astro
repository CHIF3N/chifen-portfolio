  },
  {
    name: 'MORIA Nurse Intern Assistant',
    url: undefined,
    domain: 'clinical',
    domainBadge: '🩺 Clinical Bedside Tools',
    summary:
      'Offline-first React Native mobile reference tool for nurse interns: drug dosage calculation, emergency resuscitation protocols, and patient handover checklists.',
    tags: ['React Native', 'Expo', 'SQLite', 'Offline-first'],
  },
  {
    name: 'VIAC Chatbots',
    url: undefined,
    domain: 'health-tech',
