---

<Base
  title="CV"
  description="Curriculum vitae of Chifen Sama Nduma — software engineer, registered nurse, and health technology founder based in Buea, Cameroon."
  accent="#8b5cf6"
>
  <!-- Print controls -->
  <div class="shell py-6 print:hidden">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <p class="body-sm text-zinc-500 dark:text-zinc-400">
        Full CV · Updated October 2026
      </p>
      <div class="flex gap-3">
        <button
          onclick="window.print()"
          class="btn btn-ghost btn-sm"
          type="button"
        >
          Print / Save PDF
          <span aria-hidden="true">↓</span>
        </button>
        <a href={withBase('/contact')} class="btn btn-accent btn-sm">
          Get in touch
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Talks callout — screen only -->
  <div class="shell print:hidden">
    <a
      href={withBase('/talks')}
      class="flex items-center gap-3 rounded-xl border border-accent/30 bg-accent/8 px-5 py-3.5 text-sm font-semibold text-accent transition-colors hover:bg-accent/12"
    >
      <span aria-hidden="true">▶</span>
      <span>
        For interactive slide decks and live architecture demos, visit
        <span class="underline underline-offset-2">chifen.is-a.dev/talks</span>
      </span>
      <span aria-hidden="true" class="ml-auto">&rarr;</span>
    </a>
  </div>

  <section class="shell border-t border-zinc-200 dark:border-zinc-800 py-10 sm:py-14 print:py-6">
    <div class="grid gap-6 sm:grid-cols-[1fr_auto]">
      <div>
        <h1 class="font-display text-5xl font-bold leading-none uppercase sm:text-6xl text-zinc-900 dark:text-zinc-100">
          Chifen Sama <span class="text-accent">Nduma</span>
        </h1>
        <p class="mt-3 text-lg font-medium text-zinc-700 dark:text-zinc-300">
          Self-Taught Software Engineer · Health Technology Innovator · M.Tech Data Science (COLTECH UBa)
        </p>
        <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">{site.location}</p>
      </div>
      <div class="flex flex-col gap-1.5 text-sm text-zinc-600 dark:text-zinc-400 print:text-xs">
        <a href={`mailto:${site.emails[0]}`} class="hover:text-accent transition-colors text-zinc-700 dark:text-zinc-300">
          {site.emails[0]}
        </a>
        <a href={site.whatsapp[0].href} class="hover:text-accent transition-colors text-zinc-700 dark:text-zinc-300">
          {site.whatsapp[0].label}
        </a>
        <a href={site.linkedin} class="hover:text-accent transition-colors text-zinc-700 dark:text-zinc-300">
          linkedin.com/in/chif3n
        </a>
        <a href={site.github} class="hover:text-accent transition-colors text-zinc-700 dark:text-zinc-300">
          github.com/CHIF3N
        </a>
        <a href="https://inkwave-cm.vercel.app/" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors text-accent font-medium">
          inkwave-cm.vercel.app ↗
        </a>
      </div>
    </div>

    <!-- Engineering headline -->
    <blockquote class="mt-8 border-l-4 border-accent pl-5 text-lg leading-relaxed text-zinc-700 dark:text-zinc-300 print:mt-4 italic">
      Registered nurse and 100% self-trained software engineer, currently pursuing an M.Tech in Data Science at COLTECH (The University of Bamenda). I build digital health infrastructure for settings with unreliable power, low bandwidth, and zero margin for failure. Clinical domain knowledge from the bedside; engineering mastery from autodidactic grit.
    </blockquote>

    <!-- 3 Pillars of Practice: Clinical vs Health Tech vs Tech Differentiation -->
    <div class="mt-10 grid gap-4 sm:grid-cols-3 print:mt-6 print:gap-3">
      <div class="rounded-xl border border-emerald-500/30 bg-emerald-500/5 p-4.5 dark:bg-emerald-950/20">
        <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-bold text-sm">
          <span>🩺</span>
          <span>1. Clinical Practice</span>
        </div>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-2 leading-relaxed">
          Grounded bedside care, PMTCT department head, clinical protocol audits, maternal-child health triage, emergency resuscitation, and ward handover checklists.
        </p>
        <span class="inline-block mt-3 text-[11px] font-mono text-emerald-600 dark:text-emerald-400 font-semibold bg-emerald-500/10 border border-emerald-500/20 rounded px-2 py-0.5">
          Registered Nurse (HND &amp; Top-up)
        </span>
      </div>

      <div class="rounded-xl border border-purple-500/30 bg-purple-500/5 p-4.5 dark:bg-purple-950/20">
        <div class="flex items-center gap-2 text-purple-600 dark:text-purple-400 font-bold text-sm">
          <span>🏥</span>
          <span>2. Health Tech &amp; AI</span>
        </div>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-2 leading-relaxed">
          Where clinical problems meet automation: WhatsApp emergency blood dispatch (LifeDrop, MTN YaMo 3rd), 387-clinician AI readiness study, DHIS2 sync, maternal ML models.
        </p>
        <span class="inline-block mt-3 text-[11px] font-mono text-purple-600 dark:text-purple-400 font-semibold bg-purple-500/10 border border-purple-500/20 rounded px-2 py-0.5">
          Founder, LifeDrop · Clinical AI
        </span>
      </div>

      <div class="rounded-xl border border-cyan-500/30 bg-cyan-500/5 p-4.5 dark:bg-cyan-950/20">
        <div class="flex items-center gap-2 text-cyan-600 dark:text-cyan-400 font-bold text-sm">
          <span>💻</span>
          <span>3. Software Engineering</span>
        </div>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-2 leading-relaxed">
          Autodidactic engineering craft: TypeScript, Python, Redis queues, Docker, low-bandwidth pipelines, INKWAVE storytelling platform, and CoastClear conservation logistics.
        </p>
        <span class="inline-block mt-3 text-[11px] font-mono text-cyan-600 dark:text-cyan-400 font-semibold bg-cyan-500/10 border border-cyan-500/20 rounded px-2 py-0.5">
          M.Tech Data Science (COLTECH UBa)
        </span>
      </div>
    </div>
  </section>

  <!-- Interactive Domain Filter Switcher (Screen Only) -->
  <div class="shell pt-2 pb-4 print:hidden">
    <div class="flex flex-wrap items-center justify-between gap-3 p-3.5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/50">
      <div class="flex items-center gap-2">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-zinc-500">Filter CV View:</span>
      </div>
      <div class="flex flex-wrap items-center gap-2" id="cv-domain-filter-bar">
        <button
          type="button"
          data-domain="all"
          class="cv-filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold bg-accent text-white border border-accent shadow-xs transition-colors"
        >
          All Domains (Unified ATS Record)
        </button>
        <button
          type="button"
          data-domain="clinical"
          class="cv-filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold text-zinc-600 dark:text-zinc-300 hover:text-white bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 transition-colors"
        >
          🩺 Clinical Work &amp; Healthcare
        </button>
        <button
          type="button"
          data-domain="health-tech"
          class="cv-filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold text-zinc-600 dark:text-zinc-300 hover:text-white bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 transition-colors"
        >
          🏥 Health Tech &amp; Informatics
        </button>
        <button
          type="button"
          data-domain="tech"
          class="cv-filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold text-zinc-600 dark:text-zinc-300 hover:text-white bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 transition-colors"
        >
          💻 Software Engineering &amp; Systems
        </button>
      </div>
    </div>
  </div>

  <!-- 1. Active Roles -->
  <section class="shell band band-line print:py-4">
    <div class="flex items-center justify-between">
      <h2 class="eyebrow text-accent">Active Roles &amp; Ventures</h2>
      <span class="text-xs font-mono text-zinc-400 print:hidden">Classified by domain</span>
    </div>
    <ul class="mt-8 space-y-10 print:mt-4 print:space-y-6" id="list-active-roles">
      {
        activeExperience.map((job, i) => (
          <li
            data-domain={job.domain}
            data-reveal
            style={`--reveal-delay:${i * 50}ms`}
            class="cv-domain-item grid gap-3 sm:grid-cols-[1fr_auto] sm:items-start transition-opacity duration-200"
          >
            <div>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
                <span class="font-display text-xl font-bold text-zinc-900 dark:text-zinc-100">{job.role}</span>
                <span class={`text-[11px] font-semibold tracking-wider uppercase rounded-full border px-2.5 py-0.5 ${
                  job.domain === 'clinical'
                    ? 'border-emerald-500/40 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400'
                    : job.domain === 'health-tech'
                    ? 'border-purple-500/40 bg-purple-500/10 text-purple-600 dark:text-purple-400'
                    : 'border-cyan-500/40 bg-cyan-500/10 text-cyan-600 dark:text-cyan-400'
                }`}>
                  {job.domainBadge}
                </span>
                <span class="text-xs font-semibold tracking-wider text-zinc-500 dark:text-zinc-400 uppercase rounded-full border border-zinc-200 dark:border-zinc-700 bg-zinc-100 dark:bg-zinc-800/80 px-2 py-0.5">
                  {job.type}
                </span>
              </div>
              <p class="mt-1 text-sm font-semibold text-zinc-600 dark:text-zinc-400">
                {job.url ? (
                  <a href={job.url} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
                    {job.org} ↗
                  </a>
                ) : (
                  <span>{job.org}</span>
                )} &middot; {job.location}
              </p>
              <ul class="mt-3 space-y-1.5">
                {job.items.map((item) => (
                  <li class="flex gap-2.5 text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">
                    <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
            <p class="ordinal shrink-0 text-right text-sm text-zinc-500 dark:text-zinc-400 font-mono">{job.period}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 2. Concluded Mandates -->
  <section class="shell band band-line print:py-4">
    <div class="flex items-center justify-between">
      <h2 class="eyebrow text-accent">Concluded Mandates &amp; Tenures</h2>
      <span class="text-xs font-mono text-zinc-400 print:hidden">Clinical &amp; Technical Track Record</span>
    </div>
    <ul class="mt-8 space-y-8 print:mt-4 print:space-y-6" id="list-concluded-roles">
      {
        concludedExperience.map((job, i) => (
          <li
            data-domain={job.domain}
            data-reveal
            style={`--reveal-delay:${i * 40}ms`}
            class="cv-domain-item grid gap-3 sm:grid-cols-[1fr_auto] sm:items-start opacity-95 transition-opacity duration-200"
          >
            <div>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
                <span class="font-display text-xl font-bold text-zinc-900 dark:text-zinc-100">{job.role}</span>
                <span class={`text-[11px] font-semibold tracking-wider uppercase rounded-full border px-2.5 py-0.5 ${
                  job.domain === 'clinical'
                    ? 'border-emerald-500/40 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400'
                    : job.domain === 'health-tech'
                    ? 'border-purple-500/40 bg-purple-500/10 text-purple-600 dark:text-purple-400'
                    : 'border-cyan-500/40 bg-cyan-500/10 text-cyan-600 dark:text-cyan-400'
                }`}>
