const skills = [
  {
    group: 'Clinical & Bedside Competencies',
    icon: '🩺',
    accent: 'emerald',
    items: ['PMTCT Care Protocols', 'Antenatal Risk Triage', 'Emergency Resuscitation Assistance', 'Clinical Ward Handover', 'Biomedical Patient Assessment', 'Drug Dosage Calculation Safety'],
  },
  {
    group: 'Health Tech & Clinical Informatics',
    icon: '🏥',
