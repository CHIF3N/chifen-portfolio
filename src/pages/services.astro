---
import Base from '../layouts/Base.astro';
import Scene3D from '../components/Scene3D.astro';
import ChipMarquee from '../components/ChipMarquee.astro';
import Booking from '../components/Booking.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../lib/site';
import { withBase } from '../lib/url';

/**
 * Each service is evidenced by work already on the site, so the `proof` slugs
 * link to real case studies rather than describing capability in the abstract.
 */
const services = [
  {
    title: 'Health product builds',
    body: 'Apps and services for clinics, donors, and health workers. Designed for low data, unreliable power, and a phone rather than a computer.',
    tags: ['Mobile apps', 'Web platforms', 'Offline-first', 'Multilingual'],
    proof: [
      { label: 'LifeDrop', slug: 'lifedrop' },
      { label: 'CoastClear', slug: 'coastclear' },
    ],
    scene: '/scenes/icon-mobile.mp4',
  },
  {
    title: 'WhatsApp automation',
    body: 'Bilingual bots and health services on the channel people in Cameroon already use every day, with no app to install.',
    tags: ['WhatsApp Cloud API', 'Bot flows', 'English and French', 'Triage'],
    proof: [
      { label: 'Moirai and Aunty Queen', slug: 'moirai' },
      { label: 'VIAC chatbots', slug: 'viac-chatbots' },
    ],
    scene: '/scenes/icon-megaphone.mp4',
  },
  {
    title: 'Clinical data and ML',
    body: 'Risk models, dashboards, and analysis built on real clinical data rather than tidy demo sets, with the limitations stated plainly.',
    tags: ['Risk modelling', 'scikit-learn', 'Dashboards', 'Georegistry'],
    proof: [
      { label: 'Maternal health risk', slug: 'maternal-health-risk' },
      { label: 'Abortion safety georegistry', slug: 'abortion-safety-georegistry' },
    ],
    scene: null,
  },
  {
    title: 'Research and writing',
    body: 'Study design, survey work, and writing up findings so they hold up to scrutiny. 387 respondents on the last one, at a 92.4% response rate.',
    tags: ['Study design', 'Survey work', 'Analysis', 'Write-up'],
    proof: [{ label: 'AI in clinical decision-making', slug: 'ai-clinical-decision-research' }],
    scene: null,
  },
];

const chips = [
  'Built for low bandwidth',
  'Works on a basic phone',
  'Clinically informed',
  'Bilingual by default',
  'Real users, not demos',
  'Documented handover',
];
---

<Base
  title="Services"
  description="What Chifen Sama N. builds: health products, WhatsApp automation, clinical data and machine learning, and research support."
  accent={site.accents.services}
>
  <section class="shell pt-14 pb-10 sm:pt-20">
    <div class="grid items-center gap-10 lg:grid-cols-[0.7fr_1.3fr]">
      <Scene3D
        src="/scenes/scene-services.mp4"
        bubble="What I bring"
        bubbleSide="left"
        label="Animated 3D illustration"
        class="w-full max-w-xs lg:max-w-none"
      />
      <div class="lg:text-right">
        <h1 class="display-section">Services</h1>
        <p class="lede mt-5 lg:ml-auto lg:max-w-xl">
          Four things I actually do, each one backed by something already built and linked below.
          If what you need is not here, say so and I will tell you honestly whether I am the right
          person.
        </p>
      </div>
    </div>
  </section>

  <div class="shell">
    <ChipMarquee items={chips} />
  </div>

  <section class="shell band">
    <ul>
      {
        services.map((service, i) => (
          <li
            class="grid gap-6 border-b border-line py-10 sm:grid-cols-[auto_1fr] sm:gap-10 lg:grid-cols-[auto_1.1fr_0.9fr]"
            data-reveal
            style={`--reveal-delay:${i * 70}ms`}
          >
            <span class="ordinal pt-2">{String(i + 1).padStart(2, '0')}</span>

            <div>
              <h2 class="display-card">{service.title}</h2>
              <p class="lede mt-3 max-w-lg">{service.body}</p>

              <ul class="mt-6 flex flex-wrap gap-2">
                {service.tags.map((tag) => (
                  <li class="rounded-full border border-line px-3.5 py-1.5 text-xs font-semibold text-slate">
                    {tag}
                  </li>
                ))}
              </ul>

              <p class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
                <span class="eyebrow">Proof</span>
                {service.proof.map((item) => (
                  <a
                    href={withBase(`/work/${item.slug}`)}
                    class="text-sm font-semibold text-ink underline decoration-accent decoration-2 underline-offset-4 transition-colors hover:text-accent"
                  >
                    {item.label}
                  </a>
                ))}
              </p>
            </div>

            {service.scene && (
              <div class="max-w-[16rem] justify-self-start lg:justify-self-end">
                <Scene3D src={service.scene} label="Animated 3D illustration" />
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="shell band band-line">
    <SectionHead label="How it goes" title="Process" />
    <ol class="mt-12 grid gap-5 md:grid-cols-3">
      {
        [
          {
            title: "Let's talk",
            body: 'We start with the actual problem and the constraints around it. Who uses this, on what phone, with what connection.',
          },
          {
            title: 'Build and test',
            body: 'I build the smallest thing that proves the idea, then put it in front of real users and fix what breaks.',
          },
          {
            title: 'Ship and support',
            body: 'You get the code, the documentation, and someone who stays reachable after launch.',
          },
        ].map((step, i) => (
          <li class="card-flat p-7" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <span class="ordinal">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="display-card mt-4">{step.title}</h3>
            <p class="body-sm mt-3">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-12">
      <Booking />
    </div>
  </section>
</Base>
