---
import Base from '../layouts/Base.astro';
import Booking from '../components/Booking.astro';
import { site } from '../lib/site';
---

<Base
  title="Contact"
  description="Get in touch with Chifen Sama N. by email or WhatsApp."
>
  <section class="mx-auto max-w-4xl px-5 pt-14 pb-16 sm:px-8 sm:pt-20">
    <h1 class="font-display text-4xl font-semibold sm:text-5xl">Contact</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate">
      Pick whichever is faster for you. The email form opens your mail app with everything
      already filled in. The WhatsApp one does the same, straight to my chat.
    </p>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <div class="rounded-2xl border border-ink/10 bg-white/60 p-6 sm:p-8" data-reveal>
        <h2 class="font-display text-xs font-semibold tracking-widest text-accent uppercase">
          Email
        </h2>
        <form id="email-form" class="mt-5 space-y-4">
          <div>
            <label for="email-name" class="text-sm font-medium text-ink">Your name</label>
            <input
              id="email-name"
              name="name"
              type="text"
              required
              class="mt-1.5 w-full rounded-lg border border-ink/15 bg-white px-3.5 py-2.5 text-sm text-ink outline-none focus:border-accent"
            />
          </div>
          <div>
            <label for="email-address" class="text-sm font-medium text-ink">Your email</label>
            <input
              id="email-address"
              name="email"
              type="email"
              required
              class="mt-1.5 w-full rounded-lg border border-ink/15 bg-white px-3.5 py-2.5 text-sm text-ink outline-none focus:border-accent"
            />
          </div>
          <div>
            <label for="email-reason" class="text-sm font-medium text-ink">What's this about?</label>
            <input
              id="email-reason"
              name="reason"
              type="text"
              placeholder="e.g. client work, research, saying hi"
              required
              class="mt-1.5 w-full rounded-lg border border-ink/15 bg-white px-3.5 py-2.5 text-sm text-ink outline-none focus:border-accent"
            />
          </div>
          <div>
            <label for="email-message" class="text-sm font-medium text-ink">Message</label>
            <textarea
              id="email-message"
              name="message"
              rows="4"
              required
              class="mt-1.5 w-full rounded-lg border border-ink/15 bg-white px-3.5 py-2.5 text-sm text-ink outline-none focus:border-accent"
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full rounded-full bg-ink px-6 py-3 font-medium text-paper transition-transform duration-200 hover:-translate-y-0.5"
          >
            Open in email
          </button>
        </form>
      </div>

      <div class="rounded-2xl border border-ink/10 bg-white/60 p-6 sm:p-8" data-reveal style="--reveal-delay:80ms">
        <h2 class="font-display text-xs font-semibold tracking-widest text-accent uppercase">
          WhatsApp
        </h2>
        <p class="mt-3 text-sm text-slate">Fastest option. Type your message, it opens ready to send.</p>
        <div class="mt-5 flex h-[calc(100%-3.5rem)] flex-col">
          <label for="wa-message" class="text-sm font-medium text-ink">Message</label>
          <textarea
            id="wa-message"
            rows="8"
            placeholder="What's up?"
            class="mt-1.5 w-full grow rounded-lg border border-ink/15 bg-white px-3.5 py-2.5 text-sm text-ink outline-none focus:border-accent"
          ></textarea>
          <button
            id="wa-send"
            type="button"
            class="mt-4 w-full rounded-full bg-accent px-6 py-3 font-medium text-ink transition-transform duration-200 hover:-translate-y-0.5"
          >
            Continue to WhatsApp
          </button>
        </div>
      </div>
    </div>

    <div class="mt-8">
      <Booking />
    </div>

    <p class="mt-8 text-sm text-slate-light" data-reveal>
      Prefer to skip the form? Email directly at{' '}
      <a
        href={`mailto:${site.emails[0]}`}
        class="font-medium text-ink underline-offset-4 hover:text-accent hover:underline"
      >
        {site.emails[0]}
      </a>{' '}
      or message{' '}
      <a
        href={site.whatsapp[0].href}
        class="font-medium text-ink underline-offset-4 hover:text-accent hover:underline"
      >
        {site.whatsapp[0].label}
      </a>{' '}
      on WhatsApp.
    </p>
  </section>
</Base>

<script define:vars={{ email: site.emails[0], whatsappHref: site.whatsapp[0].href }}>
  const emailForm = document.getElementById('email-form');
  emailForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = document.getElementById('email-name').value;
    const from = document.getElementById('email-address').value;
    const reason = document.getElementById('email-reason').value;
    const message = document.getElementById('email-message').value;
    const subject = `Portfolio contact: ${reason}`;
    const body = `${message}\n\nâ€” ${name} (${from})`;
    window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });

  const waButton = document.getElementById('wa-send');
  waButton?.addEventListener('click', () => {
    const message = document.getElementById('wa-message').value;
    const url = message.trim()
      ? `${whatsappHref}?text=${encodeURIComponent(message)}`
      : whatsappHref;
    window.open(url, '_blank', 'noopener');
  });
</script>
