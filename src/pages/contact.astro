---
import Base from '../layouts/Base.astro';
import Booking from '../components/Booking.astro';
import { site } from '../lib/site';

const opportunities = [
  {
    title: 'Health-tech Collaboration',
    description: 'Emergency donor coordination, clinic workflow digitization, and low-bandwidth community health tools.',
    badge: 'High Priority',
  },
  {
    title: 'Clinical Research & Informatics',
    description: 'Empirical KAP surveys, AI readiness assessments, DHIS2 pipeline analysis, and biostatistical modeling.',
    badge: 'Academic',
  },
  {
    title: 'Software Development',
    description: 'Offline-first web applications, React Native mobile apps, WhatsApp Cloud API webhooks, and backend APIs.',
    badge: 'Engineering',
  },
  {
    title: 'Speaking & Keynotes',
    description: 'Keynotes on African health technology, PyCon presentations, developer advocacy, and clinical-tech intersections.',
    badge: 'Events',
  },
  {
    title: 'Digital Health Consulting',
    description: 'Architecture review for low-bandwidth environments, data completeness audits, and offline data sync design.',
    badge: 'Advisory',
  },
  {
    title: 'Academic & Graduate Inquiries',
    description: 'Postgraduate research collaborations, joint scientific papers, and institutional health-tech partnerships.',
    badge: 'Research',
  },
];
---

<Base
  title="Contact"
  description="Contact Chifen Sama Nduma (The Nurse Who Codes) for health-tech collaboration, clinical AI research, software engineering, and speaking."
  ogImage="/assets/photos/chifen-portrait.jpg"
>
  <section class="mx-auto max-w-5xl px-5 pt-14 pb-16 sm:px-8 sm:pt-20">
    <div class="max-w-2xl">
      <p class="eyebrow text-accent">Initiate a Conversation</p>
      <h1 class="mt-2 font-display text-4xl font-semibold sm:text-6xl text-ink">
        Contact &amp; Work
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-slate">
        Whether you are a health-tech organisation, research institution, recruiter, conference organiser,
        or fellow builder, I read every message. Pick whichever channel is most direct for you.
      </p>
    </div>

    <!-- What We Can Work On (Opportunities Grid) -->
    <div class="mt-12 rounded-2xl border border-line bg-paper-dim/40 p-6 sm:p-8" data-reveal>
      <h2 class="font-display text-xs font-semibold tracking-widest text-accent uppercase">
        Open Collaboration Areas
      </h2>
      <p class="mt-1 text-sm text-slate">Areas where my clinical intuition and software engineering create the highest impact:</p>
      
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {opportunities.map((item) => (
          <div class="rounded-xl border border-line bg-paper p-4">
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-semibold uppercase tracking-wider text-accent">
                {item.badge}
              </span>
            </div>
            <h3 class="mt-1.5 font-display text-base font-bold text-ink">{item.title}</h3>
            <p class="mt-1 text-xs text-slate leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Communication Form & WhatsApp -->
    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <!-- Email Form -->
      <div class="rounded-2xl border border-ink/10 bg-white/60 dark:bg-zinc-900/60 p-6 sm:p-8" data-reveal>
        <h2 class="font-display text-xs font-semibold tracking-widest text-accent uppercase">
          Send an Email
        </h2>
        <form id="email-form" class="mt-5 space-y-4">
          <div>
            <label for="email-name" class="text-sm font-medium text-ink">Your name</label>
            <input
              id="email-name"
              name="name"
              type="text"
              required
              placeholder="e.g. Dr. Ngozi / Alex"
              class="mt-1.5 w-full rounded-lg border border-ink/15 bg-white dark:bg-zinc-800 px-3.5 py-2.5 text-sm text-ink outline-none focus:border-accent"
            />
          </div>
          <div>
            <label for="email-address" class="text-sm font-medium text-ink">Your email</label>
            <input
              id="email-address"
              name="email"
              type="email"
              required
              placeholder="name@organization.com"
              class="mt-1.5 w-full rounded-lg border border-ink/15 bg-white dark:bg-zinc-800 px-3.5 py-2.5 text-sm text-ink outline-none focus:border-accent"
            />
          </div>
          <div>
            <label for="email-reason" class="text-sm font-medium text-ink">What's this about?</label>
            <select
              id="email-reason"
              name="reason"
              required
              class="mt-1.5 w-full rounded-lg border border-ink/15 bg-white dark:bg-zinc-800 px-3.5 py-2.5 text-sm text-ink outline-none focus:border-accent"
            >
              <option value="Health-tech Collaboration">Health-tech Collaboration</option>
              <option value="Clinical AI Research">Clinical AI / Academic Research</option>
              <option value="Software Development Project">Software Development / Product Build</option>
              <option value="Speaking or Keynote Invitation">Speaking / Keynote Invitation</option>
              <option value="Consulting on Offline-First Architectures">Consulting on Offline-First Architectures</option>
              <option value="General Professional Contact">General Professional Contact</option>
            </select>
          </div>
          <div>
            <label for="email-message" class="text-sm font-medium text-ink">Message</label>
            <textarea
              id="email-message"
              name="message"
              rows="4"
              required
              placeholder="Detail the problem, timeline, or scope..."
              class="mt-1.5 w-full rounded-lg border border-ink/15 bg-white dark:bg-zinc-800 px-3.5 py-2.5 text-sm text-ink outline-none focus:border-accent"
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full rounded-full bg-ink px-6 py-3 font-medium text-paper transition-transform duration-200 hover:-translate-y-0.5 cursor-pointer"
          >
            Open in Email Client &rarr;
          </button>
        </form>
      </div>

      <!-- WhatsApp Direct -->
      <div class="rounded-2xl border border-ink/10 bg-white/60 dark:bg-zinc-900/60 p-6 sm:p-8 flex flex-col" data-reveal style="--reveal-delay:80ms">
        <h2 class="font-display text-xs font-semibold tracking-widest text-accent uppercase">
          WhatsApp Direct
        </h2>
        <p class="mt-3 text-sm text-slate">
          Fastest communication method. Compose your note below, and it launches pre-filled into WhatsApp.
        </p>
        <div class="mt-5 flex h-[calc(100%-3.5rem)] flex-col">
          <label for="wa-message" class="text-sm font-medium text-ink">Quick message</label>
          <textarea
            id="wa-message"
            rows="8"
            placeholder="Hello Chifen, I'd like to talk about..."
            class="mt-1.5 w-full grow rounded-lg border border-ink/15 bg-white dark:bg-zinc-800 px-3.5 py-2.5 text-sm text-ink outline-none focus:border-accent"
          ></textarea>
          <button
            id="wa-send"
            type="button"
            class="mt-4 w-full rounded-full bg-accent px-6 py-3 font-medium text-ink transition-transform duration-200 hover:-translate-y-0.5 cursor-pointer"
          >
            Continue to WhatsApp &rarr;
          </button>
        </div>
      </div>
    </div>

    <!-- Booking Calendar Section -->
    <div class="mt-10">
      <Booking />
    </div>

    <!-- Direct Fallbacks -->
    <div class="mt-10 rounded-xl border border-line bg-paper-dim/30 p-6 text-sm text-slate space-y-2" data-reveal>
      <p class="font-semibold text-ink">Direct coordinates:</p>
      <p>
        Email: <a href={`mailto:${site.emails[0]}`} class="font-medium text-accent hover:underline">{site.emails[0]}</a>
      </p>
      <p>
        WhatsApp: <a href={site.whatsapp[0].href} class="font-medium text-accent hover:underline">{site.whatsapp[0].label}</a>
      </p>
      <p>
        Location: <span class="text-ink font-medium">{site.location}</span>
      </p>
    </div>
  </section>
</Base>

<script define:vars={{ email: site.emails[0], whatsappHref: site.whatsapp[0].href }}>
  const emailForm = document.getElementById('email-form');
  emailForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = document.getElementById('email-name').value;
    const from = document.getElementById('email-address').value;
    const reason = document.getElementById('email-reason').value;
    const message = document.getElementById('email-message').value;
    const subject = `Portfolio contact: ${reason} from ${name}`;
    const body = `${message}\n\n---\nSender: ${name}\nEmail: ${from}\nSubject category: ${reason}`;
    window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });

  const waButton = document.getElementById('wa-send');
  waButton?.addEventListener('click', () => {
    const message = document.getElementById('wa-message').value;
    const url = message.trim()
      ? `${whatsappHref}?text=${encodeURIComponent(message)}`
      : whatsappHref;
    window.open(url, '_blank', 'noopener');
  });
</script>
