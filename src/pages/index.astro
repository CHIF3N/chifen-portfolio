---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import StatusStamp from '../components/StatusStamp.astro';
import Doodle from '../components/Doodle.astro';
import { site } from '../lib/site';
import { withBase } from '../lib/url';
import { storyChapters } from '../data/storyData';
import portrait from '../assets/photos/chifen-portrait.jpg';
import outdoor from '../assets/photos/chifen-outdoor-1.jpg';
import signature from '../assets/photos/chifen-signature.jpg';
import lifedropCover from '../assets/covers/lifedrop.png';
import coastclearCover from '../assets/covers/coastclear.png';
import lockedinCover from '../assets/covers/lockedin.jpg';
import maternalCover from '../assets/covers/maternal-health-risk.png';

const allWork = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const byId = (id: string) => allWork.find((w) => w.id === id)!;

const lifedrop = byId('lifedrop');
const research = byId('ai-clinical-decision-research');
const coastclear = byId('coastclear');
const viac = byId('viac-chatbots');
const lockedin = byId('lockedin');
const maternal = byId('maternal-health-risk');

const study = (await getCollection('research'))[0];

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const dateFormat = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const folders = [
  {
    label: 'Work',
    tab: '01 · serious stuff',
    note: "things I'm building",
    href: '/work',
    tone: '',
    r: -1.5,
    sheet: allWork.slice(0, 4).map((w) => w.data.title),
    count: `${allWork.length} projects`,
  },
  {
    label: 'Research Lab',
    tab: '02 · the science corner',
    note: 'questions with data',
    href: '/research',
    tone: 'folder--lavender',
    r: 1.2,
    sheet: ['AI readiness study', '387 respondents', 'Maternal health risk'],
    count: 'BSc dissertation + analysis',
  },
  {
    label: 'About Me',
    tab: '03 · the human',
    note: 'the human behind the screen',
    href: '/about',
    tone: 'folder--paper',
    r: -0.6,
    sheet: ['nurse', 'self-taught engineer', 'researcher', 'founder'],
    count: 'story, awards, skills',
  },
  {
    label: 'Side Quests',
    tab: '04 · random experiments',
    note: 'open when curious',
    href: '/experiments',
    tone: 'folder--orange',
    r: 1.6,
    sheet: ['an Agrobot', 'an air sanitizer', 'a focus app', 'a plastic tile press'],
    count: 'prototypes & detours',
  },
  {
    label: 'Writing',
    tab: '05 · notes from the build',
    note: 'what broke, what I learned',
    href: '/blog',
    tone: 'folder--cobalt',
    r: -1.1,
    sheet: posts.map((p) => p.data.title),
    count: 'technical posts',
  },
  {
    label: 'Contact',
    tab: '06 · say hi',
    note: 'the door is open',
    href: '/contact',
    tone: 'folder--ink',
    r: 0.8,
    sheet: [site.emails[0], 'WhatsApp', 'LinkedIn'],
    count: 'email, WhatsApp, socials',
  },
];

const deskFiles = [
  { name: 'résumé', ext: 'cv', href: site.resume, note: 'printable' },
  { name: 'journey', ext: 'txt', href: '/journey', note: '14 chapters' },
  { name: 'talks', ext: 'key', href: '/talks', note: 'PyCon 2026' },
  { name: 'archive', ext: '/', href: '/archive', note: 'photos & artefacts' },
];

/* Milestones that appear, with sources, on /about and /journey. */
/* Real moments from the archive, shown as a taped contact sheet. */
const contactSheet = [
  { src: '/archive/yamo-pitch-season-4.jpg', w: 964, h: 1280, alt: 'Chifen on the MTN YaMo Pitch Season 4 stage holding the prize cheque.', note: 'YaMo S4, 3rd', r: -3 },
  { src: '/archive/agrobot-ict-week-demo.jpg', w: 958, h: 1280, alt: 'The Agrobot prototype being demonstrated to officials at Presidential ICT Week.', note: 'the Agrobot', r: 2.5 },
  { src: '/archive/air-sanitizer-prime-hour.jpg', w: 960, h: 540, alt: 'Chifen on the Prime Hour TV set talking about the air sanitiser prototype.', note: 'on TV, 2020', r: -1.5 },
  { src: '/archive/ayodah-team-event.jpg', w: 960, h: 719, alt: 'The Ayodah team in red T-shirts at an outreach event.', note: 'team Ayodah', r: 3 },
];

const milestones = [
  { year: '2020', text: 'Co-founded Ayodah, a blood donor platform.' },
  { year: '2022', text: 'Ayodah won the Silicon Mountain Challenge.' },
  { year: '2022–25', text: 'HND Nursing. Best Overall Student, Best Nursing Student.' },
  { year: '2025–26', text: 'District Data Manager & PMTCT Head, Kumba South.' },
  { year: '2026', text: 'BSc Nursing. Defended a 387-respondent AI study.' },
  { year: '2026', text: 'LifeDrop placed 3rd at MTN YaMo Pitch Season 4.' },
  { year: '2026', text: 'Spoke at PyCon & UbuCon Cameroon.' },
  { year: 'now', text: 'M.Tech Data Science, COLTECH (University of Bamenda).' },
];

/* Side quests pulled from the journey chapters, not invented here. */
const questIds = ['hats-graiye-agrobot', 'air-sanitizer-2020', 'genius-academy-and-africa', 'aircraft-and-drones'];
const quests = questIds
  .map((id) => storyChapters.find((c) => c.id === id))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));
const questTones = ['sticky-note--paper', 'sticky-note--orange', 'sticky-note--lavender', ''];
---

<Base
  description="Chifen Sama Nduma (CHIF3N), The Nurse Who Codes. Registered nurse and self-taught software engineer in Buea, Cameroon, building blood donor networks on WhatsApp, clinical AI research and tools for low-bandwidth health systems."
  accent={site.accents.home}
  profile
>
  <!-- ================================================================
       SCENE 1 · The desk. Who, what's different, where to go next.
       ================================================================ -->
  <section class="hero grid-paper" aria-labelledby="hero-title">
    <div class="shell relative grid gap-10 pt-10 pb-16 sm:pt-14 lg:grid-cols-[1.25fr_0.85fr] lg:gap-6 lg:pb-24">
      <div class="relative z-10">
        <p class="hand hero-hey enter text-[2.4rem] sm:text-[3rem]" style="--d:.05s">
          hey, I'm Chifen
          <svg class="scribble draw hero-hey-arrow" viewBox="0 0 120 60" aria-hidden="true" style="--len:160;--d:1.1s">
            <path d="M6 10 C 40 6, 80 14, 96 40 M 84 36 L 97 42 L 99 28" />
          </svg>
        </p>

        <h1 id="hero-title" class="mt-1">
          <span class="sr-only">Chifen Sama Nduma, also known as CHIF3N. The Nurse Who Codes.</span>
          <Wordmark size="lg" class="hero-wordmark" />
          <span aria-hidden="true" class="enter mt-3 block font-display text-[clamp(1.9rem,5vw,3.4rem)] leading-none font-semibold" style="--d:.55s">
            The Nurse <span class="serif-i font-normal">Who</span> <span class="mark">Codes.</span>
          </span>
        </h1>

        <p class="enter mt-6 max-w-xl text-lg leading-relaxed text-slate sm:text-xl" style="--d:.7s">
          Registered nurse, self-taught software engineer and researcher in {site.location.split(' / ')[0]}, Cameroon.
          Nursing showed me what breaks at two in the morning. Software gave me a way to fix some of it
          instead of charting it and moving on.
        </p>

        <div class="enter mt-8 flex flex-wrap items-center gap-3" style="--d:.85s">
          <a href={withBase('/work')} class="btn btn-ink">See the work <span aria-hidden="true">→</span></a>
          <a href={withBase('/about')} class="btn btn-ghost">Read my story</a>
          <a href={withBase(site.resume)} class="btn btn-accent">Résumé</a>
        </div>
        <p class="enter mt-5 text-sm text-slate" style="--d:1s">
          Or skip the tour: <a class="ink-link font-semibold" href={`mailto:${site.emails[0]}`}>{site.emails[0]}</a>
        </p>
      </div>

      <!-- The pinned portrait and the notes stuck around it. -->
      <div class="hero-board relative" data-desk>
        <figure class="polaroid hero-photo enter-drop" style="--r:3deg;--d:.35s" data-parallax="6">
          <span class="tape" style="top:-0.7rem;left:34%;--tr:-6deg" aria-hidden="true"></span>
          <Image
            src={portrait}
            alt="Chifen Sama Nduma in a black shirt, arms folded, against a dark background."
            widths={[320, 480, 640]}
            sizes="(max-width: 1024px) 70vw, 30vw"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>that's me ↑</figcaption>
        </figure>

        <div class="hero-notes">
          <div class="sticky-note note-a enter-drop" style="--r:-4deg;--d:1.05s" data-drag>
            <p class="eyebrow !text-[#191919]/60">currently</p>
            <p class="hand mt-1 text-[1.45rem]">M.Tech Data Science at COLTECH, University of Bamenda</p>
          </div>
          <div class="sticky-note sticky-note--lavender note-b enter-drop" style="--r:3deg;--d:1.2s" data-drag>
            <p class="eyebrow !text-[#191919]/60">research note</p>
            <p class="hand mt-1 text-[1.45rem]">Asked 387 health workers about AI. Not resistant. Under-trained.</p>
          </div>
          <div class="sticky-note sticky-note--orange note-c enter-drop" style="--r:-2deg;--d:1.35s" data-drag>
            <p class="eyebrow !text-[#191919]/60">LifeDrop</p>
            <p class="hand mt-1 text-[1.45rem]">3rd place, MTN YaMo Pitch Season 4</p>
          </div>
        </div>

        <button type="button" class="tidy-btn hidden" data-tidy>
          <span class="hand text-lg">tidy the desk</span>
        </button>
      </div>
    </div>

    <p class="hand start-here enter" style="--d:1.5s" aria-hidden="true">
      start here
      <svg class="scribble draw" viewBox="0 0 40 70" style="--len:120;--d:1.7s"><path d="M20 4 C 10 24, 30 40, 20 64 M 10 54 L 20 66 L 30 54" /></svg>
    </p>
  </section>

  <!-- ================================================================
       SCENE 2 · The desktop of ideas. Every folder is a real page.
       ================================================================ -->
  <section id="desktop" class="shell pt-16 sm:pt-20" aria-labelledby="desktop-title">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">The desktop</p>
        <h2 id="desktop-title" class="display-section mt-2 flex items-start gap-2">Open a folder. <Doodle name="sparkle" size={34} rotate={10} color="var(--cobalt)" class="mt-1" /></h2>
      </div>
      <p class="hand max-w-xs text-2xl text-slate sm:text-right">everything's labelled, promise. it only looks messy.</p>
    </div>

    <ul class="folders mt-10" role="list">
      {
        folders.map((f, i) => (
          <li data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <a href={withBase(f.href)} class:list={['folder', f.tone]} style={`--r:${f.r}deg`}>
              <span class="folder-tab">{f.tab}</span>
              <span class="folder-back" aria-hidden="true" />
              <span class="folder-sheet" aria-hidden="true">
                {f.sheet.slice(0, 4).map((s) => (
                  <span class="block truncate">· {s}</span>
                ))}
              </span>
              <span class="folder-front">
                <span class="block font-display text-[1.3rem] leading-none font-semibold sm:text-[1.7rem]">{f.label}</span>
                <span class="hand mt-1 block text-[1.15rem] leading-tight opacity-80 sm:text-[1.35rem]">{f.note}</span>
                <span class="mt-3 flex items-center justify-between gap-2 text-xs font-semibold opacity-75 sm:mt-4">
                  <span>{f.count}</span>
                  <span aria-hidden="true" class="folder-arrow hidden sm:inline">open →</span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4" data-reveal>
      <span class="eyebrow">Loose files</span>
      {
        deskFiles.map((file) => (
          <a href={withBase(file.href)} class="desk-file">
            <span class="desk-file-icon" aria-hidden="true">{file.ext}</span>
            <span>
              <span class="block text-sm font-semibold">{file.name}</span>
              <span class="block text-xs text-slate">{file.note}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ================================================================
       SCENE 3 · Selected work. Each project gets the frame it deserves.
       ================================================================ -->
  <section id="work" class="shell pt-24 sm:pt-32" aria-labelledby="work-title">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 id="work-title" class="display-section mt-2">
          Things I built, <span class="serif-i font-normal">and what they taught me.</span>
        </h2>
      </div>
      <a href={withBase('/work')} class="btn btn-ghost btn-sm">All {allWork.length} projects →</a>
    </div>

    <!-- LifeDrop: the product window -->
    <article class="work-row mt-14 grid items-center gap-8 lg:grid-cols-[1.35fr_1fr] lg:gap-12" data-reveal>
      <div class="stack rounded-xl" style="rotate:-1deg"><a href={withBase(`/work/${lifedrop.id}`)} class="window lift block" aria-label={`${lifedrop.data.title} case study`}>
        <span class="window-bar"><span class="window-dots"><i /><i /><i /></span><span class="window-url">lifedropcam.netlify.app</span></span>
        <Image src={lifedropCover} alt="The LifeDrop website: 'Be their hero today' beside a WhatsApp conversation matching a donor." widths={[600, 900, 1200]} sizes="(max-width: 1024px) 92vw, 56vw" loading="lazy" class="block w-full" />
      </a></div>
      <div>
        <div class="flex flex-wrap items-center gap-3"><StatusStamp status={lifedrop.data.status} /><span class="text-sm text-slate">{lifedrop.data.year} · {lifedrop.data.role}</span></div>
        <h3 class="mt-3 font-display text-4xl font-semibold"><a class="hover:text-accent" href={withBase(`/work/${lifedrop.id}`)}>{lifedrop.data.title}</a></h3>
        <p class="mt-3 text-lg leading-relaxed text-slate">{lifedrop.data.summary}</p>
        <ul class="mt-5 space-y-2 text-sm font-semibold">
          {lifedrop.data.metrics.map((m) => <li class="flex gap-2"><span class="text-accent" aria-hidden="true">✓</span>{m}</li>)}
        </ul>
        <p class="hand mt-5 text-2xl text-slate">no install screen this time. <span class="text-base">(see Ayodah)</span></p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href={withBase(`/work/${lifedrop.id}`)} class="btn btn-ink btn-sm">Read the case study</a>
          {lifedrop.data.liveUrl && <a href={lifedrop.data.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm">Visit live site ↗</a>}
        </div>
      </div>
    </article>

    <!-- Research: the field notebook -->
    <article class="work-row mt-24 grid items-start gap-8 lg:grid-cols-[1fr_1.2fr] lg:gap-12" data-reveal>
      <div class="lg:order-2">
        <div class="notebook paper stack lift relative p-6 pl-14 sm:p-8 sm:pl-16" style="--r:1.2deg">
          <span class="tape" style="top:-0.8rem;right:2rem;--tr:5deg" aria-hidden="true"></span>
          <p class="eyebrow">Field notebook · {study.data.site}</p>
          <dl class="mt-5 grid grid-cols-2 gap-x-6 gap-y-5">
            <div><dt class="text-xs font-semibold text-slate">respondents</dt><dd class="font-display text-5xl font-semibold">387</dd></div>
            <div><dt class="text-xs font-semibold text-slate">response rate</dt><dd class="font-display text-5xl font-semibold">92.4<span class="text-2xl">%</span></dd></div>
            <div><dt class="text-xs font-semibold text-slate">questionnaires out</dt><dd class="font-display text-3xl font-semibold">419</dd></div>
            <div><dt class="text-xs font-semibold text-slate">professional cadres</dt><dd class="font-display text-3xl font-semibold">6</dd></div>
          </dl>
          <p class="hand mt-6 text-[1.7rem] leading-tight">
            → not resistant to AI.<br /><span class="mark">under-trained and under-equipped.</span>
          </p>
        </div>
      </div>
      <div class="lg:order-1 lg:pt-6">
        <div class="flex flex-wrap items-center gap-3"><StatusStamp status={research.data.status} /><span class="text-sm text-slate">{research.data.year} · {research.data.role}</span></div>
        <h3 class="mt-3 font-display text-4xl font-semibold"><a class="hover:text-accent" href={withBase(`/work/${research.id}`)}>{research.data.title}</a></h3>
        <p class="mt-3 text-lg leading-relaxed text-slate">{research.data.summary}</p>
        <p class="mt-4 text-sm text-slate">A cross-sectional study for my BSc dissertation. Evidence about readiness, not a clinical product.</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href={withBase(`/research/${study.id}`)} class="btn btn-ink btn-sm">Open the study</a>
          <a href={withBase(`/work/${research.id}`)} class="btn btn-ghost btn-sm">Project write-up</a>
        </div>
      </div>
    </article>

    <!-- A loose spread: CoastClear clipping, LockedIn phone, MORIA index card, maternal figure -->
    <div class="spread mt-24 grid gap-10 md:grid-cols-2 lg:grid-cols-12 lg:gap-8">
      <article class="lg:col-span-7" data-reveal>
        <a href={withBase(`/work/${coastclear.id}`)} class="paper lift block overflow-hidden p-3" style="--r:-1.4deg">
          <span class="pin" style="top:.5rem;left:50%" aria-hidden="true"></span>
          <Image src={coastclearCover} alt="CoastClear welcome screen offering English, Français and Pidgin." widths={[500, 800]} sizes="(max-width: 1024px) 92vw, 50vw" loading="lazy" class="block w-full rounded-[3px]" />
          <span class="block px-2 pt-4 pb-2">
            <span class="flex flex-wrap items-center gap-3"><StatusStamp status={coastclear.data.status} /><span class="text-sm text-slate">{coastclear.data.year} · ocean conservation</span></span>
            <span class="mt-2 block font-display text-3xl font-semibold">{coastclear.data.title}</span>
            <span class="mt-2 block text-slate">{coastclear.data.summary}</span>
          </span>
        </a>
      </article>

      <article class="lg:col-span-5 lg:pt-16" data-reveal style="--reveal-delay:120ms">
        <a href={withBase(`/work/${lockedin.id}`)} class="group flex items-center gap-6">
          <span class="phone lift" style="--r:4deg">
            <Image src={lockedinCover} alt="LockedIn v1's focus timer screen." widths={[240, 360]} sizes="180px" loading="lazy" class="block h-full w-full object-cover" />
          </span>
          <span class="min-w-0">
            <StatusStamp status={lockedin.data.status} />
            <span class="mt-2 block font-display text-3xl font-semibold group-hover:text-accent">{lockedin.data.title}</span>
            <span class="mt-2 block text-slate">{lockedin.data.summary}</span>
            <span class="hand mt-2 block text-xl text-slate">that's v1. v2 is in the oven.</span>
          </span>
        </a>
      </article>

      <article class="lg:col-span-5" data-reveal>
        <a href={withBase(`/work/${viac.id}`)} class="index-card lift block" style="--r:1.5deg">
          <span class="flex items-center justify-between gap-3"><span class="eyebrow">{viac.data.role}</span></span>
          <span class="mt-3 block font-display text-3xl font-semibold">{viac.data.title}</span>
          <span class="mt-2 block text-slate">{viac.data.summary}</span>
          <span class="mt-4 grid grid-cols-2 gap-3">
            {viac.data.metrics.slice(0, 4).map((m) => <span class="rounded border border-dashed border-line px-3 py-2 text-sm font-semibold">{m}</span>)}
          </span>
        </a>
      </article>

      <article class="lg:col-span-7" data-reveal style="--reveal-delay:120ms">
        <a href={withBase(`/work/${maternal.id}`)} class="block">
          <span class="relative block">
            <span class="tape" style="top:-0.6rem;left:1.5rem;--tr:-8deg" aria-hidden="true"></span>
            <span class="tape" style="bottom:-0.6rem;right:1.5rem;--tr:6deg" aria-hidden="true"></span>
            <Image src={maternalCover} alt="Bar chart of maternal health risk levels from the analysis." widths={[500, 800]} sizes="(max-width: 1024px) 92vw, 55vw" loading="lazy" class="paper block w-full p-2" style="--r:-0.8deg" />
          </span>
          <span class="mt-5 block">
            <span class="eyebrow">Fig. 1 · {maternal.data.role}</span>
            <span class="mt-1 block font-display text-3xl font-semibold">{maternal.data.title}</span>
            <span class="mt-2 block text-slate">{maternal.data.summary}</span>
          </span>
        </a>
      </article>
    </div>
  </section>

  <!-- ================================================================
       SCENE 4 · The human behind the work.
       ================================================================ -->
  <section id="human" class="human torn-top torn-bottom mt-28 py-24 sm:py-32" aria-labelledby="human-title">
    <div class="shell grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div class="relative mx-auto w-full max-w-sm lg:mx-0">
        <figure class="polaroid" style="--r:-3deg" data-reveal>
          <span class="tape" style="top:-0.7rem;left:30%" aria-hidden="true"></span>
          <Image src={outdoor} alt="Chifen outdoors in a white polo shirt, cap and headphones, looking off to the side." widths={[360, 520]} sizes="(max-width: 1024px) 80vw, 28vw" loading="lazy" />
          <figcaption>somewhere around Buea</figcaption>
        </figure>
        <figure class="signature paper p-1.5" style="--r:5deg" data-reveal>
          <Image src={signature} alt="Black-and-white portrait of Chifen with the handwritten CHIF3N signature." widths={[200, 300]} sizes="160px" loading="lazy" class="block w-full rounded-[3px]" />
        </figure>
      </div>

      <div>
        <p class="eyebrow">The human behind the screen</p>
        <h2 id="human-title" class="display-section mt-2">I didn't start as a developer. <span class="serif-i font-normal">I started in healthcare.</span></h2>
        <div class="mt-6 max-w-2xl space-y-4 text-lg leading-relaxed text-slate">
          <p>
            I trained as a nurse before I learned to build software, and that order matters. The gap between what a
            health product claims to do and what happens on a ward is invisible to people who have never worked one.
          </p>
          <p>
            Most health software assumes reliable power, fast internet and spare phone storage. I build for what is
            actually there: low data, unreliable power, a phone rather than a laptop.
          </p>
        </div>

        <ul class="contact-sheet mt-10" role="list" aria-label="Moments from the archive">
          {
            contactSheet.map((c, i) => (
              <li data-reveal style={`--reveal-delay:${i * 70}ms`}>
                <a href={withBase('/archive')} class="snap" style={`--r:${c.r}deg`}>
                  <span class="tape" style="top:-0.55rem;left:30%;width:3.5rem;height:1.1rem" aria-hidden="true" />
                  <img src={withBase(c.src)} alt={c.alt} width={c.w} height={c.h} loading="lazy" decoding="async" />
                  <span class="hand snap-note">{c.note}</span>
                </a>
              </li>
            ))
          }
        </ul>

        <ol class="milestones mt-10" aria-label="Milestones">
          {
