<script>
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // The wordmark leans gently toward the pointer. Desktop only, never on text you read.
  const hero = document.querySelector<HTMLElement>('.hero');
  const letters = hero ? Array.from(hero.querySelectorAll<HTMLElement>('.hero-wordmark .wm-l, .hero-wordmark .wm-three')) : [];
  const parallax = hero ? Array.from(hero.querySelectorAll<HTMLElement>('[data-parallax]')) : [];

  if (hero && fine && !calm) {
    let frame = 0;
    hero.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const rect = hero.getBoundingClientRect();
        const nx = (e.clientX - rect.left) / rect.width - 0.5;
        const ny = (e.clientY - rect.top) / rect.height - 0.5;
        letters.forEach((el, i) => {
          const b = el.getBoundingClientRect();
          const dx = e.clientX - (b.left + b.width / 2);
          const dy = e.clientY - (b.top + b.height / 2);
          const pull = Math.max(0, 1 - Math.hypot(dx, dy) / 420);
          el.style.setProperty('--py', `${(-pull * 10).toFixed(1)}px`);
          el.style.setProperty('--pr', `${(pull * (i % 2 ? 4 : -4)).toFixed(1)}deg`);
        });
        parallax.forEach((el) => {
          const depth = Number(el.dataset.parallax ?? 4);
          el.style.translate = `${(nx * depth * 2).toFixed(1)}px ${(ny * depth * 2).toFixed(1)}px`;
        });
      });
    });
    hero.addEventListener('pointerleave', () => {
      letters.forEach((el) => {
        el.style.setProperty('--py', '0px');
        el.style.setProperty('--pr', '0deg');
      });
      parallax.forEach((el) => (el.style.translate = ''));
    });
  }

  // Optional: the sticky notes can be pushed around on desktop. They are never
  // needed to reach anything, and "tidy the desk" puts them back.
  const desk = document.querySelector<HTMLElement>('[data-desk]');
  const tidy = document.querySelector<HTMLButtonElement>('[data-tidy]');
  if (desk && fine && matchMedia('(min-width: 1024px)').matches) {
    document.documentElement.classList.add('has-drag');
    const notes = Array.from(desk.querySelectorAll<HTMLElement>('[data-drag]'));
    notes.forEach((note) => {
      let sx = 0, sy = 0, ox = 0, oy = 0;
      note.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        note.setPointerCapture(e.pointerId);
        note.classList.add('is-dragging');
        const [cx, cy] = (note.style.translate || '0px 0px').split(' ').map((v) => parseFloat(v) || 0);
        ox = cx; oy = cy; sx = e.clientX; sy = e.clientY;
      });
      note.addEventListener('pointermove', (e) => {
        if (!note.classList.contains('is-dragging')) return;
        const x = Math.max(-260, Math.min(260, ox + e.clientX - sx));
        const y = Math.max(-200, Math.min(200, oy + e.clientY - sy));
        note.style.translate = `${x}px ${y}px`;
      });
      const end = () => {
        if (!note.classList.contains('is-dragging')) return;
        note.classList.remove('is-dragging');
        tidy?.classList.remove('hidden');
      };
      note.addEventListener('pointerup', end);
      note.addEventListener('pointercancel', end);
    });
    tidy?.addEventListener('click', () => {
      notes.forEach((n) => {
        n.style.transition = 'translate .5s cubic-bezier(.34,1.36,.64,1)';
        n.style.translate = '';
        setTimeout(() => (n.style.transition = ''), 520);
      });
      tidy.classList.add('hidden');
    });
  }
</script>
