---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import WorkCard from '../components/WorkCard.astro';
import talksData from '../data/talks.json';
import { site } from '../lib/site';
import { withBase } from '../lib/url';
import storyPhoto from '../assets/photos/chifen-outdoor-1.jpg';

// Fetch and curate Work items
const allWork = await getCollection('work');

const prioritySlugs = [
  'lifedrop',
  'coastclear',
  'viac-chatbots',
  'ai-clinical-decision-research',
  'maternal-health-risk',
  'lockedin',
];

const featuredProjects = prioritySlugs
  .map((slug) => allWork.find((w) => w.id === slug || w.id === `${slug}.md` || w.id === `${slug}.mdx`))
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));

// Fetch latest writing
const latestPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

// Selected Talks from data
const featuredTalks = talksData.slice(0, 2);

// Simplified compact experience timeline
const experience = [
  {
    role: 'Lead Architect & Systems Developer',
    org: 'LifeDrop (Emergency Blood Donor Dispatch on WhatsApp)',
    period: '2025 – Present',
    note: 'Matching heuristics, WhatsApp Cloud API webhooks, MTN MoMo integration.',
  },
  {
    role: 'Lead Engineer',
    org: 'CoastClear (Coastal Waste Logistics & Edge AI)',
    period: '2025 – Present',
    note: 'Built for Ocean Hack 2025 (NatGeo & TNC) with trilingual English/French/Pidgin UI.',
  },
  {
    role: 'Co-Founder & CEO',
    org: 'INKWAVE (Digital Systems & Storytelling)',
    period: '2023 – Present',
    note: 'Digital products, web architectures, and client CMS handovers at zero maintenance cost.',
  },
  {
    role: 'District Data Manager & PMTCT Lead',
    org: 'Kumba South District Health Service',
    period: '2025 – 2026',
    note: 'Maintained >95% data completeness across rural clinical health registries in DHIS2.',
  },
  {
    role: 'Co-Founder & CTO',
    org: 'Ayodah Blood Donor Platform',
    period: '2020 – 2023',
    note: 'Mediated 310+ donations across 3 partner hospitals; precursor to LifeDrop.',
  },
];

const services = [
  {
    title: 'Health-Tech Product Development',
    summary: 'Clinical workflows and donor applications engineered for environments with unreliable power, scarce connectivity, and zero margin for error.',
    stack: 'Next.js, Python, PostgreSQL, Offline-First',
  },
  {
    title: 'WhatsApp & Low-Bandwidth Automation',
    summary: 'Automated triage bots, emergency alerts, and messaging pipelines built directly where African patients and families already communicate.',
    stack: 'WhatsApp Cloud API, ManyChat, Webhooks, MoMo',
  },
  {
    title: 'Clinical Data & Analytics',
    summary: 'Healthcare registry management, DHIS2 audit trails, data completeness pipelines, and statistical research for evidence-backed decisions.',
    stack: 'DHIS2, SPSS, Python, KoboToolbox',
  },
  {
    title: 'Digital Systems & Offline-First Apps',
    summary: 'Full-stack web applications, local SQLite synchronization, and self-hosted open-source infrastructure that keeps running through blackouts.',
    stack: 'React Native, SQLite, Docker, Nginx',
  },
];
---

<Base
  title="The Nurse Who Codes"
  description="Chifen Sama Nduma (CHIF3N) — Registered nurse and self-taught developer building practical health technology, WhatsApp automations, and clinical AI across Africa."
  accent={site.accents.home}
>
  <!-- 1. HERO: Understandable in 5 Seconds -->
  <Hero />

  <!-- 2. WORK: The Centerpiece of the Site (4-6 Large Visual Cards) -->
  <section id="featured-work" class="shell pt-16 sm:pt-24 pb-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 sm:mb-14">
      <div>
        <p class="text-xs font-mono uppercase tracking-widest text-accent font-semibold mb-2">
          Selected Systems &amp; Case Studies
        </p>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold uppercase tracking-tight text-ink">
          What I Build.
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate max-w-xl">
          Emergency blood dispatch, bilingual clinical bots, empirical AI baselines, and conservation logistics. Built for real people with zero margin for failure.
        </p>
      </div>

      <a
        href={withBase('/work')}
        class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-ink hover:text-accent transition-colors shrink-0 group"
      >
        <span>View all projects ({allWork.length})</span>
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span>
      </a>
    </div>

    <!-- 2-Column Responsive Large Visual Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
      {
        featuredProjects.map((entry, idx) => (
          <WorkCard entry={entry} index={idx} />
        ))
      }
    </div>

    <div class="mt-12 text-center">
      <a
        href={withBase('/work')}
        class="inline-flex items-center gap-2 rounded-full border border-line bg-paper px-6 py-3 text-sm font-semibold text-ink transition-all hover:border-ink hover:bg-paper-dim"
      >
        <span>Explore All Work &amp; Case Studies</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <!-- 3. THE NUMBERS: Contextual Evidence, Not a Wall of Stats -->
  <section class="border-y border-line bg-paper-dim py-14 sm:py-20 transition-colors">
    <div class="shell">
      <div class="max-w-2xl mb-10 sm:mb-12">
        <p class="text-xs font-mono uppercase tracking-widest text-slate font-semibold mb-2">
          Measurable Impact
        </p>
        <h2 class="font-display text-3xl sm:text-4xl font-bold uppercase tracking-tight text-ink">
          Verified Evidence.
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate">
          Every number represents real patients, healthcare workers, or deployed code &mdash; not hypothetical projections.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
        <!-- Metric 1 -->
        <div class="p-6 rounded-2xl border border-line bg-paper shadow-xs">
          <span class="font-display text-4xl sm:text-5xl font-bold text-ink tabular-nums block">
            5,000<span class="text-accent">+</span>
          </span>
          <p class="mt-2 font-semibold text-sm text-ink">Lives reached &amp; impacted</p>
          <p class="mt-1 text-xs text-slate leading-relaxed">
            Through LifeDrop blood dispatch, district PMTCT registries, and clinical bedside triage across Cameroon.
          </p>
        </div>

        <!-- Metric 2 -->
        <div class="p-6 rounded-2xl border border-line bg-paper shadow-xs">
          <span class="font-display text-4xl sm:text-5xl font-bold text-ink tabular-nums block">
            8,500<span class="text-accent">+</span>
          </span>
          <p class="mt-2 font-semibold text-sm text-ink">Platform reach across built tech</p>
          <p class="mt-1 text-xs text-slate leading-relaxed">
            Registered donors, coastal cleanup crews, remote STEM students, and developers across platforms and automations.
          </p>
        </div>

        <!-- Metric 3 -->
        <div class="p-6 rounded-2xl border border-line bg-paper shadow-xs">
          <span class="font-display text-4xl sm:text-5xl font-bold text-ink tabular-nums block">
            387
          </span>
          <p class="mt-2 font-semibold text-sm text-ink">Hospital clinicians surveyed</p>
          <p class="mt-1 text-xs text-slate leading-relaxed">
            First hospital-wide empirical baseline across 6 professional cadres at Buea Regional Hospital (92.4% response rate).
          </p>
        </div>

        <!-- Metric 4 -->
        <div class="p-6 rounded-2xl border border-line bg-paper shadow-xs">
          <span class="font-display text-4xl sm:text-5xl font-bold text-ink tabular-nums block">
            4
          </span>
          <p class="mt-2 font-semibold text-sm text-ink">African countries reached</p>
          <p class="mt-1 text-xs text-slate leading-relaxed">
            Software deployments, health tech activations, and open-source contributions in Cameroon, Nigeria, Ghana, and Kenya.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. ABOUT / THE STORY: Human, Authentic, Nurse to Developer -->
  <section class="shell py-16 sm:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <!-- Story Photo Card (5 cols) -->
      <div class="lg:col-span-5 order-2 lg:order-1">
        <div class="relative rounded-2xl overflow-hidden border border-line bg-paper-dim p-2.5 shadow-xl group">
          <div class="aspect-[3/4] rounded-xl overflow-hidden bg-ink relative">
            <Image
              src={storyPhoto}
              alt="Chifen Sama Nduma — The Nurse Who Codes working at the intersection of healthcare, automation, and clinical systems"
              widths={[400, 700, 960]}
              sizes="(max-width: 640px) 90vw, (max-width: 1024px) 45vw, 480px)"
              loading="lazy"
              class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-x-0 bottom-0 p-4 bg-gradient-to-t from-black/90 via-black/50 to-transparent text-white">
              <span class="text-[10px] font-mono uppercase tracking-widest text-emerald-400 font-semibold block">
                The Nurse Who Codes
              </span>
              <p class="text-xs font-medium text-white/95 mt-0.5 leading-snug">
                Chifen Sama Nduma &bull; Healthcare &amp; Engineering Integration
              </p>
            </div>
          </div>
          <div class="p-3 text-xs font-mono text-slate flex justify-between items-center">
            <span>Future of Care &bull; Nurse Tech</span>
            <span class="text-ink font-semibold">100% Self-Taught Dev</span>
          </div>
        </div>
      </div>

      <!-- Narrative Text (7 cols) -->
      <div class="lg:col-span-7 order-1 lg:order-2 space-y-6">
        <div>
          <p class="text-xs font-mono uppercase tracking-widest text-accent font-semibold mb-2">
            The Trajectory
          </p>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold uppercase tracking-tight text-ink leading-tight">
            I didn't start as a developer. I started in healthcare.
          </h2>
        </div>

        <div class="space-y-4 text-base sm:text-lg text-slate leading-relaxed">
          <p>
            Then I started seeing problems that medicine alone couldn't solve: families walking door-to-door at two in the morning searching for blood that was already sitting five kilometers away in a stranger's veins.
          </p>
          <p>
            So I taught myself to code. Not for theoretical exercises, but because the hospital ward gave me an immediate, unyielding feedback loop.
          </p>
          <p class="text-ink font-medium">
            Now I build technology from the other side of the table &mdash; with an intimate understanding of what actually happens inside clinical care when connectivity dies, power cuts, and every second counts.
          </p>
        </div>

        <!-- Credential Markers (Clean unboxed metadata) -->
        <div class="pt-4 border-t border-line grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs">
          <div>
            <span class="block text-slate-light uppercase font-mono text-[10px]">Clinical</span>
            <span class="font-semibold text-ink">BSc Nursing Science</span>
          </div>
          <div>
            <span class="block text-slate-light uppercase font-mono text-[10px]">Engineering</span>
            <span class="font-semibold text-ink">Self-Taught Developer</span>
          </div>
          <div>
            <span class="block text-slate-light uppercase font-mono text-[10px]">Postgraduate</span>
            <span class="font-semibold text-ink">M.Tech Data Science (UBa)</span>
          </div>
        </div>

        <div class="pt-2">
          <a
            href={withBase('/about')}
            class="inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-semibold text-paper transition-all hover:bg-ink-700 hover:scale-[1.02]"
          >
            <span>READ MY STORY</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. SERVICES: Practical, Commercial, Concise -->
  <section class="border-t border-line bg-paper-dim py-16 sm:py-24 transition-colors">
    <div class="shell">
      <div class="max-w-2xl mb-10 sm:mb-14">
        <p class="text-xs font-mono uppercase tracking-widest text-slate font-semibold mb-2">
          Technical Capabilities
        </p>
        <h2 class="font-display text-3xl sm:text-4xl font-bold uppercase tracking-tight text-ink">
          How I Can Help.
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate">
          Commercial engineering and advisory services focused on healthcare, offline-first mobile apps, and low-bandwidth communications.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
        {
          services.map((svc) => (
            <div class="p-7 rounded-2xl border border-line bg-paper shadow-xs flex flex-col justify-between">
              <div>
                <h3 class="font-display text-xl sm:text-2xl font-bold text-ink uppercase tracking-tight">
                  {svc.title}
                </h3>
                <p class="mt-3 text-sm text-slate leading-relaxed">
                  {svc.summary}
                </p>
              </div>
              <div class="mt-6 pt-4 border-t border-line/60 flex items-center justify-between text-xs">
                <span class="font-mono text-slate-light">{svc.stack}</span>
                <a href={withBase('/contact')} class="font-semibold text-accent hover:underline">
                  Inquire &rarr;
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. EXPERIENCE: Compact Editorial Timeline -->
  <section class="shell py-16 sm:py-24">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 sm:mb-12">
      <div>
        <p class="text-xs font-mono uppercase tracking-widest text-accent font-semibold mb-2">
          Career &amp; Tenures
        </p>
        <h2 class="font-display text-3xl sm:text-4xl font-bold uppercase tracking-tight text-ink">
          Experience.
        </h2>
        <p class="mt-2 text-sm text-slate">
          Health data management, technical founder roles, and clinical engineering tenures.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href={withBase('/experience')}
          class="text-xs sm:text-sm font-semibold text-ink hover:text-accent transition-colors"
        >
          View full timeline &rarr;
        </a>
        <span class="text-line" aria-hidden="true">&bull;</span>
        <a
          href={withBase('/cv')}
          class="text-xs sm:text-sm font-semibold text-accent hover:underline"
        >
          View CV &rarr;
        </a>
      </div>
    </div>

    <div class="divide-y divide-line border-y border-line">
      {
        experience.map((item) => (
          <div class="py-5 sm:py-6 grid grid-cols-1 md:grid-cols-12 gap-2 sm:gap-4 items-baseline">
            <span class="md:col-span-3 text-xs font-mono uppercase tracking-wider text-slate">
              {item.period}
            </span>
            <div class="md:col-span-5">
              <h3 class="text-base sm:text-lg font-semibold text-ink">
                {item.role}
              </h3>
              <p class="text-xs sm:text-sm text-slate">{item.org}</p>
            </div>
            <p class="md:col-span-4 text-xs sm:text-sm text-slate-light leading-relaxed">
              {item.note}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 7. WRITING & SPEAKING: Selected Articles & Talks -->
  <section class="border-t border-line bg-paper-dim py-16 sm:py-24 transition-colors">
    <div class="shell">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        <!-- Writing Column -->
        <div>
          <div class="flex items-baseline justify-between mb-6 pb-3 border-b border-line">
            <div>
              <p class="text-xs font-mono uppercase tracking-widest text-accent font-semibold">Technical Articles</p>
              <h2 class="font-display text-2xl sm:text-3xl font-bold uppercase tracking-tight text-ink mt-1">
                Latest Writing.
              </h2>
            </div>
            <a href={withBase('/blog')} class="text-xs font-semibold text-ink hover:text-accent transition-colors">
              View all &rarr;
            </a>
          </div>

          <div class="space-y-4">
            {
              latestPosts.map((post) => (
                <article class="p-5 rounded-xl border border-line bg-paper hover:border-ink/20 transition-all">
                  <div class="flex items-center gap-2 text-[11px] font-mono text-slate mb-2">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {dateFormat.format(post.data.pubDate)}
                    </time>
                    <span aria-hidden="true">&middot;</span>
                    <span>{post.data.tags.slice(0, 2).join(' · ')}</span>
                  </div>
                  <h3 class="text-base font-semibold text-ink leading-snug hover:text-accent transition-colors">
                    <a href={withBase(`/blog/${post.id.replace(/\.(md|mdx)$/, '')}`)}>
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="mt-2 text-xs text-slate line-clamp-2 leading-relaxed">
                    {post.data.description}
                  </p>
                </article>
              ))
            }
          </div>
        </div>

        <!-- Speaking Column -->
        <div>
          <div class="flex items-baseline justify-between mb-6 pb-3 border-b border-line">
            <div>
              <p class="text-xs font-mono uppercase tracking-widest text-accent font-semibold">Keynotes &amp; Demos</p>
              <h2 class="font-display text-2xl sm:text-3xl font-bold uppercase tracking-tight text-ink mt-1">
                Selected Talks.
              </h2>
            </div>
            <a href={withBase('/talks')} class="text-xs font-semibold text-ink hover:text-accent transition-colors">
              View all &rarr;
            </a>
          </div>

          <div class="space-y-4">
            {
              featuredTalks.map((talk) => (
                <div class="p-5 rounded-xl border border-line bg-paper hover:border-ink/20 transition-all flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between text-[11px] font-mono text-slate mb-2">
                      <span class="font-semibold text-accent">{talk.event}</span>
                      <span>{talk.date}</span>
                    </div>
                    <h3 class="text-base font-semibold text-ink leading-snug">
                      {talk.title}
                    </h3>
                    <p class="mt-2 text-xs text-slate line-clamp-2 leading-relaxed">
                      {talk.abstract}
                    </p>
                  </div>
                  <div class="mt-4 pt-3 border-t border-line/60 flex items-center justify-between text-xs">
                    <span class="text-slate-light font-mono text-[11px]">{talk.location}</span>
                    <a href={withBase('/talks')} class="font-semibold text-ink hover:text-accent">
                      View slides &rarr;
                    </a>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7.5 MORE CONTENT HUB: Direct In-Page Access to Secondary Archives -->
  <section class="shell py-12 sm:py-16">
    <div class="rounded-2xl border border-line bg-paper-dim/60 p-6 sm:p-10 transition-colors">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="max-w-xl">
          <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-accent font-semibold mb-2">
            <span>Secondary Archives &bull; Deep Dives</span>
          </div>
          <h2 class="font-display text-2xl sm:text-3xl font-bold uppercase tracking-tight text-ink">
            Looking for the Full Story?
          </h2>
          <p class="mt-2 text-sm sm:text-base text-slate leading-relaxed">
            Beyond the homepage trailer, explore the 14-chapter trajectory timeline, hospital clinical AI research, full career tenures, and verified evidence archive.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
          <a
            href={withBase('/journey')}
            class="inline-flex items-center gap-1.5 rounded-full border border-line bg-paper px-4 py-2 text-xs font-semibold text-ink hover:border-accent hover:text-accent transition-all shadow-xs"
          >
            <span>📖 Journey</span>
          </a>
          <a
            href={withBase('/research')}
            class="inline-flex items-center gap-1.5 rounded-full border border-line bg-paper px-4 py-2 text-xs font-semibold text-ink hover:border-accent hover:text-accent transition-all shadow-xs"
          >
            <span>🔬 Research</span>
          </a>
          <a
            href={withBase('/experience')}
            class="inline-flex items-center gap-1.5 rounded-full border border-line bg-paper px-4 py-2 text-xs font-semibold text-ink hover:border-accent hover:text-accent transition-all shadow-xs"
          >
            <span>🏢 Experience</span>
          </a>
          <a
            href={withBase('/services')}
            class="inline-flex items-center gap-1.5 rounded-full border border-line bg-paper px-4 py-2 text-xs font-semibold text-ink hover:border-accent hover:text-accent transition-all shadow-xs"
          >
            <span>⚡ Services</span>
          </a>
          <a
            href={withBase('/archive')}
            class="inline-flex items-center gap-1.5 rounded-full border border-line bg-paper px-4 py-2 text-xs font-semibold text-ink hover:border-accent hover:text-accent transition-all shadow-xs"
          >
            <span>🖼️ Archive</span>
          </a>
          <a
            href={withBase('/more')}
            class="inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-xs font-semibold text-paper hover:bg-ink-700 transition-all hover:scale-[1.02] shadow-sm ml-1"
          >
            <span>View All More Content</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. CONTACT CTA: Memorable, Direct, Authentic -->
  <section class="shell py-20 sm:py-28">
    <div class="rounded-3xl border border-line bg-ink text-paper p-8 sm:p-14 lg:p-16 relative overflow-hidden shadow-2xl">
      <div class="max-w-2xl relative z-10">
        <p class="text-xs font-mono uppercase tracking-widest text-accent font-semibold mb-3">
          Get In Touch
        </p>
        <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold uppercase tracking-tight text-paper leading-[0.92]">
          Got a real problem?<br />
          <span class="text-paper/60">Tell me what you're trying to fix.</span>
        </h2>
        <p class="mt-6 text-base sm:text-lg text-paper/75 leading-relaxed">
          Whether it's a healthcare workflow with too many steps, an offline field challenge, or a WhatsApp system that needs to be built right.
        </p>

        <div class="mt-8 sm:mt-10 flex flex-wrap items-center gap-4">
          <a
            href={withBase('/contact')}
            class="inline-flex items-center gap-2 rounded-full bg-accent px-8 py-4 text-sm font-bold text-ink shadow-lg shadow-accent/20 transition-all hover:bg-accent/90 hover:scale-[1.02] active:scale-[0.98]"
          >
            <span>Let's talk</span>
            <span aria-hidden="true">&rarr;</span>
          </a>

          <a
            href="mailto:chifensama0@gmail.com"
            class="inline-flex items-center gap-2 rounded-full border border-paper/20 bg-paper/5 px-6 py-4 text-sm font-semibold text-paper transition-all hover:bg-paper/10 hover:border-paper/40"
          >
            <span>chifensama0@gmail.com</span>
          </a>
        </div>
      </div>

      <!-- Subtle background graphic watermark / geometric accent -->
      <div class="absolute -right-10 -bottom-10 opacity-10 pointer-events-none select-none hidden lg:block">
        <span class="font-display text-[16rem] font-bold uppercase leading-none text-paper">
          +
        </span>
      </div>
    </div>
  </section>
</Base>
