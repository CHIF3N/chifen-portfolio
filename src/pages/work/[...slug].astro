---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import VerifyText from '../../components/VerifyText.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, role, tags, status, year, liveUrl, repoUrl, metrics, note } = entry.data;

const statusLabel: Record<string, string> = {
  live: 'Live',
  shipped: 'Shipped',
  'in-progress': 'In progress',
  concept: 'Concept',
};
---

<Base title={title} description={summary}>
  <article>
    <header class="border-b border-ink/10 bg-ink text-paper">
      <div class="mx-auto max-w-4xl px-5 pt-12 pb-14 sm:px-8 sm:pt-16 sm:pb-16">
        <a
          href="/work"
          class="group inline-flex items-center gap-1.5 text-sm text-paper/60 transition-colors hover:text-amber"
        >
          <span class="transition-transform duration-200 group-hover:-translate-x-0.5">&larr;</span>
          All work
        </a>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <span class="rounded-full bg-amber/20 px-3 py-1 text-xs font-medium text-amber">
            {statusLabel[status]}
          </span>
          <span class="text-sm text-paper/50">{year}</span>
        </div>

        <h1 class="mt-4 font-display text-4xl font-semibold sm:text-5xl">{title}</h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-paper/70">{summary}</p>
        <p class="mt-5 text-sm text-paper/55">{role}</p>

        {
          (liveUrl || repoUrl) && (
            <div class="mt-7 flex flex-wrap gap-3">
              {liveUrl && (
                <a
                  href={liveUrl}
                  target="_blank"
                  rel="noopener"
                  class="rounded-full bg-amber px-5 py-2.5 text-sm font-medium text-ink transition-transform duration-200 hover:-translate-y-0.5"
                >
                  Visit the live site
                </a>
              )}
              {repoUrl && (
                <a
                  href={repoUrl}
                  target="_blank"
                  rel="noopener"
                  class="rounded-full border border-paper/25 px-5 py-2.5 text-sm font-medium transition-colors hover:border-amber hover:text-amber"
                >
                  View the code
                </a>
              )}
            </div>
          )
        }

        {
          metrics.length > 0 && (
            <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-paper/15 pt-8 sm:grid-cols-4">
              {metrics.map((metric) => (
                <div>
                  <dd class="font-display text-lg leading-snug font-medium">
                    <VerifyText text={metric} />
                  </dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </header>

    {
      note && (
        <div class="mx-auto max-w-4xl px-5 pt-8 sm:px-8">
          <p class="rounded-xl border border-amber/40 bg-amber/10 px-5 py-4 text-sm leading-relaxed text-ink">
            <strong class="font-semibold">Note.</strong> {note}
          </p>
        </div>
      )
    }

    <div class="mx-auto max-w-4xl px-5 py-14 sm:px-8">
      <div class="prose-body">
        <Content />
      </div>

      <div class="mt-14 flex flex-wrap gap-2 border-t border-ink/10 pt-8">
        {
          tags.map((tag) => (
            <span class="rounded-full bg-ink/5 px-3 py-1 text-sm text-slate">{tag}</span>
          ))
        }
      </div>
    </div>
  </article>
</Base>
