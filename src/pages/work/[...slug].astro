---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import VerifyText from '../../components/VerifyText.astro';
import StatusStamp from '../../components/StatusStamp.astro';
import { site } from '../../lib/site';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const entries = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, all: entries, index: i },
  }));
}

const { entry, all, index } = Astro.props;
const { Content, headings } = await render(entry);
const { title, summary, role, tags, status, year, liveUrl, repoUrl, metrics, note, cover, researchSlug } = entry.data;

const toc = headings.filter((h) => h.depth === 2);
const next = all[(index + 1) % all.length];
const prev = all[(index - 1 + all.length) % all.length];

/* Related: the projects sharing the most tags with this one. */
const related = all
  .filter((e) => e.id !== entry.id)
  .map((e) => ({ e, score: e.data.tags.filter((t) => tags.includes(t)).length }))
  .filter((r) => r.score > 0)
  .sort((a, b) => b.score - a.score || a.e.data.order - b.e.data.order)
  .slice(0, 3)
  .map((r) => r.e);

const siteOrigin = (Astro.site?.toString() ?? 'https://chifen.is-a.dev').replace(/\/$/, '');
const isSoftware = Boolean(liveUrl) && !tags.includes('research');
const projectSchema = {
  '@context': 'https://schema.org',
  '@type': isSoftware ? 'SoftwareApplication' : 'CreativeWork',
  name: title,
  description: summary,
  url: `${siteOrigin}/work/${entry.id}`,
  dateCreated: String(year),
  creator: { '@id': `${siteOrigin}/#person` },
  keywords: tags.join(', '),
  ...(isSoftware ? { applicationCategory: tags.includes('health-tech') ? 'HealthApplication' : 'WebApplication', operatingSystem: 'Web', sameAs: liveUrl } : {}),
};
---

<Base title={`${title} · Case study`} description={summary} schema={projectSchema} accent={site.accents.work}>
  <article>
    <header class="shell pt-8 sm:pt-12">
      <nav aria-label="Breadcrumb" class="text-sm font-semibold text-slate">
        <a href={withBase('/work')} class="ink-link">← All work</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>

      <div class="mt-8 grid items-center gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-14">
        <div>
          <div class="flex flex-wrap items-center gap-3">
            <StatusStamp status={status} />
            <span class="text-sm font-semibold text-slate">{year}</span>
            <span class="text-sm text-slate">·</span>
            <span class="text-sm font-semibold text-slate">{role}</span>
          </div>
          <h1 class="display-section mt-4">{title}</h1>
          <p class="mt-5 max-w-xl text-xl leading-relaxed text-slate">{summary}</p>
          {
            (liveUrl || repoUrl || researchSlug) && (
              <div class="mt-7 flex flex-wrap gap-3">
                {liveUrl && <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-accent">Visit the live site ↗</a>}
                {repoUrl && <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">View the code ↗</a>}
                {researchSlug && <a href={withBase(`/research/${researchSlug}`)} class="btn btn-ghost">Read the study</a>}
              </div>
            )
          }
        </div>

        <div class="relative">
          {
            cover ? (
              <div class="window" style="rotate:1deg">
                <div class="window-bar">
                  <span class="window-dots"><i /><i /><i /></span>
                  <span class="window-url">{liveUrl ? liveUrl.replace(/^https?:\/\//, '').replace(/\/$/, '') : `${entry.id}.png`}</span>
                </div>
                <Image src={cover} alt={`${title}: screenshot.`} widths={[480, 800, 1100]} sizes="(max-width: 1024px) 92vw, 45vw" loading="eager" class="block max-h-[28rem] w-full object-cover object-top" />
              </div>
            ) : (
              <div class="paper notebook relative p-8 pl-16" style="--r:1.5deg">
                <span class="tape" style="top:-0.7rem;left:40%" aria-hidden="true" />
                <p class="eyebrow">Project file</p>
                <p class="mt-3 font-display text-4xl leading-none font-semibold">{title}</p>
                <p class="hand mt-4 text-2xl">{tags.join(' · ')}</p>
              </div>
            )
          }
        </div>
      </div>

      {
        metrics.length > 0 && (
          <dl class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {metrics.map((m, i) => (
              <div class="paper p-4" style={`--r:${[-0.8, 0.6, -0.4, 0.7][i % 4]}deg`}>
                <dt class="sr-only">Result</dt>
                <dd class="font-display text-lg leading-snug font-semibold">
                  <VerifyText text={m} />
                </dd>
              </div>
            ))}
          </dl>
        )
      }

      {
        note && (
          <aside class="sticky-note sticky-note--orange mt-10 max-w-2xl" style="--r:-0.8deg" aria-label="Note">
            <p class="text-[0.95rem] leading-relaxed"><strong>Worth knowing:</strong> {note}</p>
          </aside>
        )
      }
    </header>

    <div class="shell mt-16 grid gap-12 lg:grid-cols-[15rem_1fr] lg:gap-16">
      <aside class="lg:sticky lg:top-24 lg:self-start" aria-label="Project details">
        {
          toc.length > 0 && (
            <nav aria-label="In this case study">
              <p class="eyebrow">In this case study</p>
              <ol class="mt-3 space-y-1.5 border-l-[1.5px] border-dashed border-line pl-4 text-sm font-semibold">
                {toc.map((h) => <li><a class="text-slate hover:text-accent" href={`#${h.slug}`}>{h.text}</a></li>)}
              </ol>
            </nav>
          )
        }
        <dl class="mt-8 space-y-3 text-sm">
          <div><dt class="eyebrow">Role</dt><dd class="mt-0.5 font-semibold">{role}</dd></div>
          <div><dt class="eyebrow">Year</dt><dd class="mt-0.5 font-semibold">{year}</dd></div>
          <div><dt class="eyebrow">Tags</dt><dd class="mt-1 flex flex-wrap gap-1.5">{tags.map((t) => <span class="rounded-full border border-line px-2 py-0.5 text-xs font-semibold">{t}</span>)}</dd></div>
        </dl>
      </aside>

      <div class="prose-body max-w-3xl">
        <Content />
      </div>
    </div>

    <footer class="shell mt-20">
      {
        related.length > 0 && (
          <section aria-labelledby="related-title">
            <h2 id="related-title" class="font-display text-2xl font-semibold">Related projects</h2>
            <ul class="mt-5 grid gap-4 sm:grid-cols-3" role="list">
              {related.map((r, i) => (
                <li>
                  <a href={withBase(`/work/${r.id}`)} class="paper lift block h-full p-5" style={`--r:${[-0.6, 0.5, -0.3][i]}deg`}>
                    <StatusStamp status={r.data.status} />
                    <span class="mt-2 block font-display text-xl font-semibold">{r.data.title}</span>
                    <span class="mt-1 block text-sm text-slate">{r.data.summary}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      <nav aria-label="More projects" class="mt-12 flex flex-col gap-3 border-t-[1.5px] border-dashed border-line pt-6 sm:flex-row sm:justify-between">
        <a href={withBase(`/work/${prev.id}`)} class="group"><span class="eyebrow block">← Previous</span><span class="font-display text-xl font-semibold group-hover:text-accent">{prev.data.title}</span></a>
        <a href={withBase(`/work/${next.id}`)} class="group sm:text-right"><span class="eyebrow block">Next →</span><span class="font-display text-xl font-semibold group-hover:text-accent">{next.data.title}</span></a>
      </nav>
    </footer>
  </article>
</Base>
