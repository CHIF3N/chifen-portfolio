---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import Scene3D from '../../components/Scene3D.astro';
import ChipMarquee from '../../components/ChipMarquee.astro';
import { site } from '../../lib/site';

const entries = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

const tags = [...new Set(entries.flatMap((entry) => entry.data.tags))].sort();

function getEntryDomain(entry: (typeof entries)[number]) {
  const id = entry.id;
  const entryTags = entry.data.tags || [];
  if (id === 'ai-clinical-decision-research' || id === 'nurse-intern-assistant' || id === 'abortion-safety-georegistry' || entryTags.includes('research')) {
    return 'clinical';
  }
  if (id === 'lifedrop' || id === 'ayodah' || id === 'maternal-health-risk' || id === 'viac-chatbots' || entryTags.includes('health-tech')) {
    return 'health-tech';
  }
  return 'tech';
}

const chips = [
  'Live in production',
  'Real users',
  'Built in Cameroon',
  'Prototypes labelled as prototypes',
  'Numbers you can check',
];
---

<Base
  title="Work"
  description="Projects by Chifen Sama N. across health technology, WhatsApp automation, AI in clinical decision support, and data."
  accent={site.accents.work}
>
  <section class="shell pt-14 pb-6 sm:pt-20">
    <div class="grid items-center gap-10 lg:grid-cols-[1.3fr_0.7fr]">
      <div>
        <span class="eyebrow text-accent">Project Evidence Framework</span>
        <h1 class="display-section mt-1">Work &amp; Systems</h1>
        <p class="lede mt-4 max-w-2xl text-slate">
          Emergency blood dispatch, bilingual health chatbots, clinical AI risk models, and conservation logistics.
          Every system is catalogued with measurable outcomes, technology stack, and honest retrospective lessons.
        </p>
        <div class="mt-4 flex flex-wrap gap-2 text-xs font-semibold">
          <span class="evidence-pill status-live">Live in production</span>
          <span class="evidence-pill status-shipped">Shipped</span>
          <span class="evidence-pill status-research">Clinical Research</span>
          <span class="evidence-pill status-experiment">Prototype / Concept</span>
        </div>
      </div>
      <Scene3D
        src="/scenes/scene-projects.mp4"
        bubble="Take a look"
        label="Animated 3D illustration"
        class="w-full max-w-xs lg:max-w-none"
      />
    </div>

    <div class="mt-12">
      <ChipMarquee items={chips} />
    </div>

    <!-- Practice Domain Tabs -->
    <div class="mt-10 flex flex-wrap items-center gap-2 border-b border-line pb-4" id="domain-filter-group">
      <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate mr-1">Domain:</span>
      <button
        type="button"
        data-domain-filter="all"
        aria-pressed="true"
        class="domain-filter-chip rounded-full border border-ink px-4 py-1.5 text-xs sm:text-sm font-semibold transition-all bg-ink text-paper"
      >
        All Systems ({entries.length})
      </button>
      <button
        type="button"
        data-domain-filter="clinical"
        aria-pressed="false"
        class="domain-filter-chip rounded-full border border-ink/15 px-4 py-1.5 text-xs sm:text-sm font-semibold transition-all hover:border-emerald-500 text-ink"
      >
        🩺 Clinical Practice &amp; Research ({entries.filter(e => getEntryDomain(e) === 'clinical').length})
      </button>
      <button
        type="button"
        data-domain-filter="health-tech"
        aria-pressed="false"
        class="domain-filter-chip rounded-full border border-ink/15 px-4 py-1.5 text-xs sm:text-sm font-semibold transition-all hover:border-purple-500 text-ink"
      >
        🏥 Health Tech &amp; AI ({entries.filter(e => getEntryDomain(e) === 'health-tech').length})
      </button>
      <button
        type="button"
        data-domain-filter="tech"
        aria-pressed="false"
        class="domain-filter-chip rounded-full border border-ink/15 px-4 py-1.5 text-xs sm:text-sm font-semibold transition-all hover:border-cyan-500 text-ink"
      >
        💻 Software &amp; Platforms ({entries.filter(e => getEntryDomain(e) === 'tech').length})
      </button>
    </div>

    <!-- Detailed Tech Sub-Tags -->
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <span class="text-xs font-mono text-slate-light mr-1">Tags:</span>
      <button
        type="button"
        data-filter="all"
        aria-pressed="true"
        class="filter-chip rounded-full border border-ink/15 px-3 py-1 text-xs font-medium transition-colors"
      >
        All Tags
      </button>
      {
        tags.map((tag) => (
          <button
            type="button"
            data-filter={tag}
            aria-pressed="false"
            class="filter-chip rounded-full border border-ink/15 px-3 py-1 text-xs font-medium transition-colors"
          >
            {tag}
          </button>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-16 sm:px-8">
    <div id="work-grid" class="grid gap-5 sm:grid-cols-2">
      {
        entries.map((entry, i) => (
          <div
            data-domain={getEntryDomain(entry)}
            data-tags={entry.data.tags.join('|')}
            class="contents-item"
          >
            <WorkCard entry={entry} delay={Math.min(i, 5) * 60} />
          </div>
        ))
      }
    </div>

    <p id="work-empty" hidden class="py-16 text-center text-slate">
      Nothing under that selection yet. Try another domain or tag.
    </p>
  </section>
</Base>

<style>
  .domain-filter-chip[aria-pressed='true'] {
    background-color: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
  }
  .filter-chip[aria-pressed='true'] {
    background-color: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
  }
  .filter-chip[aria-pressed='false']:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .contents-item {
    display: contents;
  }
  .contents-item[hidden] {
    display: none;
  }
</style>

<script>
  const domainChips = document.querySelectorAll<HTMLButtonElement>('.domain-filter-chip');
  const tagChips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const items = document.querySelectorAll<HTMLElement>('#work-grid .contents-item');
  const empty = document.getElementById('work-empty');

  let activeDomain = 'all';
  let activeTag = 'all';

  function applyFilters() {
    let visible = 0;
    items.forEach((item) => {
      const itemDomain = item.dataset.domain ?? '';
      const tags = (item.dataset.tags ?? '').split('|');

      const matchesDomain = activeDomain === 'all' || itemDomain === activeDomain;
      const matchesTag = activeTag === 'all' || tags.includes(activeTag);

      const show = matchesDomain && matchesTag;
      item.hidden = !show;
      if (show) visible += 1;
    });

    if (empty) empty.hidden = visible > 0;
  }

  domainChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      activeDomain = chip.dataset.domainFilter ?? 'all';
      domainChips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      applyFilters();
    });
  });

  tagChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      activeTag = chip.dataset.filter ?? 'all';
      tagChips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      applyFilters();
    });
  });
</script>
