---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import StatusStamp from '../../components/StatusStamp.astro';
import { site } from '../../lib/site';
import { withBase } from '../../lib/url';

const entries = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

/* Filters come from the real tags, merged into a handful of readable groups. */
const groups = [
  { id: 'health-tech', label: 'Health tech', match: ['health-tech'] },
  { id: 'whatsapp-ai', label: 'WhatsApp & AI', match: ['WhatsApp', 'AI'] },
  { id: 'research-data', label: 'Research & data', match: ['research', 'data'] },
  { id: 'web-mobile', label: 'Web & mobile', match: ['web', 'mobile', 'product'] },
  { id: 'environment', label: 'Environment', match: ['climate'] },
  { id: 'community-business', label: 'Community & business', match: ['community', 'client work', 'freelance', 'e-commerce', 'content'] },
].filter((g) => entries.some((e) => e.data.tags.some((t) => g.match.includes(t))));

const groupsFor = (tags: string[]) => groups.filter((g) => tags.some((t) => g.match.includes(t))).map((g) => g.id);
---

<Base
  title="Work"
  description="Every project by Chifen Sama Nduma (CHIF3N): blood donor networks on WhatsApp, health chatbots, clinical AI research, conservation logistics and apps, each labelled live, shipped, building or concept."
  accent={site.accents.work}
>
  <section class="shell pt-12 sm:pt-16">
    <p class="eyebrow">Folder 01 · serious stuff</p>
    <div class="mt-2 flex flex-wrap items-end justify-between gap-6">
      <h1 class="display-section">The work.</h1>
      <p class="hand max-w-sm text-2xl text-slate sm:text-right">
        some live, some prototypes. the label always says which.
      </p>
    </div>
    <p class="lede mt-5 max-w-2xl">
      Blood logistics, health chatbots, clinical research, conservation tools and a few things built because the
      problem annoyed me. {entries.length} projects, each with its own case study.
    </p>

    <div class="mt-9 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter projects">
        <button type="button" class="filter-chip" data-filter="all" aria-pressed="true">Everything</button>
        {groups.map((g) => <button type="button" class="filter-chip" data-filter={g.id} aria-pressed="false">{g.label}</button>)}
      </div>
      <div class="relative w-full lg:w-72">
        <label for="work-search" class="sr-only">Search projects</label>
        <input
          id="work-search"
          type="search"
          placeholder="Search projects…"
          autocomplete="off"
          class="w-full rounded-full border-[1.5px] border-ink bg-sheet px-4 py-2.5 text-sm outline-none"
        />
      </div>
    </div>
    <p id="work-count" class="mt-4 text-sm text-slate" role="status" aria-live="polite">Showing all {entries.length} projects.</p>
  </section>

  <section class="shell pt-8" aria-label="Projects">
    <ul id="work-grid" class="grid gap-x-7 gap-y-10 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {
        entries.map((entry, i) => (
          <li
            data-groups={groupsFor(entry.data.tags).join(' ')}
            data-text={`${entry.data.title} ${entry.data.summary} ${entry.data.role} ${entry.data.tags.join(' ')}`.toLowerCase()}
          >
            <WorkCard entry={entry} index={i} />
          </li>
        ))
      }
    </ul>
    <p id="work-empty" hidden class="hand py-16 text-center text-3xl text-slate">
      nothing in this drawer. try another filter?
    </p>
  </section>

  <!-- The plain index: every project in one scannable table. -->
  <section class="shell pt-24" aria-labelledby="index-title">
    <h2 id="index-title" class="font-display text-3xl font-semibold">The plain index</h2>
    <p class="mt-2 text-slate">Same projects, no decoration.</p>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full min-w-[40rem] border-collapse text-left text-sm">
        <thead>
          <tr class="border-b-[1.5px] border-ink">
            <th scope="col" class="py-2 pr-4 font-semibold">Project</th>
            <th scope="col" class="py-2 pr-4 font-semibold">Role</th>
            <th scope="col" class="py-2 pr-4 font-semibold">Year</th>
            <th scope="col" class="py-2 font-semibold">Status</th>
          </tr>
        </thead>
        <tbody>
          {
            entries.map((e) => (
              <tr class="border-b border-dashed border-line">
                <td class="py-3 pr-4"><a class="ink-link font-semibold" href={withBase(`/work/${e.id}`)}>{e.data.title}</a></td>
                <td class="py-3 pr-4 text-slate">{e.data.role}</td>
                <td class="py-3 pr-4 text-slate">{e.data.year}</td>
                <td class="py-3"><StatusStamp status={e.data.status} /></td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLLIElement>('#work-grid > li');
  const search = document.getElementById('work-search') as HTMLInputElement | null;
  const empty = document.getElementById('work-empty');
  const count = document.getElementById('work-count');
  let filter = 'all';

  const apply = () => {
    const words = (search?.value ?? '').toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    items.forEach((item) => {
      const inGroup = filter === 'all' || (item.dataset.groups ?? '').split(' ').includes(filter);
      const matches = words.every((w) => (item.dataset.text ?? '').includes(w));
      item.hidden = !(inGroup && matches);
      if (!item.hidden) shown += 1;
    });
    if (empty) empty.hidden = shown > 0;
    if (count) count.textContent = shown === items.length ? `Showing all ${shown} projects.` : `Showing ${shown} of ${items.length} projects.`;
  };

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      filter = chip.dataset.filter ?? 'all';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      apply();
    })
  );
  search?.addEventListener('input', apply);
</script>
