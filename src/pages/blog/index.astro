---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/url';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Base
  title="Writing"
  description="Notes on health technology, WhatsApp health services, AI in clinical care, and building in Cameroon."
>
  <section class="mx-auto max-w-4xl px-5 pt-14 pb-10 sm:px-8 sm:pt-20">
    <h1 class="font-display text-4xl font-semibold sm:text-5xl">Writing</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate">
      What I learned building the thing, written down while it is still fresh enough to be honest
      about.
    </p>
  </section>

  <section class="mx-auto max-w-4xl px-5 pb-16 sm:px-8">
    <ul class="divide-y divide-ink/10 border-y border-ink/10">
      {
        posts.map((post, i) => (
          <li data-reveal style={`--reveal-delay:${i * 60}ms`}>
            <a href={withBase(`/blog/${post.id}`)} class="group block py-8 transition-colors">
              <p class="text-xs tracking-wider text-slate-light uppercase">
                {dateFormat.format(post.data.pubDate)}
              </p>
              <h2 class="mt-2.5 font-display text-2xl font-semibold transition-colors group-hover:text-accent sm:text-3xl">
                {post.data.title}
              </h2>
              <p class="mt-2.5 leading-relaxed text-slate">{post.data.description}</p>
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {post.data.tags.map((tag) => (
                  <li class="rounded-full bg-ink/5 px-2.5 py-1 text-xs text-slate">{tag}</li>
                ))}
              </ul>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-4xl px-5 pb-16 sm:px-8">
    <h2 class="font-display text-3xl font-semibold sm:text-4xl" data-reveal>Published elsewhere</h2>
    <p class="mt-3 max-w-2xl text-slate" data-reveal>
      Writing for clients, through Inkwave. Some under my own name, some ghostwritten and credited
      here by agreement rather than by public byline.
    </p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      <li class="rounded-xl border border-ink/10 bg-white/60 p-5" data-reveal>
        <p class="font-display text-xs font-semibold tracking-widest text-accent uppercase">
          Tech Chantier
        </p>
        <a
          href="https://techchantier.com/blog"
          target="_blank"
          rel="noopener"
          class="mt-2 block font-display font-medium underline-offset-4 hover:text-accent hover:underline"
        >
          Blog, under my own byline &rarr;
        </a>
      </li>
      <li class="rounded-xl border border-ink/10 bg-white/60 p-5" data-reveal style="--reveal-delay:60ms">
        <p class="font-display text-xs font-semibold tracking-widest text-accent uppercase">
          DELC Foundation
        </p>
        <a
          href="https://delcfoundation.org/blog/"
          target="_blank"
          rel="noopener"
          class="mt-2 block font-display font-medium underline-offset-4 hover:text-accent hover:underline"
        >
          Blog, ghostwritten &rarr;
        </a>
      </li>
    </ul>
  </section>
</Base>
