# ─── Firebase Client SDK (Blog Engagement: likes + comments) ───────────────────
# In Astro, PUBLIC_ prefix exposes these to client-side code via import.meta.env.
# Add these to your Vercel project → Settings → Environment Variables for production.

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# ─── Gemini API (Admin AI CV Studio — Next.js /studio app) ────────────────────
# KEEP THIS SERVER-SIDE ONLY. Never prefix with PUBLIC_.
# Used by /studio/app/api/admin/cv-tailor/route.ts
GEMINI_API_KEY=

# ─── Admin AI Studio Auth ──────────────────────────────────────────────────────
# Only Chifen's Google account UID is allowed into the Admin CV Studio.
# Find this in Firebase Console → Authentication → Users after first sign-in.
NEXT_PUBLIC_ADMIN_FIREBASE_UID=
