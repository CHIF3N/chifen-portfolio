# ─── Admin Studio — Required ───────────────────────────────────────────────────
# A strong passphrase. Keep it secret. Change it to invalidate all sessions.
ADMIN_PASSWORD=

# ─── Gemini API (server-side only — NEVER add NEXT_PUBLIC_ prefix) ─────────────
GEMINI_API_KEY=

# ─── That's it. No Firebase. No OAuth. No database. ───────────────────────────
