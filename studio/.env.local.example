# ─── Firebase (NEXT_PUBLIC_ = exposed to browser) ─────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Admin UID ─────────────────────────────────────────────────────────────────
# Copy from Firebase Console → Authentication → Users after first sign-in
NEXT_PUBLIC_ADMIN_FIREBASE_UID=

# ─── Gemini API (SERVER-SIDE ONLY — do NOT add NEXT_PUBLIC_ prefix) ────────────
GEMINI_API_KEY=
